#!/usr/bin/env bash
#
# claude-airlock — run Claude Code inside the airlock container for $PWD.
#
# Write scope  : current directory (mounted at its REAL host path) -> read-write
# Read scope   : none by default. A project may request extra folders via .airlock/
#                config — `share = <relpath>` (read-only) or `share_rw = <relpath>`
#                (read-write), relative to AIRLOCK_SHARE_BASE, each approved once on
#                the host and mounted at its real path. AIRLOCK_ROOTS (host-set) can
#                still broad-mount trees read-only at /roots/<name>.
# Auth         : shared long-lived OAuth token via CLAUDE_CODE_OAUTH_TOKEN, or —
#                with AIRLOCK_PERSIST_LOGIN=1 — no injected token at all, the box
#                doing its own /login which persists in the per-project state dir
# History      : this project's sessions + memory are LIVE-SHARED with host
#                Claude, so `--resume` and saved memories continue in and out of
#                the box. Everything else (config, settings/hooks, credentials,
#                other projects) stays isolated.
# Egress       : default-DROP allowlist enforced inside the container, or (`airlock
#                egress proxy`) no network at all and one host proxy socket
#
# Optional config (bash syntax): ~/.config/claude-airlock/config
set -euo pipefail

AIRLOCK_IMAGE="${AIRLOCK_IMAGE:-claude-airlock:dev}"
AIRLOCK_ROOTS="${AIRLOCK_ROOTS:-}"                   # broad RO mounts at /roots/<name> (host-trusted; default none)
AIRLOCK_SHARE_BASE="${AIRLOCK_SHARE_BASE:-$HOME/development}"  # base for relative, host-approved per-project `share =` folders
AIRLOCK_SHARE_HISTORY="${AIRLOCK_SHARE_HISTORY:-1}"   # 1 = share sessions+memory in/out
AIRLOCK_PERSIST_LOGIN="${AIRLOCK_PERSIST_LOGIN:-0}"   # 1 = no token injection; box does its own /login, persisted (see auth section)
AIRLOCK_PERMISSION_MODE="${AIRLOCK_PERMISSION_MODE:-}" # per-invocation override (beats stored `airlock mode`; CLI --permission-mode beats it). Broker's one-shot auto-dispatch flag.
# Claude's own --permission-mode choices, mirrored so we reject a typo on the HOST rather
# than launching a box that dies on an invalid flag. Keep in sync with `claude --help`.
AIRLOCK_PERMISSION_MODES="acceptEdits auto bypassPermissions manual dontAsk plan"
AIRLOCK_MODEL="${AIRLOCK_MODEL:-opus}"                # default model in the box ("" = Claude's default)
AIRLOCK_ARTIFACT_DIRS="${AIRLOCK_ARTIFACT_DIRS:-.venv node_modules}"  # env-built dirs kept container-local
AIRLOCK_PIDS_LIMIT="${AIRLOCK_PIDS_LIMIT:-4096}"     # cap in-box process count (fork-bomb guard); 0/"" = engine default
AIRLOCK_MEMORY="${AIRLOCK_MEMORY:-}"                 # host RAM cap, e.g. 8g; empty = no limit (too low breaks real builds)
AIRLOCK_TZ="${AIRLOCK_TZ:-}"                         # the box's timezone, e.g. America/Vancouver; empty = $TZ, else the host's zone
AIRLOCK_PROTECTED_PATHS="${AIRLOCK_PROTECTED_PATHS:-}" # extra host paths no share or mount may contain (space-separated)
AIRLOCK_GIT_RO="${AIRLOCK_GIT_RO:-1}"                # 1 = bind the git config and hooks of read-write repos read-only (0 = off)
AIRLOCK_SECRET_DENY="${AIRLOCK_SECRET_DENY:-}"       # pass entry globs `airlock secret` must never inject (space-separated)

# Container engine. Rootless podman is the DEFAULT and the recommended posture:
# belonging to the `docker` group is root-equivalent on the host (`docker run -v /:/host`
# owns the machine), so under Docker the tool that exists to contain a misbehaving agent
# is itself backed by a root-equivalent socket. Rootless podman has no daemon and no
# privileged socket — the box cannot exceed this unprivileged user's authority.
# Docker remains supported (AIRLOCK_ENGINE=docker) for hosts that have nothing else.
AIRLOCK_ENGINE="${AIRLOCK_ENGINE:-podman}"
# Rootless podman's network stack. 'pasta' is podman's current default and the better
# maintained option; 'slirp4netns' is the older alternative. Either way the egress
# firewall inside the box is what actually enforces containment — see the note in the
# engine-args section below about why we must NOT trust the container's default route.
AIRLOCK_PODMAN_NETWORK="${AIRLOCK_PODMAN_NETWORK:-pasta}"
# Resolver(s) for the box, space-separated, passed as --dns on either engine. Empty = the
# network stack's forwarder to the host resolver (pasta 169.254.1.1, 169.254.0.1 on
# podman 5.0.1-5.2, none before; slirp4netns 10.0.2.3) under podman, the engine's own
# list under docker. Set it when neither works,
# e.g. docker on a host whose only resolver is loopback (see lib/host-dns.sh).
AIRLOCK_DNS="${AIRLOCK_DNS:-}"
# The host proxy socket for the 'proxy' egress posture (`airlock egress proxy`), used when
# a project names none, and by AIRLOCK_EGRESS_MODE=proxy as the default for every project.
AIRLOCK_EGRESS_PROXY="${AIRLOCK_EGRESS_PROXY:-}"

# Snapshot before sourcing the config: `${VAR:-default}` afterwards cannot tell an
# environment value from one the config just set, which is how "env-only" silently
# became a config knob.
_AIRLOCK_TMP_BASE_ENV="${AIRLOCK_TMP_BASE:-}"
# The default scratch base is per user: one shared /tmp/airlock belonged to whoever
# launched first, and another account on the host (an agent's own user, say) could not
# make its project dirs in it.
_AIRLOCK_TMP_DEFAULT="/tmp/airlock-$(id -un 2>/dev/null || id -u)"
# Make the default scratch base, or refuse one that is not ours alone: in a shared /tmp
# anyone can make /tmp/airlock-<you> first, and whoever owns it (or can write to it) can
# read, swap or plant what every one of your boxes mounts. The rule (the zsh wrapper's too):
# not a symlink, owned by you, no group or other bits (an ACL shows in the group bits). A
# base set in the environment to anything else is the user's own choice and is not checked.
# The default base is never removed once made (it costs nothing, and removing it would give
# anyone a new chance to make it first).
_airlock_tmp_base_ready() {
  local b="$1" m
  [ "$b" = "$_AIRLOCK_TMP_DEFAULT" ] || return 0
  mkdir -m 0700 "$b" 2>/dev/null || true
  m="$(stat -c %a "$b" 2>/dev/null)" || m=777
  if [ -L "$b" ] || [ ! -d "$b" ] || [ "$(stat -c %u "$b")" != "$(id -u)" ] \
     || ! [[ "$m" =~ ^[0-7]{3,4}$ ]] || (( 8#$m & 8#077 )); then
    echo "claude-airlock: $b is not yours alone (a symlink, another owner, or open to others)." >&2
    echo "  Someone else may have made it to read or swap your scratch. Only its owner or root" >&2
    echo "  can remove it from /tmp: ask root to, or set AIRLOCK_TMP_BASE in your environment" >&2
    echo "  to a directory of your own." >&2
    return 1
  fi
}
# The doctor sources the config itself, on top of these; handing it the post-config
# values would apply the config twice (an appending AIRLOCK_DNS doubles).
_AIRLOCK_PODMAN_NETWORK_ENV="$AIRLOCK_PODMAN_NETWORK"
_AIRLOCK_DNS_ENV="$AIRLOCK_DNS"
# Extra host mounts may come from the config and from the launching process (a host-side script
# running a box for one task); both apply. Never from .airlock/config, which the box can write.
_AIRLOCK_EXTRA_MOUNTS_ENV="${AIRLOCK_EXTRA_MOUNTS:-}"
unset AIRLOCK_EXTRA_MOUNTS

CONFIG_FILE="${AIRLOCK_CONFIG:-$HOME/.config/claude-airlock/config}"
# shellcheck disable=SC1090
[ -f "$CONFIG_FILE" ] && source "$CONFIG_FILE"
AIRLOCK_EXTRA_MOUNTS="${AIRLOCK_EXTRA_MOUNTS:-} $_AIRLOCK_EXTRA_MOUNTS_ENV"

# The refcount primitives and the `session` subcommand live HERE, above the engine and
# AIRLOCK_TMP_BASE checks, because the host `claude` wrapper calls them on every start
# and stop. Below those checks, a host with no container engine - a perfectly normal way
# to use the wrapper - made every session print a warning about a risk that cannot exist
# without a box, and a config-set AIRLOCK_TMP_BASE made both calls hard-fail. They read
# only $PWD and the ENV snapshot of the scratch base, so they cannot be moved by config.
# --- Shared-mount refcount primitives -------------------------------------------------
# Defined up here, above the subcommand dispatch, because the host `claude` wrapper
# delegates to them through the `session` subcommand: a raw host session holds exactly
# the same $AIRLOCK_TMP as a box, so it has to be counted by the same code. Two
# implementations of this would drift, and the direction they drift is data loss.

# The kernel's start-time token for a pid (field 22 of /proc/<pid>/stat), or empty when
# the pid is gone or /proc is unavailable. comm can contain spaces and parens, so cut
# everything through the FINAL ") " first (greedy is required: a lazy match breaks on
# such a comm, and every field after comm is numeric so it cannot over-strip); starttime
# is then the 20th remaining field.
# Pairing this with a pid is what makes a session file identify a PROCESS rather than a
# number. Without it a recycled pid reads as live forever, and these files live in
# persistent state rather than tmpfs, so that would survive reboots.
_airlock_proc_start() {
  local st
  st="$(cat "/proc/$1/stat" 2>/dev/null)" || return 0
  st="${st##*') '}"
  printf '%s' "$st" | cut -d' ' -f20
}

# True when a session other than $2 is live in the registry $1. Entries whose process is
# gone are pruned as we go, so a SIGKILLed session (trap never ran) cannot pin the shared
# directories forever.
_airlock_peers_in() {
  local dir="$1" self="$2" f pid want have rc=1
  for f in "$dir"/*; do
    [ -e "$f" ] || continue                        # nullglob is off; skip the literal glob
    pid="${f##*/}"
    [ "$pid" = "$self" ] && continue
    case "$pid" in ''|*[!0-9]*) continue ;; esac    # ignore anything not a pidfile
    want=""; read -r want _ < "$f" 2>/dev/null || true
    have="$(_airlock_proc_start "$pid")"
    # Liveness via /proc, not kill -0: kill -0 also fails with EPERM, which would read
    # as "dead" and prune a live peer's entry. An empty stored token means a file from
    # an older version - fall back to bare existence rather than discarding it.
    if [ -n "$have" ] && { [ -z "$want" ] || [ "$want" = "$have" ]; }; then
      rc=0
    else
      rm -f "$f"
    fi
  done
  return $rc
}

# Identity of a directory, so a recorded path cannot become a standing licence to delete
# whatever later occupies it. Inode catches delete-and-recreate; ctime catches a dir that
# was populated and then emptied. Empty when the path is gone.
_airlock_dir_id() { stat -c '%i:%Z' "$1" 2>/dev/null || true; }

# Remove the artifact mountpoints THIS PROJECT created, given its state dir. Shared by
# the launcher's cleanup and by `session release`, because either can be the last one
# out: a host session that outlives every box must still tidy up what those boxes made,
# and when it did not, an empty .venv was left behind forever - its existence then stops
# any future session from re-registering it.
# Callers must have established that no peers remain before calling this.
_airlock_release_artifacts() {
  local dir="$1" m p want
  for m in "$dir"/artifacts-created/*; do
    [ -e "$m" ] || continue
    # One redirection, two lines: path then identity. Separate `read < "$m"` calls would
    # each reopen the file and both return line 1.
    p=""; want=""
    { IFS= read -r p; IFS= read -r want; } < "$m" 2>/dev/null || true
    if [ -z "${p:-}" ] || [ ! -e "$p" ]; then rm -f "$m"; continue; fi
    # The directory must still be the one we created. Without this the marker authorises
    # deleting that path forever: a user who empties .venv to rebuild it would have the
    # directory removed under them by whichever session happens to be last out.
    if [ -n "${want:-}" ] && [ "$want" != "$(_airlock_dir_id "$p")" ]; then continue; fi
    # rmdir, NOT rm -rf, and the peer check does not make that safe on its own. The two
    # guard different writers: the peer check covers a sibling box (whose writes land in
    # $store, so the host view of this path is empty), while rmdir's refusal covers the
    # HOST populating it during the session - the user's other terminal running
    # `python -m venv .venv`, an LSP, direnv, uv, a host-side build. Both are required.
    if rmdir "$p" 2>/dev/null; then rm -f "$m"; fi
  done
  rmdir "$dir/artifacts-created" 2>/dev/null || true
}

# True when a live session other than $2 in registry $1 WRITES SHELL HISTORY - i.e. any
# kind except `shell`. Deliberately a different population from _airlock_peers_in: that one
# answers "who holds the mounts" (an `airlock shell` does), this one answers "who can
# corrupt --resume history" (an `airlock shell` cannot, it runs bash). Conflating the two
# makes a shell session warn about history it never touches. Prunes nothing - the caller
# runs _airlock_peers_in first, which does.
_airlock_history_peers() {
  local dir="$1" self="$2" f pid kind rc=1
  for f in "$dir"/*; do
    [ -e "$f" ] || continue
    pid="${f##*/}"
    [ "$pid" = "$self" ] && continue
    case "$pid" in ''|*[!0-9]*) continue ;; esac
    kind=""; read -r _ kind < "$f" 2>/dev/null || true
    [ "${kind:-}" = shell ] && continue
    rc=0
  done
  return $rc
}

# `airlock session register|release <pid>` — the host `claude` wrapper's hook into the
# refcount. A raw host session mounts nothing, but it USES $AIRLOCK_TMP under the same
# name, so without this it is invisible to every box's cleanup and its scratch dir gets
# removed out from under it. register/release are deliberately dumb: no config parsing,
# no engine, no token.
if [ "${1:-}" = "session" ]; then
  _xslug="$(printf '%s' "$PWD" | sed 's#[^a-zA-Z0-9]#-#g; s#^-*##')"
  _xdir="$HOME/.config/claude-airlock/state/$_xslug/sessions"
  _xtmp="${_AIRLOCK_TMP_BASE_ENV:-$_AIRLOCK_TMP_DEFAULT}/$_xslug"
  _xpid="${3:-}"
  case "${2:-}" in
    register)
      [ -n "$_xpid" ] || { echo "usage: airlock session register <pid>" >&2; exit 1; }
      mkdir -p "$_xdir"
      # "<starttime> <kind>". The kind is what lets the concurrent-session warning tell a
      # history writer from an `airlock shell`, which holds the mounts but not history.
      printf '%s %s\n' "$(_airlock_proc_start "$_xpid")" "${4:-host}" > "$_xdir/$_xpid" ;;
    release)
      [ -n "$_xpid" ] || { echo "usage: airlock session release <pid>" >&2; exit 1; }
      rm -f "$_xdir/$_xpid"
      # Same last-one-out rule the launcher follows: only tidy when nobody else holds it.
      if ! _airlock_peers_in "$_xdir" "$_xpid"; then
        # A host session can outlive every box, and then IT is the last one out - so it
        # owes the same artifact cleanup the launcher does. Skipping this left an empty
        # .venv behind permanently (measured against real containers).
        _airlock_release_artifacts "$HOME/.config/claude-airlock/state/$_xslug"
        rmdir "$_xtmp" 2>/dev/null || true
        rmdir "$_xdir" 2>/dev/null || true
      fi ;;
    peers)   # diagnostic: does anyone else hold this project's shared dirs?
      if _airlock_peers_in "$_xdir" "${_xpid:-0}"; then echo "peers: yes"; else echo "peers: none"; fi ;;
    *) echo "usage: airlock session <register|release|peers> <pid>" >&2; exit 1 ;;
  esac
  exit 0
fi


# Base directory for per-project scratch ($AIRLOCK_TMP). Env-only, and now ENFORCED
# rather than merely documented: the zsh `claude` wrapper computes the same path and
# reads only the environment, so a value set in the config would move the launcher's
# scratch dir while leaving host Claude's where it was - silently splitting the two
# sides that every other part of this design assumes agree. Exists so the test suite
# can run hermetically, and for hosts where /tmp is unsuitable.
if [ -n "${AIRLOCK_TMP_BASE:-}" ] && [ "${AIRLOCK_TMP_BASE}" != "$_AIRLOCK_TMP_BASE_ENV" ]; then
  echo "claude-airlock: AIRLOCK_TMP_BASE is set in $CONFIG_FILE; it must come from the" >&2
  echo "  environment instead. The host 'claude' wrapper reads only the environment, so a" >&2
  echo "  config-only value puts host and box on DIFFERENT scratch dirs with no warning." >&2
  echo "  Export it from your shell rc, or remove it from the config." >&2
  exit 1
fi
AIRLOCK_TMP_BASE="${_AIRLOCK_TMP_BASE_ENV:-$_AIRLOCK_TMP_DEFAULT}"

case "$AIRLOCK_ENGINE" in
  podman|docker) ;;
  *) echo "claude-airlock: AIRLOCK_ENGINE must be 'podman' or 'docker' (got '$AIRLOCK_ENGINE')." >&2; exit 1 ;;
esac
if ! command -v "$AIRLOCK_ENGINE" >/dev/null 2>&1; then
  echo "claude-airlock: '$AIRLOCK_ENGINE' not found on PATH." >&2
  if [ "$AIRLOCK_ENGINE" = podman ] && command -v docker >/dev/null 2>&1; then
    echo "  Docker is installed. To use it (less safe — the docker group is root-equivalent):" >&2
    echo "      AIRLOCK_ENGINE=docker airlock ..." >&2
    echo "  or set AIRLOCK_ENGINE=docker in $CONFIG_FILE" >&2
  fi
  exit 1
fi

# Canonical opt-in egress groups (the "dev registries"). CORE (Anthropic) is always
# on and is NOT a group. A project's posture (STATE_DIR/egress-mode) is one of:
# 'minimal' (core only), 'dev' (all groups), an explicit subset like "github pypi", or
# 'proxy <socket>' (no network; see _egress_proxy_socket).
AIRLOCK_EGRESS_ALL_GROUPS="github npm pypi"
# Normalize a stored posture to a validated space-separated group list ("" = minimal).
# Words come from `read -a`, never an unquoted expansion, which would also glob against the
# workspace (the cwd), whose file names the box chooses.
_resolve_egress_groups() {
  local -a w; local g out=""
  read -ra w <<< "$1"
  case "${w[0]:-}" in
    ""|minimal|proxy) return ;;
    dev) if [ "${#w[@]}" = 1 ]; then printf '%s' "$AIRLOCK_EGRESS_ALL_GROUPS"; return; fi ;;
  esac
  for g in "${w[@]}"; do                              # explicit list — keep known groups, dedup
    case " $AIRLOCK_EGRESS_ALL_GROUPS " in *" $g "*)
      case " $out " in *" $g "*) ;; *) out="${out:+$out }$g" ;; esac ;;
    esac
  done
  printf '%s' "$out"
}

# The 'proxy' posture: the box gets no network at all (--network none, only loopback), and
# reaches out through one host proxy's Unix socket, bridged to a loopback port inside the
# box. The proxy alone decides what is reachable, so groups and `egress =` grants do not
# apply. Stored as "proxy <socket>"; a bare "proxy" (AIRLOCK_EGRESS_MODE=proxy in the host
# config) takes AIRLOCK_EGRESS_PROXY.
_egress_is_proxy() { local w; read -r w _ <<< "$1"; [ "$w" = proxy ]; }
# True when $1 is a posture this launcher knows: empty, minimal, dev, proxy [SOCKET], or a
# list of known groups. Anything else is refused rather than read as minimal: a typo in a
# default meant to be 'proxy' must not quietly hand every box a network.
_egress_posture_valid() {
  local -a w; local g
  read -ra w <<< "$1"
  [ "${#w[@]}" = 0 ] && return 0
  [ "${w[0]}" = proxy ] && return 0
  if [ "${#w[@]}" = 1 ]; then case "${w[0]}" in minimal|dev) return 0 ;; esac; fi
  for g in "${w[@]}"; do
    case " $AIRLOCK_EGRESS_ALL_GROUPS " in *" $g "*) ;; *) return 1 ;; esac
  done
}
# The socket for posture $1, or nothing when it is not 'proxy' or names no socket.
_egress_proxy_socket() {
  local w sock
  read -r w sock _ <<< "$1"
  [ "$w" = proxy ] || return 0
  printf '%s' "${sock:-$AIRLOCK_EGRESS_PROXY}"
}

# The proxy's client manifest, for posture socket $1: airlock-envoy writes <listener>.clients
# next to each box socket, one line per host the box reaches by plain HTTP through it
# ("<host> <port> <rules> <yes|no>"): the proxy checks each request, adds the credential (yes)
# and does the TLS. The launcher points the box's git and gh at http:// for those hosts. What
# it names ends up in the box's git config, so the file is held to the socket's own rule
# (root's, writable only by root, in the socket's root-owned directory) and every line to a
# strict form, or none of it is used. Sets _CLIENT_HOSTS ("<host> <rules> <yes|no>" lines).
# No manifest is not an error: the proxy may not write one.
_airlock_hostname_ok() {
  local o='(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])'
  [[ "$1" =~ ^$o\.$o\.$o\.$o$ ]] && return 0   # an IPv4 address (a Kubernetes API server's)
  [ "${#1}" -le 253 ] && [[ "$1" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]([a-z0-9-]{0,61}[a-z0-9])?$ ]]
}
_airlock_client_manifest() {
  local LC_ALL=C m line n=0 out="" host rules cred
  _CLIENT_HOSTS=""
  case "$1" in *.sock) m="${1%.sock}.clients" ;; *) return 0 ;; esac
  [ -e "$m" ] || [ -L "$m" ] || return 0
  if [ -L "$m" ] || [ ! -f "$m" ]; then
    echo "claude-airlock: ignoring $m: not a regular file; box clients not set up for the proxy" >&2; return 1
  fi
  if [ "$(stat -c %u "$m")" != 0 ] || [ -n "$(find "$m" -maxdepth 0 -perm /022 -print)" ] \
     || [ "$(stat -c %u "$(dirname "$m")")" != 0 ] || [ -n "$(find "$(dirname "$m")" -maxdepth 0 -perm /022 -print)" ]; then
    echo "claude-airlock: ignoring $m: it and its directory must be root's, writable only by root; box clients not set up for the proxy" >&2
    return 1
  fi
  if [ "$(stat -c %s "$m")" -gt 65536 ]; then
    echo "claude-airlock: ignoring $m: over 64 KiB; box clients not set up for the proxy" >&2; return 1
  fi
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    case "$line" in ''|'#'*) continue ;; esac
    host="" rules="" cred=""
    if [[ "$line" =~ ^([a-z0-9.-]+)\ ([1-9][0-9]{0,4})\ ([a-z][a-z0-9-]{0,31})\ (yes|no)$ ]]; then
      host=${BASH_REMATCH[1]} rules=${BASH_REMATCH[3]} cred=${BASH_REMATCH[4]}
    fi
    if [ -z "$host" ] || ! _airlock_hostname_ok "$host"; then
      echo "claude-airlock: ignoring $m: line $n is not '<host> <port> <rules> yes|no'; box clients not set up for the proxy" >&2
      return 1
    fi
    out+="$host $rules $cred"$'\n'
  done < "$m"
  _CLIENT_HOSTS="$out"
}
# The box CLAUDE.md section for the manifest's hosts: how to reach each one and what its rules
# allow, so boxed Claude neither tries https:// (403 "use http://") nor guesses at the limits.
# Only validated manifest fields go in (host names, rule names). Prints nothing for no hosts.
_airlock_box_directives() {
  local host rules cred
  [ -n "$_CLIENT_HOSTS" ] || return 0
  cat <<'EOF'

## Hosts behind the egress proxy (written at launch from the proxy's manifest)

Reach these with **plain `http://<host>/` URLs**: the proxy on the host does the TLS, checks
each request against the host's rules and adds any credential itself. `https://` to them gets
403 "use http://". Never put a token for them in the box, and never ask for one: there is
nothing for it to do. A 403 from `airlock-envoy: refused by the ... rules` is the rule working,
not an outage: say what was refused instead of retrying another way.

EOF
  local unset
  while read -r host rules cred; do
    [ -n "$host" ] || continue
    unset=""
    [ "$cred" = yes ] || unset=" (not set up here: the proxy holds no credential for it)"
    # shellcheck disable=SC2016  # literal backquotes: Markdown code spans
    printf -- '- **`%s`** (rules `%s`, %s): ' "$host" "$rules" \
      "$([ "$cred" = yes ] && echo "the proxy adds the credential" || echo "no credential")"
    case "$rules" in
      victoria-metrics) echo "Prometheus-style query API, reads only: \`curl 'http://$host/api/v1/query?query=up'\`; also query_range, series, labels, label values, metadata." ;;
      victoria-logs) echo "LogsQL, reads only: \`curl 'http://$host/select/logsql/query' -d 'query=...'\` (also hits, stats_query and the rest under /select/logsql/)." ;;
      git) echo "git fetch and push over http:// (remotes are rewritten in the box). The server's branch protection decides what a push may touch." ;;
      git-read) echo "git fetch only (remotes are rewritten in the box); a push is refused." ;;
      forgejo) echo "Forgejo as the proxy's bot account: git fetch and push (remotes rewritten), \`tea\` logged in$unset. API reads, PR create and edit, comments, labels, reviewers. Refused: merge, approve, files written through the API, branch and tag API, releases, settings, keys, deletes, the web UI." ;;
      github-api) echo "\`gh\` is set up, no token needed$unset. Reads, issues, PR create and edit, comments, labels, reviewers. Refused: merge, approve, auto-merge, settings, hooks, keys, deletes, Projects beyond the pinned boards." ;;
      github-issues) echo "\`gh\` is set up, no token needed$unset. Reads, issues, comments, labels, assignees. Refused: PR create and edit, merge, approve, settings, deletes." ;;
      kubernetes-read) echo "\`kubectl\` is set up read-only, KUBECONFIG is set$unset: get, describe, list, watch, logs, events, top, \`auth can-i\`, \`auth whoami\`. Refused: every write, exec, attach, cp, port-forward, proxy. What it may read is the token's RBAC. \"the server has asked for the client to provide credentials\" means the proxy's token expired: ask the human to renew it." ;;
      any) echo "any method and path; nothing is checked beyond the host." ;;
      *) echo "rules the launcher doesn't know: expect 403 for anything outside them." ;;
    esac
  done <<< "$_CLIENT_HOSTS"
}

# The plain-HTTP hosts git goes to (rules that serve git), one per line.
_airlock_client_git_hosts() { awk '$2 == "git" || $2 == "git-read" || $2 == "forgejo" || $2 == "any" { print $1 }' <<< "$_CLIENT_HOSTS"; }

# True if directory $1 is, contains, or sits inside path $2 (both canonical).
_airlock_overlaps() {
  [ "$1" = / ] || [ "$2" = / ] && return 0
  case "$2" in "$1"|"$1"/*) return 0 ;; esac
  case "$1" in "$2"/*) return 0 ;; esac
  return 1
}

# Refuse (reason on stderr, return 1) a canonical directory $1 that overlaps a protected
# location: the dot-dir deny list, the ssh agent socket, gpg's home and socket dir, or
# anything in the host-set AIRLOCK_PROTECTED_PATHS. Key agents do not always live in
# ~/.gnupg or /run/user (a custom GNUPGHOME, `ssh-agent -a`), so they are located, not
# assumed. No override.
_airlock_protected_check() {
  local c="$1" home d p
  home="$(readlink -f "$HOME" 2>/dev/null)" || { echo "cannot resolve \$HOME" >&2; return 1; }
  for d in $AIRLOCK_MOUNT_DENY; do
    d="$home/$d"
    case "$c" in "$d"|"$d"/*) echo "'$c' is inside protected ${d/#$home/\~} (no override)" >&2; return 1 ;; esac
    case "$d" in "$c"/*) echo "'$c' contains protected ${d/#$home/\~} (no override)" >&2; return 1 ;; esac
  done
  # Located once per launch: gpgconf costs ~10ms a call and every share is checked twice.
  if [ -z "${_AIRLOCK_AGENTS_DONE:-}" ]; then
    _AIRLOCK_AGENTS=()
    [ -n "${SSH_AUTH_SOCK:-}" ] && _AIRLOCK_AGENTS+=( "$SSH_AUTH_SOCK" )
    [ -n "${GNUPGHOME:-}" ] && _AIRLOCK_AGENTS+=( "$GNUPGHOME" )
    if command -v gpgconf >/dev/null 2>&1; then
      for d in homedir socketdir; do
        p="$(gpgconf --list-dirs "$d" 2>/dev/null)" && [ -n "$p" ] && _AIRLOCK_AGENTS+=( "$p" )
      done
    fi
    _AIRLOCK_AGENTS_DONE=1
  fi
  local -a prot=( "${_AIRLOCK_AGENTS[@]}" )
  local -a extra=()
  read -ra extra <<< "$AIRLOCK_PROTECTED_PATHS"
  for p in "${extra[@]}"; do
    # shellcheck disable=SC2088  # matching a literal ~/ the config quoted, on purpose
    case "$p" in
      "~") p="$HOME" ;;
      "~/"*) p="$HOME/${p#\~/}" ;;
      /*) ;;
      *) echo "AIRLOCK_PROTECTED_PATHS entry '$p' is not absolute; refusing rather than protecting nothing" >&2
         return 1 ;;
    esac
    prot+=( "$p" )
  done
  for p in "${prot[@]}"; do
    [ -n "$p" ] || continue
    p="$(readlink -f "$p" 2>/dev/null || printf '%s' "$p")"
    if _airlock_overlaps "$c" "$p"; then
      echo "'$c' overlaps protected $p (a key agent, gpg home or AIRLOCK_PROTECTED_PATHS entry) (no override)" >&2
      return 1
    fi
  done
  return 0
}

# True (0) if pass entry $1 matches a glob in the host-set AIRLOCK_SECRET_DENY. The name
# is normalised first (leading /, ./ segments, repeated /), because pass resolves
# "/a", "./a" and "a//b" to the same entry as "a" and "a/b". A symlinked .gpg alias in
# the store cannot be caught by name.
_airlock_secret_denied() {
  local pat e="$1" prev=""; local -a pats=()
  while [ "$e" != "$prev" ]; do
    prev="$e"
    e="$(printf '%s' "$e" | sed -E 's#(^|/)\./#\1#g; s#/+#/#g; s#^/##')"
  done
  read -ra pats <<< "$AIRLOCK_SECRET_DENY"
  for pat in "${pats[@]}"; do
    # shellcheck disable=SC2254
    case "$e" in $pat) return 0 ;; esac
  done
  return 1
}

# Canonical path of share relpath $1 on stdout if it may be mounted; the reason on stderr
# and 1 otherwise. Run when the share is gated and again just before the engine starts.
_airlock_share_check() {
  local base real
  base="$(readlink -e "$AIRLOCK_SHARE_BASE" 2>/dev/null)" || { echo "the share base does not resolve" >&2; return 1; }
  real="$(readlink -e "$AIRLOCK_SHARE_BASE/$1" 2>/dev/null)" || real=""
  if [ "$real" != "$base/$1" ]; then
    echo "it is not a plain path under the share base (it resolves to ${real:-nothing}) (no override)" >&2; return 1
  fi
  [ -d "$real" ] || { echo "it is not a directory" >&2; return 1; }
  _airlock_protected_check "$real" || return 1
  printf '%s\n' "$real"
}

# Gate a space-separated list of requested share relpaths ($1) against a host-side
# approval store ($2) for access mode $3 (ro|rw); approved ABSOLUTE paths are appended
# to the array named $4, and $5 is the OTHER mode's store. The CURRENT config's mode is
# authoritative and the two stores are kept mutually exclusive: approving a path in one
# mode clears it from the other. A rw->ro DOWNGRADE is a privilege reduction, so it's
# auto-allowed (no prompt) if the path is already approved rw. A new path, or a ro->rw
# UPGRADE (more access), prompts — so a compromised box can't widen read into write.
# Relative paths resolve under the HOST-set AIRLOCK_SHARE_BASE (never the project file).
_gate_shares() {
  local _req="$1" _store="$2" _mode="$3"; local -n _dst="$4"; local _other="$5"
  local _s _abs _ans _ok
  [ -n "$_req" ] || return 0
  if [ -z "$AIRLOCK_SHARE_BASE" ]; then
    echo "claude-airlock: .airlock/config requests folder shares but AIRLOCK_SHARE_BASE is unset — skipping." >&2
    return 0
  fi
  touch "$_store"
  local _real _why _rw
  set -f                                                    # split, never glob (see the config parser)
  for _s in $_req; do
    _abs="$AIRLOCK_SHARE_BASE/$_s"
    if [ ! -d "$_abs" ]; then
      echo "claude-airlock: shared folder '$_s' not found under $AIRLOCK_SHARE_BASE — skipping." >&2
      continue
    fi
    # Checked on every launch, approved or not: the box can write .airlock/config and any
    # share_rw directory, so a path approved once can later become a symlink to anywhere
    # (a key agent, /run). The base is host-set and may itself be a link; below it, none.
    # A share inside one of this project's share_rw folders is refused outright: the box
    # could swap it between this check and the mount.
    for _rw in ${_REQ_SHARE_RW:-}; do
      case "$_s" in "$_rw"/*)
        echo "claude-airlock: share '$_s' is inside share_rw '$_rw', which the box can rewrite; not shared (no override)." >&2
        continue 2 ;;
      esac
    done
    if ! _real="$(_airlock_share_check "$_s" 2>/dev/null)"; then
      _why="$(_airlock_share_check "$_s" 2>&1 >/dev/null)" || true
      echo "claude-airlock: share '$_s': $_why; not shared." >&2
      continue
    fi
    _ok=0
    if grep -qxF "$_s" "$_store"; then
      _ok=1                                                 # already approved at this level
    elif [ "$_mode" = ro ] && [ -f "$_other" ] && grep -qxF "$_s" "$_other"; then
      _ok=1                                                 # rw->ro downgrade: less access, auto-allow
      echo "claude-airlock: '$_s' downgraded to read-only (was read-write)." >&2
    fi
    if [ "$_ok" = 0 ]; then                                 # new path, or ro->rw upgrade — needs approval
      if [ "$_mode" = rw ]; then
        echo "claude-airlock: .airlock/config requests WRITE access to '$_s' — not yet approved." >&2
        printf 'Share %s with the sandbox READ-WRITE — the box could MODIFY these files? [y/N] ' "$_abs" >&2
      else
        echo "claude-airlock: .airlock/config requests read access to '$_s' — not yet approved." >&2
        printf 'Share %s with the sandbox (read-only)? [y/N] ' "$_abs" >&2
      fi
      _ans=""; _airlock_answer _ans
      case "$_ans" in
        y|Y|yes|YES) _ok=1; echo "  approved (remembered for this project)." >&2 ;;
        *) echo "  skipped '$_s' — not shared." >&2 ;;
      esac
    fi
    if [ "$_ok" = 1 ]; then                                 # record at this level, clear the other
      grep -qxF "$_s" "$_store" || printf '%s\n' "$_s" >> "$_store"
      if [ -s "$_other" ] && grep -qxF "$_s" "$_other"; then
        grep -vxF "$_s" "$_other" > "$_other.tmp.$$" 2>/dev/null || true; mv "$_other.tmp.$$" "$_other"
      fi
      _dst+=( "$_abs" )
      SHARE_PINS+=( "$(stat -c %d:%i "$_real") $_s" )
    fi
  done
  set +f
}

WORKSPACE="$PWD"

# True when an egress entry (IPv4, IPv4:port or IPv6 literal) points at THIS host or at
# the engine's stand-in for it: loopback, pasta's 169.254.0.0/16 (169.254.1.2 is the
# host, 169.254.1.1 its resolver; 169.254.0.1 on podman 5.0.1-5.2), slirp4netns'
# 10.0.2.0/24 (10.0.2.2 host, 10.0.2.3
# resolver), or any address currently on a host interface (which under docker's bridge
# includes docker0's 172.17.0.1, i.e. the host itself). The box-writable .airlock/config
# can ask for these, and the approval prompt used to show them as a bare IP - a
# prompt-injected `egress = 169.254.1.2:22` plus a reflexive "y" opened host sshd. Such a
# grant is refused outright rather than prompted: there is no reading of "the sandbox
# needs to reach the machine it is sandboxed from" that this file should be able to make.
# An operator who really means it has AIRLOCK_EXTRA_EGRESS in the host config.
_airlock_is_host_address() {
  local ip="${1,,}" a b
  case "$ip" in
    *.*.*.*:*) ip="${ip%:*}" ;;              # IPv4:port
  esac
  if [[ "$ip" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
    IFS=. read -r a b _ _ <<< "$ip"; a=$((10#$a)); b=$((10#$b))
    [ "$a" -eq 127 ] && return 0
    [ "$a" -eq 0 ] && return 0
    [ "$a" -eq 169 ] && [ "$b" -eq 254 ] && return 0
    [ "$a" -eq 10 ] && [ "$b" -eq 0 ] && [[ "$ip" == 10.0.2.* ]] && return 0
  else
    case "$ip" in ::1|::|0:0:0:0:0:0:0:1) return 0 ;; esac
  fi
  # Anything configured on a host interface right now, either family.
  local have
  have="$(ip -o addr show 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | tr 'A-F' 'a-f')"
  [ -n "$have" ] && grep -qxF -- "$ip" <<< "$have"
}

# A prompt's answer, from a person only: with no terminal on stdin (a script, a service unit,
# `airlock -p < input`) the answer is no and stdin is left unread, so piped input can never
# approve a share, an egress grant or a second session, and the command gets all of it.
_airlock_answer() {  # _airlock_answer VAR
  if [ -t 0 ]; then read -r "$1" || printf -v "$1" ''; else printf -v "$1" ''; echo "(no terminal: no)" >&2; fi
}

# `airlock shell` opens an interactive shell in the box instead of Claude — same
# firewall, mounts, git identity, and Postgres, just bash. Doesn't take the
# session lock (a shell can't corrupt --resume history).
AIRLOCK_SHELL=0
if [ "${1:-}" = "shell" ]; then AIRLOCK_SHELL=1; shift; fi
# `airlock exec -- COMMAND [ARG...]` runs one command in the box instead of Claude: the
# box `airlock shell` gets, for a script or a service unit (no terminal needed). Its exit
# status is the launcher's.
AIRLOCK_EXEC=()
if [ "${1:-}" = exec ]; then
  if [ "${2:-}" != -- ] || [ -z "${3:-}" ]; then
    echo "usage: airlock exec -- COMMAND [ARG...]" >&2; exit 2
  fi
  AIRLOCK_SHELL=1; AIRLOCK_EXEC=( "${@:3}" ); set --
fi

# `airlock secret set|list|rm` manages the host-side per-project secret store —
# the host-CONTROLLED grant of what this project's box gets, injected as env at
# launch. Values are literal or `pass:PATH` (resolved via `pass show` at launch,
# so they stay encrypted at rest). The store lives in STATE_DIR, never mounted
# into the box, so the sandbox can neither read it nor choose its own secrets.
# Keys a secret may not set: the launcher's own AIRLOCK_* variables (AIRLOCK_EGRESS_PROXY
# picks the entrypoint's no-firewall branch) and the proxy variables the proxy posture owns.
_airlock_secret_reserved() {
  case "$1" in AIRLOCK_*|*_PROXY|*_proxy) return 0 ;; esac
  return 1
}

if [ "${1:-}" = "secret" ]; then
  _sslug="$(printf '%s' "$WORKSPACE" | sed 's#[^a-zA-Z0-9]#-#g; s#^-*##')"
  _sstore="$HOME/.config/claude-airlock/state/$_sslug/secrets"
  mkdir -p "$(dirname "$_sstore")"
  case "${2:-list}" in
    set)
      _sk="${3:?usage: airlock secret set KEY VALUE|pass:PATH}"
      case "$_sk" in ''|*[!A-Za-z0-9_]*) echo "airlock: invalid key '$_sk' (A-Z 0-9 _ only)" >&2; exit 1 ;; esac
      if _airlock_secret_reserved "$_sk"; then
        echo "airlock: '$_sk' is reserved: AIRLOCK_* and *_PROXY variables are set by the launcher, never by a secret" >&2; exit 1
      fi
      shift 3; _sv="$*"
      [ -n "$_sv" ] || { echo "airlock: no value given for $_sk" >&2; exit 1; }
      case "$_sv" in
        pass:*) if _airlock_secret_denied "${_sv#pass:}"; then
                  echo "airlock: '${_sv#pass:}' matches AIRLOCK_SECRET_DENY; it must never enter a box (no override)" >&2; exit 1
                fi ;;
      esac
      touch "$_sstore"; chmod 600 "$_sstore"
      sed -i "/^${_sk}=/d" "$_sstore" 2>/dev/null || true
      printf '%s=%s\n' "$_sk" "$_sv" >> "$_sstore"
      echo "airlock: set $_sk for $(basename "$WORKSPACE")" ;;
    list)
      echo "secrets for $(basename "$WORKSPACE")  ($_sstore):"
      if [ -s "$_sstore" ]; then
        while IFS= read -r _l || [ -n "$_l" ]; do
          case "$_l" in
            ''|\#*) continue ;;
            *=pass:*) echo "  ${_l%%=*} = ${_l#*=}" ;;   # pass ref — a pointer, not a secret; show it
            *=*)      echo "  ${_l%%=*} = ***" ;;         # literal value — mask
          esac
        done < "$_sstore"
      else echo "  (none)"; fi ;;
    rm)
      _sk="${3:?usage: airlock secret rm KEY}"
      if [ -f "$_sstore" ]; then sed -i "/^${_sk}=/d" "$_sstore"; echo "airlock: removed $_sk"; else echo "airlock: no secrets"; fi ;;
    *) echo "usage: airlock secret set KEY VALUE|pass:PATH  |  airlock secret list  |  airlock secret rm KEY" >&2; exit 1 ;;
  esac
  exit 0
fi

# `airlock share list|rm` reviews the host-side folder-share approvals for this
# project (the TOFU allowlist a `share =` line in .airlock/config is checked
# against). Like secrets, the list lives in STATE_DIR and the box can't touch it;
# `rm` revokes an approval so the next launch re-prompts (or drops the mount).
if [ "${1:-}" = "share" ]; then
  _shslug="$(printf '%s' "$WORKSPACE" | sed 's#[^a-zA-Z0-9]#-#g; s#^-*##')"
  _shdir="$HOME/.config/claude-airlock/state/$_shslug"
  _shstore="$_shdir/approved-shares"; _shstore_rw="$_shdir/approved-shares-rw"
  case "${2:-list}" in
    list)
      echo "approved shares for $(basename "$WORKSPACE"):"
      echo "  base: ${AIRLOCK_SHARE_BASE:-<unset>}"
      _shany=0
      for _row in "ro=$_shstore" "rw=$_shstore_rw"; do
        _shmode="${_row%%=*}"; _shf="${_row#*=}"
        [ -s "$_shf" ] || continue
        while IFS= read -r _l || [ -n "$_l" ]; do
          [ -n "$_l" ] || continue
          echo "  $_l  ->  ${AIRLOCK_SHARE_BASE:-<base unset>}/$_l  ($_shmode)"; _shany=1
        done < "$_shf"
      done
      [ "$_shany" = 1 ] || echo "  (none)" ;;
    rm)
      _shk="${3:?usage: airlock share rm RELPATH}"
      _shrm=0
      for _shf in "$_shstore" "$_shstore_rw"; do
        if [ -f "$_shf" ] && grep -qxF "$_shk" "$_shf"; then
          grep -vxF "$_shk" "$_shf" > "$_shf.tmp.$$" || true; mv "$_shf.tmp.$$" "$_shf"; _shrm=1
        fi
      done
      if [ "$_shrm" = 1 ]; then echo "airlock: revoked share $_shk (next launch re-prompts)"
      else echo "airlock: no such approved share '$_shk' (see 'airlock share list')"; fi ;;
    *) echo "usage: airlock share list  |  airlock share rm RELPATH" >&2; exit 1 ;;
  esac
  exit 0
fi

# `airlock mount add|list|rm` manages extra READ-ONLY host directories for this project's
# box - the way to hand a box a scoped credential that lives outside AIRLOCK_SHARE_BASE
# (e.g. a read-only kubeconfig + short-lived token dir, re-minted on the host and picked up
# live). Like secrets it is host-only: the store lives in STATE_DIR, and there is no
# .airlock/config key for it, so a box cannot request its own mounts.
#
# Foot-gun protection, with deliberately NO override: the path must be an existing
# directory under $HOME (symlinks resolved), and must not be $HOME, inside a credential
# directory, or an ancestor of one (so ~/.config is refused because it holds sops keys).
# A directory holding a hard-linked file is refused too: a hard link to ~/.ssh/id_ed25519
# is the same inode, and a bind mount would expose it with no symlink to resolve. So is a
# directory with a mount point inside it: the hard-link scan stops at filesystem
# boundaries (-xdev) while the engine's bind is recursive, so a FUSE or bind mount nested
# in there would be handed to the box unscanned. The same check re-runs at every launch,
# so swapping an approved directory for a symlink later gets it skipped, not mounted.
#
# The deny list is a guard against habit, not an inventory of where credentials live -
# it cannot be complete. `mount add` therefore also prints what the box will get.
AIRLOCK_MOUNT_DENY=".ssh .keychain .gnupg .kube .password-store .claude .aws .azure .docker .pki
  .mozilla .config/sops .config/age .config/claude-airlock .config/gcloud .config/gh
  .config/tea .config/containers .config/chromium .config/google-chrome
  .config/rclone .config/helm .config/hcloud .config/op .config/git .config/argocd
  .config/pip .config/Code .terraform.d .m2 .gradle
  .local/share/keyrings .local/share/containers"

# Canonical path on stdout if DIR may be mounted; otherwise the reason on stderr and 1.
_airlock_mount_check() {
  local want="$1" c home d
  home="$(readlink -f "$HOME" 2>/dev/null)" || { echo "cannot resolve \$HOME" >&2; return 1; }
  c="$(readlink -e "$want" 2>/dev/null)" || { echo "'$want' does not exist" >&2; return 1; }
  [ -d "$c" ] || { echo "'$c' is not a directory" >&2; return 1; }
  case "$c" in
    "$home") echo "refusing \$HOME itself" >&2; return 1 ;;
    "$home"/*) ;;
    *) echo "'$c' is outside \$HOME ($home)" >&2; return 1 ;;
  esac
  _airlock_protected_check "$c" || return 1
  case "$c" in
    "$WORKSPACE"|"$WORKSPACE"/*) echo "'$c' is inside the workspace, which is already mounted" >&2; return 1 ;;
  esac
  case "$WORKSPACE" in
    "$c"/*) echo "'$c' contains the workspace" >&2; return 1 ;;
  esac
  # Owned by you and writable only by you: anyone else who can write here can plant what
  # the box then trusts (a kubeconfig pointing at their server, say).
  if [ "$(stat -c %u "$c")" != "$(id -u)" ] || [ -n "$(find "$c" -maxdepth 0 -perm /022 -print)" ]; then
    echo "'$c' must be owned by you and not group/world-writable (chmod 700 it)" >&2
    return 1
  fi
  if [ -n "$(find "$c" -xdev -type f -links +1 -print -quit 2>/dev/null)" ]; then
    echo "'$c' holds a hard-linked file, which could expose a file from anywhere (no override)" >&2
    return 1
  fi
  # Every mount point strictly below the directory. findmnt lists the whole namespace;
  # the prefix match is on the target column alone.
  if findmnt -rn -o TARGET 2>/dev/null | awk -v p="$c/" 'index($0, p) == 1 { f = 1 } END { exit !f }'; then
    echo "'$c' contains a mount point, which the engine would bind recursively and the hard-link check cannot see into (no override)" >&2
    return 1
  fi
  printf '%s\n' "$c"
}

# Writes into folders the box mounts read-write (dot-claude/, the scratch dir's pastes/).
# dot-claude/ is mounted read-write into the box, so the box decides what every name in it
# is: a file, a folder, a FIFO, or a symlink to anywhere this user can reach on the host.
# The launcher therefore never opens a path there by name. It builds content in a private
# temp file in $STATE_DIR (not mounted into the box) and renames it in: rename(2) replaces a
# link or a FIFO instead of following it, and stays atomic for sibling launches reading the
# same file. A folder in the way stops the launch rather than being guessed about.
# (Temp names inside dot-claude, `name.tmp.$$`, let a box that guessed the next launcher PID
# plant a link there and have the launcher write through it: pentest 2026-10-20, O9/O10.)
_airlock_private_tmp() { mktemp "$STATE_DIR/.write.$$.XXXXXX"; }
_airlock_kind() {   # what a path is, for the message below
  if [ -L "$1" ]; then echo "a symlink"
  elif [ -d "$1" ]; then echo "a folder"
  elif [ -p "$1" ]; then echo "a FIFO"
  elif [ -f "$1" ]; then echo "a regular file"
  elif [ -e "$1" ]; then echo "not a regular file"
  else echo "missing"; fi
}
_airlock_planted() {   # $1 = path, $2 = what it is, $3 = what it should be
  echo "claude-airlock: $1 is $2, not $3. It sits in a folder the box can write, so the box" >&2
  echo "  may have put it there to redirect the launcher (was this planted?). Check it, remove" >&2
  echo "  it, then launch again." >&2
}
_airlock_place() {   # $1 = private temp file, $2 = destination in a box-writable folder
  local err
  if [ -d "$2" ] && [ ! -L "$2" ]; then
    rm -f "$1"; _airlock_planted "$2" "a folder" "a regular file"; exit 1
  fi
  # -T is load-bearing: plain `mv` onto a link to a folder moves the file INTO that folder.
  if ! err="$(mv -fT -- "$1" "$2" 2>&1)"; then
    rm -f "$1"
    if [ -d "$2" ] && [ ! -L "$2" ]; then _airlock_planted "$2" "a folder" "a regular file"
    else echo "claude-airlock: could not place $2: ${err:-mv failed}; not launching" >&2; fi
    exit 1
  fi
}
# The paste drop box (AIRLOCK_PASTE_DIR): canonical path on stdout if it may be mounted
# read-only into the box; otherwise the reason on stderr and 1. Unlike `mount`, it may be
# another account's directory (whoever hands you pastes owns it and writes it; you only read
# it), so the rule is about who can change it: only its owner may write in it, and every
# directory above it is root's and writable by root alone (a sticky /tmp is not: anyone could
# have made a directory there), so not even its owner can swap it for a symlink to somewhere
# else between this check and the mount. Hard links and mount points are refused as found
# here; what the owner adds later is bounded by the kernel (fs.protected_hardlinks lets them
# link only files they own or may write; a FUSE mount of theirs is closed to other users).
_airlock_paste_dir_check() { _airlock_host_dir_check "$1" paste; }
# A host-configured extra mount (AIRLOCK_EXTRA_MOUNTS): the same rules, but the directory itself
# may be group-writable (a queue several accounts write); it must be root's or this account's
# and never world-writable. Every directory above it is still root's and root-writable only.
_airlock_extra_mount_check() { _airlock_host_dir_check "$1" extra; }
_airlock_host_dir_check() {   # $1 = path, $2 = paste | extra
  local want="$1" kind="$2" c home d u m
  case "$want" in /*) ;; *) echo "'$want' must be an absolute path" >&2; return 1 ;; esac
  case "$want" in
    *:*|*,*|*[[:cntrl:]]*) echo "'$want' contains ':', ',' or a control character" >&2; return 1 ;;
  esac
  home="$(readlink -f "$HOME" 2>/dev/null)" || { echo "cannot resolve \$HOME" >&2; return 1; }
  c="$(readlink -e "$want" 2>/dev/null)" || { echo "'$want' does not exist" >&2; return 1; }
  [ "$c" = "$want" ] || { echo "'$want' is not its real path ($c): name that" >&2; return 1; }
  [ -d "$c" ] || { echo "'$c' is not a directory" >&2; return 1; }
  case "$c" in /|"$home") echo "refusing '$c' itself" >&2; return 1 ;; esac
  # Mounted at its own path, a system directory would cover the image's own (its managed
  # settings in /etc, its entrypoint in /usr/local/bin): a drop box lives somewhere of its own.
  # (/tmp is refused below: it is writable by more than root.)
  case "$c" in
    /etc|/etc/*|/usr|/usr/*|/bin|/bin/*|/sbin|/sbin/*|/lib|/lib/*|/lib64|/lib64/*|/opt|/opt/*|/root|/root/*|/boot|/boot/*|/var|/var/*|/run|/run/*|/proc|/proc/*|/sys|/sys/*|/dev|/dev/*|/home|/home/dev|/home/dev/*)
      echo "'$c' is a system directory (or inside one), which the box has its own of" >&2; return 1 ;;
  esac
  _airlock_protected_check "$c" || return 1
  case "$c" in
    "$WORKSPACE"|"$WORKSPACE"/*) echo "'$c' is inside the workspace, which is already mounted" >&2; return 1 ;;
  esac
  case "$WORKSPACE" in "$c"/*) echo "'$c' contains the workspace" >&2; return 1 ;; esac
  d="$c"
  if [ "$kind" = extra ]; then
    u="$(stat -c %u "$c")" m="$(stat -c %a "$c")"
    if [ "$u" != 0 ] && [ "$u" != "$(id -u)" ]; then
      echo "'$c' must be root's or yours" >&2; return 1
    fi
    if [[ ! "$m" =~ ^[0-7]{3,4}$ ]] || (( 8#$m & 8#002 )); then
      echo "'$c' is world-writable" >&2; return 1
    fi
    d="$(dirname "$c")"
  fi
  while :; do
    u="$(stat -c %u "$d")" m="$(stat -c %a "$d")"
    if [ "$d" != "$c" ] && [ "$u" != 0 ]; then
      echo "'$d' (above '$c') must be root's, so the directory's owner cannot swap it" >&2; return 1
    fi
    if [[ ! "$m" =~ ^[0-7]{3,4}$ ]] || (( 8#$m & 8#022 )); then
      echo "'$d' (holding or being '$c') is group/world-writable: only its owner may write there" >&2; return 1
    fi
    [ "$d" = / ] && break
    d="$(dirname "$d")"
  done
  if [ -n "$(find "$c" -xdev -type f -links +1 -print -quit 2>/dev/null)" ]; then
    echo "'$c' holds a hard-linked file, which could expose a file from anywhere (no override)" >&2
    return 1
  fi
  if findmnt -rn -o TARGET 2>/dev/null | awk -v p="$c/" 'index($0, p) == 1 { f = 1 } END { exit !f }'; then
    echo "'$c' contains a mount point (no override)" >&2
    return 1
  fi
  printf '%s\n' "$c"
}

if [ "${1:-}" = "mount" ]; then
  _mslug="$(printf '%s' "$WORKSPACE" | sed 's#[^a-zA-Z0-9]#-#g; s#^-*##')"
  _mstore="$HOME/.config/claude-airlock/state/$_mslug/mounts"
  mkdir -p "$(dirname "$_mstore")"
  case "${2:-list}" in
    add)
      _mp="${3:?usage: airlock mount add DIR}"
      _mc="$(_airlock_mount_check "$_mp" 2>&1)" || { echo "airlock: $_mc" >&2; exit 1; }
      touch "$_mstore"
      grep -qxF "$_mc" "$_mstore" || printf '%s\n' "$_mc" >> "$_mstore"
      echo "airlock: $_mc will be mounted READ-ONLY into $(basename "$WORKSPACE")'s box (next launch)"
      # Show what that grants. The deny list catches the usual places; it cannot know
      # every file that is a credential, and the operator can, if they see the names.
      _mn="$(find "$_mc" -type f 2>/dev/null | wc -l)"
      echo "  every box on this project will be able to read its $_mn file(s), and whatever lands here later:"
      find "$_mc" -type f 2>/dev/null | sed "s#^$_mc/#    #" | head -20
      [ "$_mn" -gt 20 ] && echo "    ... and $((_mn - 20)) more" ;;
    list)
      echo "read-only mounts for $(basename "$WORKSPACE")  ($_mstore):"
      if [ -s "$_mstore" ]; then
        while IFS= read -r _l || [ -n "$_l" ]; do
          [ -n "$_l" ] || continue
          if ! _mwhy="$(_airlock_mount_check "$_l" 2>&1)"; then echo "  $_l  (SKIPPED at launch: $_mwhy)"
          elif [ "$_mwhy" != "$_l" ]; then echo "  $_l  (SKIPPED at launch: now resolves to $_mwhy)"
          else echo "  $_l  (ro)"; fi
        done < "$_mstore"
      else echo "  (none)"; fi ;;
    rm)
      _mp="${3:?usage: airlock mount rm DIR}"
      _mc="$(readlink -f "$_mp" 2>/dev/null || printf '%s' "$_mp")"
      if [ -f "$_mstore" ] && { grep -qxF "$_mp" "$_mstore" || grep -qxF "$_mc" "$_mstore"; }; then
        grep -vxF -e "$_mp" -e "$_mc" "$_mstore" > "$_mstore.tmp.$$" || true; mv "$_mstore.tmp.$$" "$_mstore"
        echo "airlock: removed mount $_mp"
      else echo "airlock: no such mount '$_mp' (see 'airlock mount list')"; fi ;;
    *) echo "usage: airlock mount add DIR  |  airlock mount list  |  airlock mount rm DIR" >&2; exit 1 ;;
  esac
  exit 0
fi

# `airlock socket add|list|rm` bind-mounts one host Unix socket into this project's box, at
# its real path - the way to give a box a credential-injecting proxy (airlock-cred-proxy, say)
# without giving it the credential. Host-only like `mount`: the store lives in STATE_DIR and
# there is no .airlock/config key, so a box cannot request its own sockets.
#
# A socket is a capability: the box connects as YOU (keep-id maps the box user to your uid;
# supplementary groups do not survive the user namespace, so grant the uid with an ACL).
# The rule, with no override, at add and at every launch:
#   the socket is owned by a dedicated service account (not you, not root), and every
#   directory from it up to / is owned by root and writable by nobody else; a directory
#   above the socket's own may be world-writable only if sticky (/tmp).
# Sockets owned by you (session bus, agents, screen/tmux, credential caches) or by root
# (WSL interop, libvirt, snapd) are refused whatever path reaches them - WSLg exposes the
# same files under /mnt/wslg, so a path deny list alone cannot hold. Root-owned directories
# also mean nothing running as you, the box included, can swap the socket. A deny list of
# well-known sockets stays as a second layer, and the socket's identity is re-checked
# immediately before the engine starts.

# Canonical path on stdout if SOCKET may be mounted; otherwise the reason on stderr and 1.
_airlock_socket_check() {
  local want="$1" c me owner uid_min home rt d dir
  case "$want" in /*) ;; *) echo "'$want' must be an absolute path" >&2; return 1 ;; esac
  case "$want" in
    *:*|*,*|*[[:cntrl:]]*) echo "'$want' contains ':', ',' or a control character" >&2; return 1 ;;
  esac
  c="$(readlink -e "$want" 2>/dev/null)" || { echo "'$want' does not exist" >&2; return 1; }
  if [ "$c" != "$want" ]; then
    case "$want" in
      *//*|*/./*|*/../*|*/.|*/..|*/) echo "'$want' is not a canonical path; use $c" >&2 ;;
      *) echo "'$want' goes through a symlink (it resolves to $c); name the real path" >&2 ;;
    esac
    return 1
  fi
  [ -S "$c" ] || { echo "'$c' is not a Unix socket" >&2; return 1; }
  me="$(id -u)"; owner="$(stat -c %u "$c")"
  if [ "$owner" = 0 ] || [ "$owner" = "$me" ]; then
    echo "'$c' is owned by $([ "$owner" = 0 ] && echo root || echo you); only a socket owned by a dedicated service account can be granted (no override)" >&2
    return 1
  fi
  # A dedicated service account is a system account: not nobody (shared by unrelated
  # daemons) and not a human login (UID_MIN and up).
  uid_min="$(awk '$1 == "UID_MIN" { print $2 }' /etc/login.defs 2>/dev/null)"
  case "$uid_min" in ''|*[!0-9]*) uid_min=1000 ;; esac
  if [ "$owner" = 65534 ] || [ "$owner" -ge "$uid_min" ]; then
    echo "'$c' is owned by uid $owner, which is nobody or a login account, not a system service account (no override)" >&2
    return 1
  fi
  # Ownership is only as honest as the filesystem reporting it; a FUSE mount can claim any
  # owner. Accept the local filesystems a service socket actually lives on.
  case "$(stat -f -c %T "$c" 2>/dev/null)" in
    tmpfs|ext2/ext3|xfs|btrfs) ;;
    *) echo "'$c' is on a $(stat -f -c %T "$c" 2>/dev/null) filesystem; only tmpfs, ext4, xfs or btrfs are trusted to report owners" >&2; return 1 ;;
  esac
  home="$(readlink -f "$HOME" 2>/dev/null)" || { echo "cannot resolve \$HOME" >&2; return 1; }
  rt="${XDG_RUNTIME_DIR:-/run/user/$me}"
  rt="$(readlink -f "$rt" 2>/dev/null || printf '%s' "$rt")"
  case "$c" in
    "$rt"/*|/run/user/*|/var/run/user/*|/mnt/wslg/*|/run/WSL/*|/var/run/WSL/*)
      echo "'$c' is in a per-user runtime or WSL dir (session bus, engines, agents, Windows interop) (no override)" >&2; return 1 ;;
    */docker.sock|*/podman.sock|*/containerd.sock|*/crio.sock|*/docker/*|*/podman/*|*/containerd/*|*/crio/*)
      echo "'$c' looks like a container engine socket, which is root on the host (no override)" >&2; return 1 ;;
    /run/dbus/*|/var/run/dbus/*|/run/systemd/*|/var/run/systemd/*)
      echo "'$c' is a system bus or systemd socket (no override)" >&2; return 1 ;;
    /tmp/.X11-unix/*|*/wayland-*|*/pulse/*|*/pipewire-*)
      echo "'$c' is a display or audio server socket (no override)" >&2; return 1 ;;
    */S.gpg-agent*|*/S.scdaemon*|*/S.dirmngr*|*/ssh-agent*|*/ssh-*/agent.*)
      echo "'$c' is a key agent socket (no override)" >&2; return 1 ;;
  esac
  if [ -n "${SSH_AUTH_SOCK:-}" ] && [ -e "$SSH_AUTH_SOCK" ] \
      && [ "$(stat -L -c %d:%i "$SSH_AUTH_SOCK")" = "$(stat -c %d:%i "$c")" ]; then
    echo "'$c' is your SSH agent (no override)" >&2; return 1
  fi
  for d in $AIRLOCK_MOUNT_DENY; do
    case "$c" in "$home/$d"/*) echo "'$c' is inside protected ~/$d (no override)" >&2; return 1 ;; esac
  done
  case "$c" in
    "$WORKSPACE"/*) echo "'$c' is inside the workspace; the box can already reach it" >&2; return 1 ;;
  esac
  dir="$(dirname "$c")"
  if [ -n "$(find "$dir" -maxdepth 0 -perm /022 -print)" ]; then
    echo "'$dir' (holding '$c') must not be group/world-writable" >&2; return 1
  fi
  while :; do
    if [ "$(stat -c %u "$dir")" != 0 ]; then
      echo "'$dir' (holding or above '$c') must be owned by root, so nothing running as you can swap the socket" >&2; return 1
    fi
    if [ -n "$(find "$dir" -maxdepth 0 -perm /022 ! -perm -1000 -print)" ]; then
      echo "'$dir' (above '$c') is group/world-writable without the sticky bit" >&2; return 1
    fi
    [ "$dir" = / ] && break
    dir="$(dirname "$dir")"
  done
  printf '%s\n' "$c"
}

if [ "${1:-}" = "socket" ]; then
  _kslug="$(printf '%s' "$WORKSPACE" | sed 's#[^a-zA-Z0-9]#-#g; s#^-*##')"
  _kstore="$HOME/.config/claude-airlock/state/$_kslug/sockets"
  mkdir -p "$(dirname "$_kstore")"
  case "${2:-list}" in
    add)
      _kp="${3:?usage: airlock socket add SOCKET}"
      _kc="$(_airlock_socket_check "$_kp" 2>&1)" || { echo "airlock: $_kc" >&2; exit 1; }
      touch "$_kstore"
      grep -qxF "$_kc" "$_kstore" || printf '%s\n' "$_kc" >> "$_kstore"
      echo "airlock: $_kc will be bind-mounted into $(basename "$WORKSPACE")'s box (next launch)"
      echo "  owner $(stat -c '%U:%G mode %a' "$_kc"). Every box on this project can connect to it as"
      echo "  you (uid $(id -u)): whatever that service lets you do, the box can do." ;;
    list)
      echo "sockets for $(basename "$WORKSPACE")  ($_kstore):"
      if [ -s "$_kstore" ]; then
        while IFS= read -r _l || [ -n "$_l" ]; do
          [ -n "$_l" ] || continue
          if _kwhy="$(_airlock_socket_check "$_l" 2>&1)"; then echo "  $_l"
          else echo "  $_l  (SKIPPED at launch: $_kwhy)"; fi
        done < "$_kstore"
      else echo "  (none)"; fi ;;
    rm)
      _kp="${3:?usage: airlock socket rm SOCKET}"
      if [ -f "$_kstore" ] && grep -qxF "$_kp" "$_kstore"; then
        grep -vxF -e "$_kp" "$_kstore" > "$_kstore.tmp.$$" || true; mv "$_kstore.tmp.$$" "$_kstore"
        echo "airlock: removed socket $_kp"
      else echo "airlock: no such socket '$_kp' (see 'airlock socket list')"; fi ;;
    *) echo "usage: airlock socket add SOCKET  |  airlock socket list  |  airlock socket rm SOCKET" >&2; exit 1 ;;
  esac
  exit 0
fi

# `airlock egress [show|list|minimal|dev|<groups>|add <groups>|rm <groups>|proxy [SOCKET]]`
# reviews or sets this project's egress POSTURE. Default 'minimal' = Anthropic core only
# (Claude can't run without it) plus any host-approved `egress =` domains. 'dev' opens all
# convenience groups; name a subset to REPLACE (e.g. `egress github pypi` — GitHub+PyPI,
# no npm); or edit incrementally with `add`/`rm` (e.g. `egress rm pypi`). 'proxy SOCKET'
# takes the network away entirely and sends everything through that host proxy socket (see
# _egress_is_proxy). The posture lives host-side in STATE_DIR (never mounted into the box),
# so widening is a deliberate HOST action; a compromised box can't grant itself a registry
# as an exfil channel, or leave the proxy.
if [ "${1:-}" = "egress" ]; then
  _egslug="$(printf '%s' "$WORKSPACE" | sed 's#[^a-zA-Z0-9]#-#g; s#^-*##')"
  _egdir="$HOME/.config/claude-airlock/state/$_egslug"; mkdir -p "$_egdir"
  _egmode="$(cat "$_egdir/egress-mode" 2>/dev/null || echo "${AIRLOCK_EGRESS_MODE:-minimal}")"
  _egname="$(basename "$WORKSPACE")"
  # Leaving proxy mode gives the box a network again, so say so rather than let a group
  # change do it quietly.
  _egleave() {
    if _egress_is_proxy "$_egmode"; then
      echo "  This leaves proxy mode: the box gets a network again, limited by the in-box firewall."
    fi
  }
  _egwrite() {   # store a resolved group list; empty -> minimal
    if [ -z "$1" ]; then printf 'minimal\n' > "$_egdir/egress-mode"
      echo "airlock: egress for $_egname -> minimal (Anthropic core only)"
    else printf '%s\n' "$1" > "$_egdir/egress-mode"
      echo "airlock: egress groups for $_egname -> $1"; fi
    _egleave
  }
  _egapproved="$(grep -c . "$_egdir/approved-egress" 2>/dev/null || true)"
  case "${2:-show}" in
    show|list)
      echo "egress for $_egname:"
      if ! _egress_posture_valid "$_egmode"; then
        echo "  posture: '$_egmode' is not minimal, dev, proxy or a group list; launches are REFUSED"
        echo "  (fix AIRLOCK_EGRESS_MODE in $CONFIG_FILE, or set one: airlock egress minimal | dev | proxy SOCKET)"
      elif _egress_is_proxy "$_egmode"; then
        _egp="$(_egress_proxy_socket "$_egmode")"
        echo "  posture: proxy"
        if [ -z "$_egp" ]; then
          echo "  proxy socket: <none> (set AIRLOCK_EGRESS_PROXY or run 'airlock egress proxy SOCKET'; launches are refused)"
        elif _egwhy="$(_airlock_socket_check "$_egp" 2>&1)"; then
          echo "  proxy socket: $_egp"
        else
          echo "  proxy socket: $_egp  (launches are REFUSED: $_egwhy)"
        fi
        echo "  network: none; the proxy's allowlist decides what is reachable"
        if [ -n "$_egp" ]; then
          if ! _egwhy="$(_airlock_client_manifest "$_egp" 2>&1)"; then
            echo "  plain HTTP through the proxy: not set up (${_egwhy#claude-airlock: })"
          elif _airlock_client_manifest "$_egp" 2>/dev/null && [ -n "$_CLIENT_HOSTS" ]; then
            echo "  plain HTTP through the proxy (it adds any credential; box git and gh use http:// for these):"
            awk 'NF { printf "    %s (rules %s, credential %s)\n", $1, $2, $3 }' <<< "$_CLIENT_HOSTS"
          fi
        fi
        if [ -s "$_egdir/sockets" ] && grep -qvxF "$_egp" "$_egdir/sockets"; then
          echo "  also reachable, outside the proxy (granted with 'airlock socket add'):"
          grep -vxF "$_egp" "$_egdir/sockets" | sed 's/^/    /'
        fi
        echo "  ignored while proxy is set: egress groups, host-approved 'egress =' domains (${_egapproved:-0})${AIRLOCK_EXTRA_EGRESS:+, AIRLOCK_EXTRA_EGRESS}"
      else
        _egnow="$(_resolve_egress_groups "$_egmode")"
        echo "  posture: ${_egmode:-minimal}"
        echo "  active groups: ${_egnow:-<none — Anthropic core only>}"
        echo "  available groups: $AIRLOCK_EGRESS_ALL_GROUPS"
        echo "  host-approved extra domains (.airlock/config 'egress ='):"
        if [ -s "$_egdir/approved-egress" ]; then sed 's/^/    /' "$_egdir/approved-egress"; else echo "    (none)"; fi
        if _egress_is_proxy "${AIRLOCK_EGRESS_MODE:-}"; then
          echo "  note: the host default (AIRLOCK_EGRESS_MODE) is proxy; this project overrides it"
        fi
      fi ;;
    proxy)
      _egp="${3:-$AIRLOCK_EGRESS_PROXY}"
      [ -n "$_egp" ] || { echo "usage: airlock egress proxy SOCKET   (or set AIRLOCK_EGRESS_PROXY in $CONFIG_FILE)" >&2; exit 1; }
      case "$_egp" in *[[:space:]]*) echo "airlock: '$_egp' contains whitespace" >&2; exit 1 ;; esac
      _egc="$(_airlock_socket_check "$_egp" 2>&1)" || { echo "airlock: $_egc" >&2; exit 1; }
      printf 'proxy %s\n' "$_egc" > "$_egdir/egress-mode"
      echo "airlock: egress for $_egname -> proxy via $_egc"
      echo "  The box gets no network (loopback only). Everything goes through that socket, and"
      echo "  the proxy behind it decides what is reachable; launches are refused while the socket"
      echo "  is missing or fails the socket rule. Ignored while proxy is set: egress groups,"
      echo "  host-approved 'egress =' domains (${_egapproved:-0})${AIRLOCK_EXTRA_EGRESS:+, AIRLOCK_EXTRA_EGRESS}." ;;
    minimal)
      _egwrite "" ;;
    dev)
      printf 'dev\n' > "$_egdir/egress-mode"
      echo "airlock: egress for $_egname -> dev (all groups: $AIRLOCK_EGRESS_ALL_GROUPS)"
      _egleave ;;
    add|rm|github|npm|pypi)                            # set/edit the group list
      _op="set"; case "$2" in add|rm) _op="$2"; shift 2 ;; *) shift ;; esac
      if [ "$_op" != set ] && _egress_is_proxy "$_egmode"; then
        echo "airlock: egress for $_egname is 'proxy': groups do not apply, the proxy decides." >&2
        echo "  To leave proxy mode, set a posture: airlock egress minimal | dev | <groups>" >&2
        exit 1
      fi
      [ "$#" -gt 0 ] || { echo "usage: airlock egress $_op <groups: $AIRLOCK_EGRESS_ALL_GROUPS>" >&2; exit 1; }
      for _g in "$@"; do                               # validate every requested group
        case " $AIRLOCK_EGRESS_ALL_GROUPS " in *" $_g "*) ;; *) echo "airlock: unknown egress group '$_g' (valid: $AIRLOCK_EGRESS_ALL_GROUPS)" >&2; exit 1 ;; esac
      done
      case "$_op" in
        set) _sel="$*" ;;                              # REPLACE with the named groups
        add) _sel="$(_resolve_egress_groups "$_egmode") $*" ;;   # union with current
        rm)  _sel=""; for _g in $(_resolve_egress_groups "$_egmode"); do
               _keep=1; for _r in "$@"; do [ "$_g" = "$_r" ] && _keep=0; done
               [ "$_keep" = 1 ] && _sel="${_sel:+$_sel }$_g"; done ;;
      esac
      _egwrite "$(_resolve_egress_groups "$_sel")" ;;  # resolver validates + dedups
    *) echo "usage: airlock egress [show|list] | minimal | dev | <groups> | add <groups> | rm <groups> | proxy [SOCKET]   (groups: $AIRLOCK_EGRESS_ALL_GROUPS)" >&2; exit 1 ;;
  esac
  exit 0
fi

# `airlock login [show|token|persist]` sets how THIS project authenticates.
#
#   token   (default, every project) — the host injects the shared long-lived
#           token. Right for disposable boxes: no per-box login friction.
#   persist (opt-in, expected to be rare) — inject nothing, so Claude falls into its
#           normal /login on first launch. The credential it writes lands in the
#           per-project .claude mount, so it survives restarts and you log in once.
#
# Per-project by design, stored in STATE_DIR like the egress posture. A global switch
# would defeat the purpose: the point is that ONE long-lived box differs while every
# other project keeps using the token. STATE_DIR is never mounted, so a box cannot
# read or change its own auth mode.
if [ "${1:-}" = "login" ]; then
  _lslug="$(printf '%s' "$WORKSPACE" | sed 's#[^a-zA-Z0-9]#-#g; s#^-*##')"
  _ldir="$HOME/.config/claude-airlock/state/$_lslug"; mkdir -p "$_ldir"
  case "${2:-show}" in
    show)
      if [ "$(cat "$_ldir/persist-login" 2>/dev/null || echo 0)" = "1" ]; then
        echo "login mode for $(basename "$WORKSPACE"): persist"
        echo "  no token injected; the box runs its own /login and it persists"
        if [ -s "$_ldir/dot-claude/.credentials.json" ]; then
          echo "  credential: present (logged in)"
        else
          echo "  credential: NONE YET — run 'airlock' and complete /login once"
        fi
      else
        echo "login mode for $(basename "$WORKSPACE"): token (default)"
        echo "  the shared long-lived token is injected at launch"
      fi ;;
    token)
      rm -f "$_ldir/persist-login"
      echo "airlock: login for $(basename "$WORKSPACE") -> token (shared, injected)"
      # Deliberately does NOT delete the stored credential: switching back to the token
      # should not silently destroy a login you may want on the next switch. Say so, so
      # a leftover credential is never a surprise.
      [ -s "$_ldir/dot-claude/.credentials.json" ] && \
        echo "  note: a persisted credential remains at $_ldir/dot-claude/.credentials.json — remove it to fully revoke locally" ;;
    persist)
      printf '1\n' > "$_ldir/persist-login"
      echo "airlock: login for $(basename "$WORKSPACE") -> persist (box logs itself in)"
      echo "  next launch will prompt /login once; the credential then persists." ;;
    *) echo "usage: airlock login [show] | token | persist" >&2; exit 1 ;;
  esac
  exit 0
fi

# `airlock telemetry` reports this project's box telemetry, which is always OFF: a sandbox
# has no need to phone home. Managed settings (/etc/claude-code/managed-settings.json, applied
# after every settings file, mounted read-only from this install) keep it off against the
# box; the engine's -e flags and the box's asserted settings.json are fallbacks.
#
# There used to be an `on` switch, because Remote Control refused to run with telemetry off
# on Claude Code 2.1.154-2.1.282. From 2.1.283, steering a session started on this machine
# works with telemetry off. Still refused with it off: starting a session onto this machine
# from another device, and any Remote Control under Trusted Devices; neither is supported
# here. The switch is retired: a launch clears a leftover `telemetry-on` marker and says so,
# so no project keeps telemetry on without anyone knowing.
# Error reporting (crash/stack data) is always off too.
if [ "${1:-}" = "telemetry" ]; then
  case "${2:-show}" in
    show)
      echo "telemetry for $(basename "$WORKSPACE"): off (always; error reporting off too)"
      _tslug3="$(printf '%s' "$WORKSPACE" | sed 's#[^a-zA-Z0-9]#-#g; s#^-*##')"
      if [ -f "$HOME/.config/claude-airlock/state/$_tslug3/telemetry-on" ]; then
        echo "  a leftover marker from the retired 'on' switch is cleared at the next launch"
      fi ;;
    off)
      echo "telemetry for $(basename "$WORKSPACE"): already off (always)" ;;
    on)
      echo "airlock: telemetry stays off. Remote Control works without it on Claude Code 2.1.283+;" >&2
      echo "  the 'on' switch was retired (only uses airlock does not support need it: starting a" >&2
      echo "  session here from another device, or Trusted Devices)." >&2
      exit 1 ;;
    *) echo "usage: airlock telemetry [show]" >&2; exit 1 ;;
  esac
  exit 0
fi

# `airlock mode [show|<mode>|reset]` sets the permission mode this project's box STARTS
# in, passed through as `claude --permission-mode`. Modes: acceptEdits, auto,
# bypassPermissions, manual, dontAsk, plan.
#
# Per-project and stored in STATE_DIR, like the egress posture and login mode — a
# long-running orchestrator wants to start in `auto` without every disposable box
# inheriting that. `reset` drops the setting so Claude uses its own default.
#
# Note this sets the STARTING mode only; shift-tab still switches modes in-session. And
# it is a HOST setting by design: a box that could raise its own permission mode would
# be choosing how much it gets asked, which is the operator's call, not the agent's.
if [ "${1:-}" = "mode" ]; then
  _mslug="$(printf '%s' "$WORKSPACE" | sed 's#[^a-zA-Z0-9]#-#g; s#^-*##')"
  _mdir="$HOME/.config/claude-airlock/state/$_mslug"; mkdir -p "$_mdir"
  case "${2:-show}" in
    show)
      # No apostrophe in the :- default. Inside ${var:-word} a single quote opens a quote
      # context even within double quotes, so "Claude's" here is a parse error, not a string.
      _mnow="$(cat "$_mdir/permission-mode" 2>/dev/null || true)"
      echo "permission mode for $(basename "$WORKSPACE"): ${_mnow:-<unset - Claude default>}"
      echo "  available: $AIRLOCK_PERMISSION_MODES" ;;
    reset)
      rm -f "$_mdir/permission-mode"
      echo "airlock: permission mode for $(basename "$WORKSPACE") -> unset (Claude's default)" ;;
    *)
      case " $AIRLOCK_PERMISSION_MODES " in
        *" $2 "*) printf '%s\n' "$2" > "$_mdir/permission-mode"
                  echo "airlock: permission mode for $(basename "$WORKSPACE") -> $2" ;;
        *) echo "airlock: unknown permission mode '$2' (valid: $AIRLOCK_PERMISSION_MODES)" >&2; exit 1 ;;
      esac ;;
  esac
  exit 0
fi

# `airlock tmp` prints (and creates) this project's persistent scratch dir. Both the
# box and the host `claude` wrapper export it as $AIRLOCK_TMP, so neither side has to
# compute the slug — this is the single source of truth for the path.
if [ "${1:-}" = "tmp" ]; then
  _tslug="$(printf '%s' "$WORKSPACE" | sed 's#[^a-zA-Z0-9]#-#g; s#^-*##')"
  _tdir="$AIRLOCK_TMP_BASE/$_tslug"
  _airlock_tmp_base_ready "$AIRLOCK_TMP_BASE" || exit 1
  mkdir -p "$_tdir" && chmod 700 "$_tdir"
  printf '%s\n' "$_tdir"
  exit 0
fi

# `airlock paste` saves the host clipboard IMAGE into a project's scratch dir as a
# timestamped PNG and prints the path.
#
# The box has no clipboard and cannot be given one safely. Claude Code's paste path shells
# out to xclip/wl-paste, and no clipboard reaches a container without mounting the host
# X11/Wayland socket — which would hand the box a continuous read of everything you copy
# (passwords included) and, on X11, a way to inject input into other apps. So the image
# crosses as a FILE, at a path both sides already agree on, and you paste the path. The
# agent opens the file; nothing reads your clipboard but you.
#
# The target project is REQUIRED and comes from AIRLOCK_PASTE_PROJECT (host config), not
# from $PWD: you type this in whatever terminal is free while the agent holds the other
# one, and a $PWD default would silently write pastes into a directory that box never
# mounts. With AIRLOCK_PASTE_DIR set, pastes go there instead, for every project: a drop
# box every box mounts read-only (see the launcher).
if [ "${1:-}" = "paste" ]; then
  shift
  _pcopy=0 _plist=0 _pn=10 _pproj="${AIRLOCK_PASTE_PROJECT:-}"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --copy)    _pcopy=1 ;;
      --project) _pproj="${2:?usage: airlock paste --project DIR}"; shift ;;
      list)      _plist=1; case "${2:-}" in ''|*[!0-9]*) ;; *) _pn="$2"; shift ;; esac ;;
      *) echo "usage: airlock paste [--copy] [--project DIR]  |  airlock paste list [N]" >&2; exit 1 ;;
    esac
    shift
  done

  if [ -n "${AIRLOCK_PASTE_DIR:-}" ]; then
    if [ "$_pproj" != "${AIRLOCK_PASTE_PROJECT:-}" ]; then
      echo "claude-airlock: AIRLOCK_PASTE_DIR is set, so pastes go there for every project; --project does not apply." >&2
      exit 1
    fi
    _pdir="$(_airlock_paste_dir_check "$AIRLOCK_PASTE_DIR" 2>&1)" \
      || { echo "claude-airlock: AIRLOCK_PASTE_DIR: $_pdir" >&2; exit 1; }
    if [ "$_plist" = 0 ] && [ ! -w "$_pdir" ]; then
      echo "claude-airlock: $_pdir is not writable by you: its owner pastes there, and your boxes" >&2
      echo "  read it. Nothing to do here." >&2
      exit 1
    fi
  elif [ -z "$_pproj" ]; then
    echo "claude-airlock: AIRLOCK_PASTE_PROJECT is not set." >&2
    echo "  Pastes go to ONE project's scratch dir; there is no sensible default." >&2
    echo "  Set it in $CONFIG_FILE, e.g.:" >&2
    echo "      AIRLOCK_PASTE_PROJECT=\"\$HOME/development/myproject\"" >&2
    echo "  or override for one call:  airlock paste --project /path/to/project" >&2
    exit 1
  fi
  if [ -z "${AIRLOCK_PASTE_DIR:-}" ]; then
    case "$_pproj" in
      /*) ;;
      *)  echo "claude-airlock: the paste project must be an ABSOLUTE path (got '$_pproj')." >&2
          echo "  A relative path resolves against whatever directory you happen to be in," >&2
          echo "  which is the \$PWD dependence this setting exists to avoid." >&2
          exit 1 ;;
    esac
    [ -d "$_pproj" ] || { echo "claude-airlock: paste project not found: $_pproj" >&2; exit 1; }

    # Same slug the launcher and `airlock tmp` use — this stays the single source of truth.
    _pslug="$(printf '%s' "$(cd "$_pproj" && pwd)" | sed 's#[^a-zA-Z0-9]#-#g; s#^-*##')"
    _pdir="$AIRLOCK_TMP_BASE/$_pslug/pastes"
    _airlock_tmp_base_ready "$AIRLOCK_TMP_BASE" || exit 1
    # Both are inside the project's scratch dir, which its box mounts read-write: the box
    # decides what `pastes` is. Never `mkdir -p` through it (that follows a link to anywhere
    # this user can write); create each level only if absent and check what is there.
    mkdir -m 0700 "$AIRLOCK_TMP_BASE/$_pslug" 2>/dev/null || true
    if [ -L "$AIRLOCK_TMP_BASE/$_pslug" ] || [ ! -d "$AIRLOCK_TMP_BASE/$_pslug" ] \
       || [ "$(stat -c %u "$AIRLOCK_TMP_BASE/$_pslug")" != "$(id -u)" ]; then
      echo "claude-airlock: the scratch dir $AIRLOCK_TMP_BASE/$_pslug is not a folder of yours; not pasting" >&2
      exit 1
    fi
    chmod 700 "$AIRLOCK_TMP_BASE/$_pslug"
    mkdir -m 0700 "$_pdir" 2>/dev/null || true
    if [ -L "$_pdir" ] || [ ! -d "$_pdir" ]; then
      _airlock_planted "$_pdir" "$(_airlock_kind "$_pdir")" "a folder"; exit 1
    fi
    _pexpect="$(cd -P -- "$AIRLOCK_TMP_BASE" && pwd -P)/$_pslug/pastes"
  else
    _pexpect="$_pdir"   # canonical already (_airlock_paste_dir_check)
  fi
  # Work INSIDE the checked folder from here on, by relative names only: the box can swap
  # the name `pastes` for a link at any moment (the clipboard read and the conversion sit in
  # that window), but this shell's working directory stays the folder that was checked. Its
  # real path (and in the project mode its owner) are checked once more after entering it.
  # A drop box is its writer's by design, and a reader lists it; no box can write it, and
  # _airlock_paste_dir_check has pinned it, so there the path alone is compared.
  if ! { cd -P -- "$_pdir" 2>/dev/null && [ "$(pwd -P)" = "$_pexpect" ] \
         && { [ -n "${AIRLOCK_PASTE_DIR:-}" ] || [ "$(stat -c %u .)" = "$(id -u)" ]; }; }; then
    echo "claude-airlock: $_pdir changed while it was being checked (was this planted?); not pasting" >&2
    exit 1
  fi
  _pdisp="$_pexpect"

  # Collect only files this tool created: `YYYYMMDD-HHMMSSmmm.png`, one fixed shape, so
  # the shell's lexical glob order IS chronological order (no `ls -t`/SC2012, no GNU-only
  # `find -printf`). Anything else in the directory - a hand-copied screenshot, a stray
  # download - is ignored rather than listed out of order, and is NEVER pruned: deleting
  # a file we did not write would be the worst kind of surprise.
  _collect_pastes() {
    _pfiles=()
    local f b
    for f in ./*.png; do
      [ -e "$f" ] || continue
      b="${f##*/}"
      case "$b" in
        [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9].png)
          _pfiles+=("$b") ;;
      esac
    done
  }

  if [ "$_plist" = 1 ]; then
    _collect_pastes
    [ "${#_pfiles[@]}" -gt 0 ] || exit 0
    _pcount=${#_pfiles[@]}
    _pstart=$(( _pcount > _pn ? _pcount - _pn : 0 ))
    for (( _pj=_pcount-1; _pj>=_pstart; _pj-- )); do printf '%s\n' "$_pdisp/${_pfiles[_pj]}"; done
    exit 0
  fi

  # Clipboard backend by SESSION, not by which binary happens to exist: under XWayland
  # both can be installed and the native one is the correct reader.
  _pclip=""
  if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-paste >/dev/null 2>&1; then
    _pclip=wayland
  elif [ -n "${DISPLAY:-}" ] && command -v xclip >/dev/null 2>&1; then
    _pclip=x11
  elif [ -n "${WAYLAND_DISPLAY:-}" ]; then
    echo "claude-airlock: Wayland session but wl-paste is missing (install wl-clipboard)." >&2; exit 1
  elif [ -n "${DISPLAY:-}" ]; then
    echo "claude-airlock: X11 session but xclip is missing (install xclip)." >&2; exit 1
  else
    echo "claude-airlock: no graphical session (\$WAYLAND_DISPLAY and \$DISPLAY are both unset)." >&2
    echo "  There is no clipboard to read here. Copy the image into" >&2
    echo "  $_pdir/ and give the agent that path directly." >&2
    exit 1
  fi

  _paste_types() {
    case "$_pclip" in
      wayland) wl-paste --list-types 2>/dev/null ;;
      x11)     xclip -selection clipboard -t TARGETS -o 2>/dev/null ;;
    esac
  }
  _paste_read() {
    case "$_pclip" in
      wayland) wl-paste --type "$1" 2>/dev/null ;;
      x11)     xclip -selection clipboard -t "$1" -o 2>/dev/null ;;
    esac
  }

  # Work file has no .png suffix, so the *.png glob (list, retention) cannot see a
  # half-written paste. The finished image is moved into place at the very end.
  _ptmp="$(mktemp "${TMPDIR:-/tmp}/airlock-paste.XXXXXX")" || exit 1
  _pwork=""
  trap 'rm -f -- "$_ptmp" ${_pwork:+"$_pwork"}' EXIT INT TERM HUP
  # The work file is never a name in the box-writable pastes dir: the box could plant a link
  # at a guessable name there and have the converter write through it (pentest O22). In the
  # project mode it goes in the private scratch base (same filesystem, not mounted into any
  # box) and is renamed in; a drop box (AIRLOCK_PASTE_DIR) no box can write, so mktemp there.
  # (So the project mode needs the scratch base writable, which the default base always is.)
  if [ -n "${AIRLOCK_PASTE_DIR:-}" ]; then
    _pwork="$(mktemp --suffix=.work "$PWD/.paste.XXXXXX")" || exit 1
  else
    _pwork="$(mktemp --suffix=.work "$AIRLOCK_TMP_BASE/.paste.XXXXXX")" || exit 1
  fi

  # `|| true` is load-bearing under `set -e`: an assignment takes the substitution's
  # exit status, so a failing wl-paste/xclip would kill the script HERE, silently,
  # and the "no image on the clipboard" message below could never print. An empty
  # or failing clipboard is the single most common way this command is used wrong.
  _ptypes="$(_paste_types || true)"
  _pread=0
  case "$_ptypes" in
    *image/png*) _paste_read image/png > "$_ptmp" || _pread=$? ;;
    *image/bmp*) _paste_read image/bmp > "$_ptmp" || _pread=$? ;;
    *image/*)    _paste_read "$(printf '%s\n' "$_ptypes" | grep -m1 '^image/')" > "$_ptmp" || _pread=$? ;;
    *) echo "claude-airlock: no image on the clipboard (offered: ${_ptypes:-nothing})" >&2; exit 1 ;;
  esac
  [ "$_pread" -eq 0 ] || { echo "claude-airlock: reading the clipboard failed (exit $_pread)." >&2; exit 1; }
  [ -s "$_ptmp" ] || { echo "claude-airlock: the clipboard read produced no data." >&2; exit 1; }

  # Milliseconds, and every name the same shape, so the lexical glob order used by
  # `list` and by retention really is chronological. A collision suffix would break
  # that: '-' (0x2D) sorts BEFORE '.' (0x2E), so `...-2.png` precedes `....png` and
  # two pastes in one second would be listed backwards.
  _pout=""
  for _pi in 1 2 3 4 5; do
    _pcand="$(date +%Y%m%d-%H%M%S%3N).png"
    if [ ! -e "$_pcand" ]; then _pout="$_pcand"; break; fi
  done
  [ -n "$_pout" ] || { echo "claude-airlock: could not find a free filename in $_pdir." >&2; exit 1; }

  # Any failure past this point removes BOTH work file and output: a missing paste
  # must mean "the grab failed", never "you are looking at an older one".
  _pfail() { rm -f "$_pwork" "$_pout"; echo "claude-airlock: $*" >&2; exit 1; }

  # The Claude API accepts PNG/JPEG/GIF/WebP - BMP has to be converted or it is unreadable.
  if [ "$(head -c 4 "$_ptmp" | od -An -tx1 | tr -d ' \n')" = "89504e47" ]; then
    cp "$_ptmp" "$_pwork" || _pfail "could not write to $_pdir"
  elif command -v magick >/dev/null 2>&1; then
    magick "$_ptmp" png:"$_pwork" || _pfail "magick could not convert the clipboard image"
  elif command -v convert >/dev/null 2>&1; then
    convert "$_ptmp" png:"$_pwork" || _pfail "convert could not convert the clipboard image"
  elif command -v ffmpeg >/dev/null 2>&1; then
    ffmpeg -y -loglevel error -i "$_ptmp" "$_pwork" || _pfail "ffmpeg could not convert the clipboard image"
  elif python3 -c 'import PIL' 2>/dev/null; then
    python3 -c 'import sys
from PIL import Image
Image.open(sys.argv[1]).save(sys.argv[2], "PNG")' "$_ptmp" "$_pwork" || _pfail "Pillow could not convert the clipboard image"
  else
    _pfail "the clipboard offered [$(printf '%s' "$_ptypes" | tr '\n' ' ')] and no PNG converter is installed (python3-pil, imagemagick or ffmpeg)"
  fi

  # Check what was PRODUCED, not merely that something was. A converter that exits 0
  # having written garbage is the failure that matters, and size alone cannot see it.
  [ -s "$_pwork" ] || _pfail "conversion produced an empty file"
  [ "$(head -c 4 "$_pwork" | od -An -tx1 | tr -d ' \n')" = "89504e47" ] \
    || _pfail "conversion produced a file that is not a PNG"

  # A drop box is read by another account (through the directory's group): mktemp's 0600
  # would keep it out.
  [ -z "${AIRLOCK_PASTE_DIR:-}" ] || chmod 0640 "$_pwork" || _pfail "could not make the paste group-readable"
  # Atomic publish: same filesystem, so nothing ever observes a partial *.png.
  mv -fT -- "$_pwork" "./$_pout" || _pfail "could not move the image into $_pdir"

  # Retain the newest 20. EXCLUDES the file just written - it is not always the
  # lexically-last entry (a clock moved backwards, or hand-copied files whose names
  # sort after any timestamp), and pruning it would delete the paste we just printed.
  _collect_pastes
  _pkeep=()
  for _pf in "${_pfiles[@]}"; do
    [ "$_pf" = "$_pout" ] || _pkeep+=("$_pf")
  done
  if [ "${#_pkeep[@]}" -gt 19 ]; then
    rm -f -- "${_pkeep[@]:0:$(( ${#_pkeep[@]} - 19 ))}"
  fi

  # Redirect the clipboard writer's stdout: xclip -i and wl-copy fork a selection
  # owner that INHERITS stdout and lives until the clipboard changes, which hangs
  # `out=$(airlock paste --copy)` indefinitely.
  if [ "$_pcopy" = 1 ]; then
    case "$_pclip" in
      wayland) command -v wl-copy >/dev/null 2>&1 && printf '%s' "$_pdisp/$_pout" | wl-copy >/dev/null 2>&1 \
                 || echo "claude-airlock: --copy needs wl-copy (wl-clipboard); path printed only." >&2 ;;
      x11)     printf '%s' "$_pdisp/$_pout" | xclip -selection clipboard -i >/dev/null 2>&1 \
                 || echo "claude-airlock: --copy failed; path printed only." >&2 ;;
    esac
  fi

  printf '%s\n' "$_pdisp/$_pout"
  exit 0
fi

# `airlock doctor` verifies this host can actually run the sandbox: engine present,
# rootless prerequisites (subuid/subgid, resident netfilter modules — a user namespace
# cannot autoload them), and a LIVE containment test in a throwaway box. Runs before the
# auth-token check on purpose: you must be able to diagnose a broken host without a token.
if [ "${1:-}" = "doctor" ]; then
  _dself="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
  _ddoctor="$(dirname "$(dirname "$_dself")")/scripts/airlock-doctor.sh"
  if [ ! -x "$_ddoctor" ]; then
    echo "claude-airlock: doctor script not found at $_ddoctor" >&2; exit 1
  fi
  # The network keys as they were BEFORE the config: the doctor applies the config itself.
  AIRLOCK_ENGINE="$AIRLOCK_ENGINE" AIRLOCK_IMAGE="$AIRLOCK_IMAGE" \
    AIRLOCK_PODMAN_NETWORK="$_AIRLOCK_PODMAN_NETWORK_ENV" AIRLOCK_DNS="$_AIRLOCK_DNS_ENV" \
    exec "$_ddoctor"
fi

# --- Per-project config: <project>/.airlock/config -------------------------
# SAFE-PARSED, never sourced. The project dir is untrusted and this runs on the
# HOST before the sandbox exists, so sourcing it would be host code execution.
# Only known keys with validated values are honored; push tokens are NOT read
# from here (a project must not reference your host secrets).
PROJ_CFG="$WORKSPACE/.airlock/config"
# Globbing is OFF while these values are split. The lists below are expanded unquoted
# on purpose (space-separated entries), and an unquoted expansion also globs - against
# the workspace, since that is the cwd. So `artifact_dirs = *` used to become one
# shadow mount per top-level entry of the project, and `share = *` one approval prompt
# per name that happened to exist under AIRLOCK_SHARE_BASE too: a box choosing, from a
# file it can write, what the NEXT launch mounts and what the operator is asked. Entry
# names are also restricted to portable path characters, so a literal `*` that survives
# the split can never become a directory name either.
if [ -f "$PROJ_CFG" ]; then
  set -f
  while IFS= read -r _line || [ -n "$_line" ]; do
    _line="${_line%%#*}"
    case "$_line" in *=*) ;; *) continue ;; esac
    _key="$(printf '%s' "${_line%%=*}" | tr -d '[:space:]')"
    _val="$(printf '%s' "${_line#*=}" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    case "$_key" in
      artifact_dirs)                                  # extra container-local dirs
        for _d in $_val; do
          case "$_d" in
            ''|/*|*..*) continue ;;                   # relative paths only
            *[!A-Za-z0-9._/-]*)                       # a glob or shell character is never a dir name here
              echo "claude-airlock: .airlock/config: ignoring artifact_dirs entry '$_d' (letters, digits, . _ / - only)" >&2
              continue ;;
          esac
          case " $AIRLOCK_ARTIFACT_DIRS " in *" $_d "*) ;; *) AIRLOCK_ARTIFACT_DIRS="$AIRLOCK_ARTIFACT_DIRS $_d" ;; esac
        done ;;
      egress)                                         # requested; gated by host approval below
        # Split on commas as well as whitespace: `egress = a.com, b.com` is the obvious
        # way to write a list, and a whitespace-only split leaves the comma inside the
        # token where validation then rejects it.
        for _dom in ${_val//,/ }; do
          [ -z "$_dom" ] && continue
          # Accept exactly the shapes init-firewall.sh can program: hostname, IPv4,
          # IPv4:port (for datasources on non-443 ports), or an IPv6 literal. The old
          # check was a character class that excluded ':', so every IP:port grant was
          # dropped by a bare `continue` — no message, and the entry simply never
          # existed. A grant that cannot apply is now fatal rather than invisible:
          # a box that looks configured and silently has no access is the worse outcome.
          if ! [[ "$_dom" =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)*$ ]] \
             && ! [[ "$_dom" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}(:[0-9]{1,5})?$ ]] \
             && ! { [[ "$_dom" == *:* ]] && [[ "$_dom" =~ ^[0-9a-fA-F:]+$ ]]; }; then
            echo "claude-airlock: .airlock/config: 'egress = $_dom' is not a valid" >&2
            echo "  hostname, IPv4, IPv4:port, or IPv6 literal. Fix the entry — it can never be" >&2
            echo "  granted, and starting without it would leave this box looking configured" >&2
            echo "  while silently having no access to it." >&2
            exit 1
          fi
          # Refused before any approval lookup, so a grant approved before this check
          # existed is caught too, and never prompted: see _airlock_is_host_address.
          if _airlock_is_host_address "$_dom"; then
            echo "claude-airlock: .airlock/config: 'egress = $_dom' points at THIS HOST (or the" >&2
            echo "  engine's mapping of it). A project file cannot grant the sandbox its own host;" >&2
            echo "  a compromised session would ask for exactly this. Remove the entry. If you" >&2
            echo "  really mean it, AIRLOCK_EXTRA_EGRESS in $CONFIG_FILE is host-trusted." >&2
            exit 1
          fi
          _REQ_EGRESS="${_REQ_EGRESS:+$_REQ_EGRESS }$_dom"
        done ;;
      share)                                          # requested READ-ONLY folders (rel to base); gated below
        for _s in $_val; do
          case "$_s" in
            ''|/*|*..*) continue ;;                   # relative paths only, no escapes
            *[!A-Za-z0-9._/-]*)
              echo "claude-airlock: .airlock/config: ignoring share entry '$_s' (letters, digits, . _ / - only)" >&2
              continue ;;
          esac
          _REQ_SHARE="${_REQ_SHARE:+$_REQ_SHARE }$_s"
        done ;;
      share_rw)                                       # requested READ-WRITE folders (rel to base); gated below
        for _s in $_val; do
          case "$_s" in
            ''|/*|*..*) continue ;;                   # relative paths only, no escapes
            *[!A-Za-z0-9._/-]*)
              echo "claude-airlock: .airlock/config: ignoring share_rw entry '$_s' (letters, digits, . _ / - only)" >&2
              continue ;;
          esac
          _REQ_SHARE_RW="${_REQ_SHARE_RW:+$_REQ_SHARE_RW }$_s"
        done ;;
      image)                                          # must be a claude-airlock:* tag
        case "$_val" in
          claude-airlock:*) case "$_val" in *[!a-zA-Z0-9._:-]*) : ;; *) AIRLOCK_IMAGE="$_val" ;; esac ;;
        esac ;;
      *) : ;;                                         # ignore unknown keys
    esac
  done < "$PROJ_CFG"
  set +f
fi

# --- Per-project state store (isolated: config, settings, other projects) ---
slug="$(printf '%s' "$WORKSPACE" | sed 's#[^a-zA-Z0-9]#-#g; s#^-*##')"
STATE_DIR="$HOME/.config/claude-airlock/state/$slug"
mkdir -p "$STATE_DIR/dot-claude"

# _airlock_proc_start and _airlock_peers_in are defined above the subcommand dispatch,
# because the host `claude` wrapper reaches them through `airlock session`.
SELF_START="$(_airlock_proc_start "$$")"

# --- Auth: shared long-lived OAuth token (CLAUDE_CODE_OAUTH_TOKEN) ---
#
# The shared token is a CONVENIENCE for ephemeral boxes, not a security tier. Boxes
# come and go, and logging in to each one by hand would be unusable friction, so the
# host injects one long-lived token and every box borrows it. Default everywhere.
#
# `airlock login persist` drops that convenience for ONE project whose box is
# LONG-LIVED and SINGULAR (a persistent orchestrator session). A one-time /login
# costs nothing when amortised over a session measured in days, and it yields a
# credential Claude renews itself — which is what Remote Control needs.
#
# Mechanically this is just an omission: we skip injecting the token, so Claude
# finds no credential in the env and runs its own device-flow login. It writes the
# result under $HOME/.claude — ALREADY the persistent per-project bind mount
# ($STATE_DIR/dot-claude, above), so the login survives restarts with no extra
# mount. Requires egress to claude.ai + console.anthropic.com (both core-allowed).
#
# The mode is PER-PROJECT and lives in STATE_DIR, exactly like the egress posture:
# a global switch would be wrong here, since the whole point is that one box differs
# from the rest. AIRLOCK_PERSIST_LOGIN=1 still works as a one-off override for a
# single launch; the stored mode is what makes it stick across restarts.
#
# NOT a security downgrade, despite first appearances. Both are bearer credentials
# for the same account, obtained through the same OAuth flow. If anything the shared
# token has the wider blast radius — it is injected into EVERY box, so one bad box
# exposes a credential that works for all of them, whereas a persisted login exists
# in exactly one. Either way STATE_DIR is never mounted, so a box can neither read
# nor change its own auth mode.
PERSIST_LOGIN="$(cat "$STATE_DIR/persist-login" 2>/dev/null || echo "$AIRLOCK_PERSIST_LOGIN")"
if [ "$PERSIST_LOGIN" = "1" ]; then
  OAUTH_TOKEN=""
else
  TOKEN_FILE="${AIRLOCK_TOKEN_FILE:-$HOME/.config/claude-airlock/token}"
  OAUTH_TOKEN="${CLAUDE_CODE_OAUTH_TOKEN:-}"
  [ -z "$OAUTH_TOKEN" ] && [ -f "$TOKEN_FILE" ] && OAUTH_TOKEN="$(tr -d '[:space:]' < "$TOKEN_FILE")"
  if [ -z "$OAUTH_TOKEN" ]; then
    echo "claude-airlock: no auth token found." >&2
    echo "  Generate a long-lived (~1 year) token once, on the host:" >&2
    echo "      command claude setup-token" >&2
    echo "  Then save the printed sk-ant-oat... value:" >&2
    echo "      mkdir -p \"$(dirname "$TOKEN_FILE")\"" >&2
    echo "      printf %s 'PASTE_TOKEN_HERE' > \"$TOKEN_FILE\" && chmod 600 \"$TOKEN_FILE\"" >&2
    echo "  Or, for a single long-lived box that logs itself in: airlock login persist" >&2
    exit 1
  fi
fi

# Sensitive env (the OAuth token + any injected secrets) goes in a mode-0600 --env-file,
# NOT on the engine command line. `-e KEY=VALUE` is visible in the host process table
# (/proc/<pid>/cmdline, `ps auxe`) for the container's whole lifetime, and can be readable
# by other users depending on /proc's hidepid — so `podman run -e SECRET=...` discloses
# exactly what the per-project secret store went to lengths to keep private. The file
# lives in STATE_DIR (never mounted into the box), is created 0600 before a byte is
# written, and is removed on exit. Non-sensitive env stays on `-e` (below).
# Per SESSION, not per project: two boxes on one project would otherwise share this
# path, and the cleanup's unconditional `rm -f` would delete a sibling's token file out
# from under it. The window is wide - a session writes this here but the engine does not
# read it until ~450 lines later, with two blocking interactive prompts in between - and
# the failure is a launch that dies for no visible reason.
# Named <pid>.<starttime>, NOT bare <pid>: this file holds an OAuth token, and a session
# killed with SIGKILL leaves one behind. Sweeping on bare pid existence would keep a
# stale token forever the moment its pid was recycled - strictly worse than the old
# fixed path, which the next launch truncated unconditionally.
ENV_FILE="$STATE_DIR/engine-env.$$.$SELF_START"
(umask 077; : > "$ENV_FILE")
# Sweep env-files whose owning process is gone. Three shapes, three rules - the point is
# never to delete a file a LIVE session is about to hand to the engine, because that
# session then dies reading a missing --env-file.
for _ef in "$STATE_DIR"/engine-env "$STATE_DIR"/engine-env.*; do
  [ -e "$_ef" ] || continue
  [ "$_ef" = "$ENV_FILE" ] && continue
  _eftag="${_ef##*/engine-env}"; _eftag="${_eftag#.}"
  case "$_eftag" in
    # <pid>.<starttime>: ours. Gone or recycled unless the start time still matches.
    *.*) _efpid="${_eftag%%.*}"
         [ "$(_airlock_proc_start "$_efpid")" = "${_eftag#*.}" ] || rm -f "$_ef" ;;
    # <pid>: written by the previous version. Its owner may still be running - "upgrade
    # airlock, then open a second box" hits exactly that - so only sweep once the pid is
    # gone. Residual (legacy file AND recycled pid) is far narrower than deleting live.
    [0-9]*) [ -n "$(_airlock_proc_start "$_eftag")" ] || rm -f "$_ef" ;;
    # bare `engine-env`: no pid at all, so ownership can never be established, and it may
    # hold a token. It goes.
    *)   rm -f "$_ef" ;;
  esac
done
unset _ef _eftag _efpid
# The box's launcher-written config (its ~/.gitconfig, its gh config), per session: what a
# launch writes depends on the posture, so a shared file rewritten by the next launch would
# change a running box's git (a dev box would gain the proxy's http:// rewrites and send in
# the clear). Swept like the env-files once their session is gone.
BOX_CFG="$STATE_DIR/box-config.$$.$SELF_START"
for _bc in "$STATE_DIR"/box-config.*; do
  [ -d "$_bc" ] || continue
  [ "$_bc" = "$BOX_CFG" ] && continue
  _bctag="${_bc##*/box-config.}"
  [ "$(_airlock_proc_start "${_bctag%%.*}")" = "${_bctag#*.}" ] || rm -rf "$_bc"
done
unset _bc _bctag
rm -f "$STATE_DIR/gitconfig"   # the shared file of earlier versions
# Empty under persist-login — the var must be ABSENT, not empty-string: Claude
# treats a set-but-empty token as a credential and fails auth instead of falling
# through to its own /login.
if [ -n "$OAUTH_TOKEN" ]; then
  printf 'CLAUDE_CODE_OAUTH_TOKEN=%s\n' "$OAUTH_TOKEN" >> "$ENV_FILE"
fi

# Per-project persistent scratch. The box's own /tmp dies with the container (--rm),
# which silently loses derived artifacts (a dedup index, a cache) between sessions.
# Give each project a host dir bind-mounted at the SAME path, so host and box name the
# file identically (the real-path invariant used for the workspace and shares).
# ONLY this project's dir is mounted — never the base, never bare /tmp — so nothing
# leaks between projects. It lives on the host's tmpfs: survives session exit, cleared
# on reboot. An inter-session cache, not durable storage; bare /tmp stays ephemeral so
# build/test temp files don't eat host RAM.
AIRLOCK_TMP="$AIRLOCK_TMP_BASE/$slug"
_airlock_tmp_base_ready "$AIRLOCK_TMP_BASE" || exit 1
# Deliberately NOT `mkdir -p ... && chmod 700 ...`: under `set -e` only the LAST command
# of an && list is fatal, so a failing mkdir there was silent and left the box with a
# bind source that never got its 0700.
if ! mkdir -p "$AIRLOCK_TMP" 2>/dev/null; then
  echo "claude-airlock: cannot create the per-project scratch dir $AIRLOCK_TMP" >&2
  echo "  Check ownership of $AIRLOCK_TMP_BASE, or point AIRLOCK_TMP_BASE elsewhere" >&2
  echo "  (env only - it must match on host and box, so the config file cannot set it)." >&2
  exit 1
fi
chmod 700 "$AIRLOCK_TMP"
# Again now that the project dir is in it: the base must still be ours alone, and the project
# dir ours (a base swapped in between would have made it someone else's child).
_airlock_tmp_base_ready "$AIRLOCK_TMP_BASE" || exit 1
if [ -L "$AIRLOCK_TMP" ] || [ "$(stat -c %u "$AIRLOCK_TMP")" != "$(id -u)" ]; then
  echo "claude-airlock: the scratch dir $AIRLOCK_TMP is not yours; not launching" >&2; exit 1
fi

# --- Shared-mount refcount: who else has this project's dirs mounted right now? ---
# $AIRLOCK_TMP and the shadowed artifact dirs are each ONE host directory bind-mounted
# into every box on this project, and removing one at exit attacks any sibling that
# still holds it: a removed mount SOURCE strands that box on an orphaned inode (Links:0,
# reads empty, writes ENOENT, indistinguishable from "the cache is empty"), and a
# removed mount TARGET is torn down outright by detach_mounts().
# So every session registers a pidfile and only the LAST one out removes anything.
# Registered here, immediately after the mkdir above, rather than later: between the two
# sit blocking interactive prompts, and a peer exiting in that window would rmdir the
# directory this session just created and chmod'd.
# Registered for `shell` sessions too, unlike session.lock below: this counts who holds
# the MOUNTS, not who writes history, and a `shell` exit orphans a `claude` box just as
# effectively.
SESS_DIR="$STATE_DIR/sessions"
mkdir -p "$SESS_DIR"
SESS_FILE="$SESS_DIR/$$"
if [ "$AIRLOCK_SHELL" = 1 ]; then _selfkind=shell; else _selfkind=airlock; fi
printf '%s %s\n' "$SELF_START" "$_selfkind" > "$SESS_FILE"

# One implementation, shared with the host wrapper via `airlock session` - see the
# primitives above the subcommand dispatch.
_airlock_peer_sessions() { _airlock_peers_in "$SESS_DIR" "$$"; }

# The lock path is needed by the cleanup below; the lock itself is taken much later,
# after the prompts, and LOCK_HELD stays 0 until then so an early exit never removes a
# lock this session does not own. MOUNTED stays 0 until the engine actually runs.
LOCK="$STATE_DIR/session.lock"
LOCK_HELD=0
MOUNTED=0
STORE_OWNED=()   # artifact stores this session holds read-write; released on exit


# Cleanup runs from here on. Installed immediately after registration rather than after
# the prompts: the egress-approval and concurrent-session reads sit between, and
# answering N to "Open another anyway?" used to exit leaving this session's pidfile and
# its token-bearing env-file behind.
_airlock_cleanup() {
  # Deaf while cleaning. A second signal arriving mid-cleanup used to re-enter here, hit
  # the idempotence flag, return immediately, and then `exit` - aborting the in-flight
  # pass so its tail never ran. The window is ~1ms of syscalls and the worst loss is the
  # token-bearing env-file, but it is a real truncation.
  trap '' INT TERM HUP QUIT PIPE
  # The handlers below exit, which fires the EXIT trap and re-enters this function.
  # Everything here must be safe to repeat, and the ownership releases are not: by the
  # second pass a file can already belong to a different session.
  [ "${CLEANUP_DONE:-0}" = 1 ] && return 0
  CLEANUP_DONE=1
  # Only if the lock is still OURS. A second session overwrites it with its own pid after
  # the user answers y - the normal path when two boxes on one project is the design - and
  # the first to exit would otherwise delete the live session's lock, leaving a third
  # session with no concurrent-session warning at all.
  if [ "$LOCK_HELD" = 1 ] && [ -f "$LOCK" ]; then
    local _lpid
    read -r _lpid _ < "$LOCK" 2>/dev/null || true
    if [ "${_lpid:-}" = "$$" ]; then rm -f "$LOCK"; fi
  fi
  rm -f "$ENV_FILE"                              # drop the resolved token/secrets file
  rm -rf "${BOX_CFG:-/nonexistent}"              # this box's git and gh config
  # Our own per-process temp files. Unique names mean a hard kill in the create->mv window
  # leaves one orphan PER PID forever, where the old fixed path left one reusable file -
  # bounded litter became unbounded.
  # artifacts/ needs BOTH globs: a store is named after the dir it shadows, so `.venv`
  # yields a dot-prefixed .venv.owner.tmp.$$ that a bare `*` never matches, while
  # node_modules yields an ordinary name. Omitting the directory missed both.
  rm -f "$STATE_DIR"/*.tmp."$$" "$STATE_DIR"/dot-claude/*.tmp."$$" \
        "$STATE_DIR"/artifacts/*.tmp."$$" "$STATE_DIR"/artifacts/.*.tmp."$$" 2>/dev/null || true
  rm -rf "$STATE_DIR"/.write."$$".* 2>/dev/null || true   # private temp files (_airlock_private_tmp)
  # Release the artifact stores we hold read-write, so the next session can take them -
  # but only where the file still records US. "Ours by definition" is exactly the
  # assumption the lock release above refuses to make, and it is wrong for the same
  # reason: on a repeated cleanup pass the owner can already belong to another session,
  # and deleting it lets a third session take rw alongside them. That is the corruption
  # this ownership exists to prevent.
  local o _opid
  for o in "${STORE_OWNED[@]:-}"; do
    [ -n "$o" ] || continue
    [ -f "$o" ] || continue
    _opid=""
    read -r _opid _ < "$o" 2>/dev/null || true
    if [ "${_opid:-}" = "$$" ]; then rm -f "$o"; fi
  done
  # Deregister BEFORE counting peers, so the last session out doesn't see itself.
  rm -f "$SESS_FILE"
  # Nothing below is ours to remove unless we actually mounted these directories. A run
  # that exited at a prompt mounted nothing, and "no registered peers" is not "nobody
  # there" - a raw host `claude` shares the lock and the scratch dir but registers no
  # pidfile here.
  if [ "$MOUNTED" != 1 ]; then return 0; fi
  # Everything below removes a directory that a SIBLING box may still have mounted, so
  # none of it may run while another session is live. Removing a mount SOURCE strands
  # that box on an orphaned inode; removing a mount TARGET (the artifact dirs) is worse
  # still - vfs_rmdir calls detach_mounts() and tears the sibling's mount down outright.
  if _airlock_peer_sessions; then return 0; fi
  _airlock_release_artifacts "$STATE_DIR"
  # Drop the scratch dir only if the session left it empty (rmdir refuses otherwise),
  # so we don't litter /tmp with empties but never delete a kept artifact.
  rmdir "$AIRLOCK_TMP" 2>/dev/null || true
  # Never the base: a custom one is the user's, and the default stays so that no one else
  # can make it first (see _airlock_tmp_base_ready).
  rmdir "$SESS_DIR" 2>/dev/null || true
}
# A signal handler in bash runs and then the script CONTINUES. On the old
# `trap ... EXIT INT TERM` that was actively harmful: a SIGTERM at one of the prompts
# below ran cleanup early - which returns immediately, having mounted nothing - and the
# launch then carried on, created .venv, the markers and the owner file, and exited with
# the idempotence flag already set, so none of it was ever removed. The signal must END
# the run, not merely interrupt it. This also closes a pre-existing hazard on the same
# path: a signal at a prompt deleted ENV_FILE and SESS_FILE and then launched the box
# anyway, with a --env-file that no longer existed and no refcount registration.
#
# Trapping a signal bash would otherwise treat as fatal matters MID-RUN, not at exit. On
# the default disposition bash runs the EXIT trap immediately and re-raises, so a HUP
# while the engine is running removed the scratch dir with the container child still
# alive (measured: GONE 0.5s after the signal) - the removed-mount-source hazard this
# whole design exists to avoid. Trapped, the signal is deferred until the engine returns.
# QUIT (Ctrl-\) and PIPE take the same path and so get the same treatment.
#
# `|| true` decouples the status: under `set -e`, `_airlock_cleanup; exit 143` would exit
# with cleanup's status if it were ever non-zero, and the intended 128+signal would never
# be reached. Every path returns 0 today; this stops that from being load-bearing.
trap _airlock_cleanup EXIT
trap '_airlock_cleanup || true; exit 130' INT
trap '_airlock_cleanup || true; exit 143' TERM
trap '_airlock_cleanup || true; exit 129' HUP
trap '_airlock_cleanup || true; exit 131' QUIT
trap '_airlock_cleanup || true; exit 141' PIPE

# Per-project egress posture (host-controlled, tamper-proof — the mode file lives in
# STATE_DIR, never mounted into the box). Default 'minimal' = Anthropic core only;
# 'dev' opens the npm/PyPI/GitHub convenience groups (`airlock egress dev`). Global
# AIRLOCK_EGRESS_MODE can shift the default. The resolved groups are passed to the
# in-container firewall as AIRLOCK_EGRESS_GROUPS; the box can neither read the mode
# file nor set the env, so it can't widen its own egress.
EGRESS_MODE="$(cat "$STATE_DIR/egress-mode" 2>/dev/null || echo "${AIRLOCK_EGRESS_MODE:-minimal}")"
AIRLOCK_EGRESS_GROUPS="$(_resolve_egress_groups "$EGRESS_MODE")"

# Proxy posture: fail closed. A missing or refused socket stops the launch; falling back to
# a network would hand the box the very route this posture exists to remove, silently.
EGRESS_PROXY=""
_CLIENT_HOSTS=""   # its client manifest's plain-HTTP hosts (_airlock_client_manifest)
if ! _egress_posture_valid "$EGRESS_MODE"; then
  echo "claude-airlock: egress posture '$EGRESS_MODE' is not minimal, dev, proxy or a group list; not launching." >&2
  echo "  Fix AIRLOCK_EGRESS_MODE in $CONFIG_FILE, or set one: airlock egress minimal | dev | proxy SOCKET" >&2
  exit 1
fi
if _egress_is_proxy "$EGRESS_MODE"; then
  EGRESS_PROXY="$(_egress_proxy_socket "$EGRESS_MODE")"
  if [ -z "$EGRESS_PROXY" ]; then
    echo "claude-airlock: egress is 'proxy' but names no socket; not launching." >&2
    echo "  Run: airlock egress proxy SOCKET   (or set AIRLOCK_EGRESS_PROXY in $CONFIG_FILE)" >&2
    exit 1
  fi
  case "$EGRESS_PROXY" in
    *[[:space:]]*) echo "claude-airlock: egress proxy '$EGRESS_PROXY' contains whitespace; not launching." >&2; exit 1 ;;
  esac
  if ! _egc="$(_airlock_socket_check "$EGRESS_PROXY" 2>&1)"; then
    echo "claude-airlock: egress proxy: $_egc" >&2
    echo "  Not launching: in proxy mode the box has no other way out. Start the proxy, or pick" >&2
    echo "  another posture on the host: airlock egress minimal" >&2
    exit 1
  fi
  EGRESS_PROXY="$_egc"
  if [ -n "${_REQ_EGRESS:-}" ]; then
    echo "claude-airlock: ignoring .airlock/config 'egress =' ($_REQ_EGRESS): in proxy mode the proxy decides." >&2
    _REQ_EGRESS=""
  fi
  if [ -n "${AIRLOCK_EXTRA_EGRESS:-}" ]; then
    echo "claude-airlock: ignoring AIRLOCK_EXTRA_EGRESS: in proxy mode the proxy decides." >&2
    AIRLOCK_EXTRA_EGRESS=""
  fi
  # Granted sockets are host-approved exits that bypass the proxy's allowlist and log. They
  # stay, but are named every launch so "only the proxy" is never assumed.
  if [ -s "$STATE_DIR/sockets" ] && grep -qvxF "$EGRESS_PROXY" "$STATE_DIR/sockets"; then
    echo "claude-airlock: proxy mode, but these granted sockets are also reachable, outside the proxy:" >&2
    grep -vxF "$EGRESS_PROXY" "$STATE_DIR/sockets" | sed 's/^/  /' >&2
  fi
elif _egress_is_proxy "${AIRLOCK_EGRESS_MODE:-}"; then
  echo "claude-airlock: egress for this project is '$EGRESS_MODE', not the proxy (host default); 'airlock egress proxy' to switch." >&2
fi

# Gate egress requested by the (box-writable) .airlock/config behind a host-side
# approval list the box CANNOT touch — it lives in STATE_DIR, which is not mounted
# into the container. Approved domains apply silently; a new/changed one (e.g. an
# injected `egress = evil.com`) prompts once and is skipped unless you approve it.
# Global-config egress (AIRLOCK_EXTRA_EGRESS, host-set) is trusted and not gated.
if [ -n "${_REQ_EGRESS:-}" ]; then
  _APPROVED="$STATE_DIR/approved-egress"
  touch "$_APPROVED"
  set -f                                                    # split, never glob (see the config parser)
  for _dom in $_REQ_EGRESS; do
    if grep -qxF "$_dom" "$_APPROVED"; then
      AIRLOCK_EXTRA_EGRESS="${AIRLOCK_EXTRA_EGRESS:+$AIRLOCK_EXTRA_EGRESS }$_dom"
    else
      echo "claude-airlock: .airlock/config requests egress to '$_dom' — not yet approved." >&2
      printf 'Allow the sandbox to reach %s? [y/N] ' "$_dom" >&2
      _ans=""; _airlock_answer _ans
      case "$_ans" in
        y|Y|yes|YES)
          printf '%s\n' "$_dom" >> "$_APPROVED"
          AIRLOCK_EXTRA_EGRESS="${AIRLOCK_EXTRA_EGRESS:+$AIRLOCK_EXTRA_EGRESS }$_dom"
          echo "  approved (remembered for this project)." >&2 ;;
        *) echo "  skipped '$_dom' — not added to egress." >&2 ;;
      esac
    fi
  done
  set +f
fi

# Gate folder shares requested by the (box-writable) .airlock/config, TOFU-style like
# egress: each relpath resolves under the HOST-set AIRLOCK_SHARE_BASE and is approved
# once into a store in STATE_DIR the box can't reach. Read (`share`) and write
# (`share_rw`) use SEPARATE stores + prompts — approving a read never grants write.
# Read and write shares each gate against their own store; the CURRENT config's mode
# wins and the helper keeps the two stores mutually exclusive (approving in one clears
# the other), so switching `share` <-> `share_rw` migrates cleanly with no stale entry.
SHARE_RO=(); SHARE_RW=(); SHARE_PINS=()
_gate_shares "${_REQ_SHARE:-}"    "$STATE_DIR/approved-shares"    ro SHARE_RO "$STATE_DIR/approved-shares-rw"
_gate_shares "${_REQ_SHARE_RW:-}" "$STATE_DIR/approved-shares-rw" rw SHARE_RW "$STATE_DIR/approved-shares"

# Claude keys per-project session/memory dirs by the project's absolute path with
# non-alphanumerics turned to '-'. Because we mount the project at its real host
# path, this slug (and every path embedded in the transcripts) matches the host.
HISTSLUG="$(printf '%s' "$WORKSPACE" | sed 's#[^a-zA-Z0-9]#-#g')"

# --- First-run prefs seed (once); then always enforce friction-skips ---
# Seeded by ALLOWLIST, not by deleting what we know is sensitive. The old
# `del(.projects, .mcpServers)` carried everything else across: the account profile
# (email, org and account UUIDs), the host install's stable userID and machineID, and
# githubRepoPaths - a map of every other repo on the machine and where it lives, in a
# box whose whole premise is that it sees only its own project. A denylist lets through
# whatever Claude Code adds to this file next; this list is what a box has a use for.
# Identity is deliberately absent: Claude generates fresh install identifiers per state
# dir, and the injected token (or the box's own login) is all the account it needs.
AIRLOCK_SEED_KEYS='theme editorMode preferredNotifChannel shiftEnterKeyBindingInstalled verbose'
if [ ! -s "$STATE_DIR/claude.json" ] || ! jq -e . "$STATE_DIR/claude.json" >/dev/null 2>&1; then
  if [ -f "$HOME/.claude.json" ] && command -v jq >/dev/null 2>&1; then
    # The fifth of these, and the one that must not be an && || chain: `rm -f` always exits
  # 0, so an `|| echo '{}'` fallback after it is unreachable. That fallback is the whole
  # point of the block - $STATE_DIR/claude.json is bind-mounted into the box, and a
  # missing source becomes a DIRECTORY in the container rather than a config file.
  if jq --arg keys "$AIRLOCK_SEED_KEYS" '
        . as $host | ($keys | split(" ")) as $k
        | reduce $k[] as $key ({}; if ($host[$key] != null) then .[$key] = $host[$key] else . end)
      ' "$HOME/.claude.json" > "$STATE_DIR/claude.json.tmp.$$" 2>/dev/null; then
    mv "$STATE_DIR/claude.json.tmp.$$" "$STATE_DIR/claude.json"
  else
    rm -f "$STATE_DIR/claude.json.tmp.$$"
    echo '{}' > "$STATE_DIR/claude.json"
  fi
  else
    echo '{}' > "$STATE_DIR/claude.json"
  fi
fi
# Enforce (idempotent): onboarding done, a theme, and trust for the workspace
# path. Must NOT gate on oauthAccount, which Claude writes itself at runtime.
if command -v jq >/dev/null 2>&1; then
  # `|| HOST_THEME=dark` matters: on a malformed ~/.claude.json jq exits 5, and under
  # `set -e` that killed the launch with no message at all.
  HOST_THEME="$(jq -r '.theme // "dark"' "$HOME/.claude.json" 2>/dev/null)" || HOST_THEME=dark
  [ "${HOST_THEME:-}" = "null" ] && HOST_THEME="dark"
  # Strip, every launch, what the old seed carried into projects provisioned before the
  # allowlist: githubRepoPaths unconditionally (the box re-adds its own repo if it wants
  # to, which is harmless), and the host's userID / machineID ONLY while they still equal
  # the host's, i.e. they came from the seed. A box that generated its own identifiers
  # keeps them: churning them every launch would be its own problem.
  # oauthAccount is deliberately NOT touched here. A login done inside the box - the
  # persist mode, or a /login in any box - writes the box's own profile, and for the same
  # account it can be identical to the host's, so equality cannot tell the two apart.
  # The allowlist keeps it out of NEW seeds; in an old one it is email and org IDs the
  # box can learn from its token anyway, which is not worth risking a box's login over.
  HOST_IDS="$(jq -c '{userID, machineID}' "$HOME/.claude.json" 2>/dev/null)" || HOST_IDS='{}'
  [ -n "$HOST_IDS" ] || HOST_IDS='{}'
  if jq --arg theme "$HOST_THEME" --arg ws "$WORKSPACE" --argjson host "$HOST_IDS" '
      .hasCompletedOnboarding = true
    | .theme = (.theme // $theme)
    | .copyOnSelect = false
    | .projects[$ws] = ((.projects[$ws] // {}) +
        {hasTrustDialogAccepted: true, hasCompletedProjectOnboarding: true, projectOnboardingSeenCount: 1})
    | del(.githubRepoPaths)
    | if (.userID != null and .userID == $host.userID) then del(.userID) else . end
    | if (.machineID != null and .machineID == $host.machineID) then del(.machineID) else . end
  ' "$STATE_DIR/claude.json" > "$STATE_DIR/claude.json.tmp.$$" 2>/dev/null; then
    mv "$STATE_DIR/claude.json.tmp.$$" "$STATE_DIR/claude.json"
  else
    rm -f "$STATE_DIR/claude.json.tmp.$$"
  fi
fi

# On the Playwright image, give the box Claude the Playwright MCP (browser tools),
# baked into the image — box-only, so the host never consumes it (unlike a project
# .mcp.json, which both sides would read). Removed on other images so a leftover
# config never points at a missing server.
if command -v jq >/dev/null 2>&1; then
  if [[ "$AIRLOCK_IMAGE" == *playwright* ]]; then
    _mcp='.mcpServers.playwright = {command:"playwright-mcp", args:["--headless","--no-sandbox"]}'
  else
    _mcp='if has("mcpServers") then .mcpServers |= del(.playwright) else . end'
  fi
  if jq "$_mcp" "$STATE_DIR/claude.json" > "$STATE_DIR/claude.json.tmp.$$" 2>/dev/null; then
    mv "$STATE_DIR/claude.json.tmp.$$" "$STATE_DIR/claude.json"
  else
    rm -f "$STATE_DIR/claude.json.tmp.$$"
  fi
fi

# Prime the box with airlock conventions (empty shadow venv/node_modules are
# expected — provision them; blocked egress is the firewall; etc.) so Claude
# doesn't misread the sandbox. Refreshed each launch.
_self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
_repo="$(dirname "$(dirname "$_self")")"
# Seed files are placed like every other write into dot-claude (_airlock_place, above).
_seed() {
  [ -f "$1" ] || return 0
  local t
  t="$(_airlock_private_tmp)" || return 1
  if cp "$1" "$t" && chmod --reference="$1" "$t"; then
    _airlock_place "$t" "$2"
  else
    rm -f "$t"
    return 1
  fi
}
# The box CLAUDE.md is composed further down, once the proxy's hosts and any web research
# queue are known: see "The box's CLAUDE.md".

# Merge the airlock default settings.json baseline (env, attribution, permissions,
# ...) into the box's settings each launch, so every session shares the same
# defaults. Airlock defaults win on conflicts; other keys Claude wrote are kept.
if [ -f "$_repo/config/box-settings.json" ] && command -v jq >/dev/null 2>&1; then
  _bs="$STATE_DIR/dot-claude/settings.json"
  # Read through a private copy, never through the box-writable name (see _airlock_place):
  # the box may have made it a link to any JSON file this user can read, and the merge
  # would copy that file into the box. Only a regular file is read; `cp -P` copies a link
  # as a link, so one swapped in after the test is caught on the copy; the timeout covers a
  # FIFO swapped in by a sibling box. Anything else, and anything but a JSON object, starts
  # from {} (a string or a number is valid JSON that every filter below would fail on).
  # Every step writes a new private file and the result is renamed in once, atomically, so
  # a sibling launch never reads a half-written file.
  if [ -d "$_bs" ] && [ ! -L "$_bs" ]; then
    _airlock_planted "$_bs" "a folder" "a regular file"; exit 1
  fi
  _bsd="$(mktemp -d "$STATE_DIR/.write.$$.XXXXXX")"
  # Race-only defences, kept although no static test can see them: the -L precheck and
  # `cp -P` (a link swapped in after the test is copied as a link and rejected below) and
  # the timeout (a FIFO swapped in by a sibling box would block cp forever).
  if [ -f "$_bs" ] && [ ! -L "$_bs" ]; then
    timeout 10 cp -P -- "$_bs" "$_bsd/in" 2>/dev/null || true
    if [ -L "$_bsd/in" ] || [ ! -f "$_bsd/in" ] || [ "$(stat -c %s "$_bsd/in")" -gt 1048576 ]; then
      echo "airlock: WARNING: could not read the box's own $_bs (changed while copied, too slow, or over 1 MiB); it starts from the airlock baseline" >&2
    fi
  elif [ -e "$_bs" ] || [ -L "$_bs" ]; then
    echo "airlock: WARNING: $_bs was $(_airlock_kind "$_bs"), not a regular file (was this planted?); replaced with the airlock baseline" >&2
  fi
  if [ -L "$_bsd/in" ] || [ ! -f "$_bsd/in" ] || [ "$(stat -c %s "$_bsd/in")" -gt 1048576 ] \
     || ! jq -e 'type == "object"' "$_bsd/in" >/dev/null 2>&1; then
    rm -f "$_bsd/in"; echo '{}' > "$_bsd/in"
  fi
  _bscur="$_bsd/in"
  if jq -s '
    .[0] as $e | .[1] as $d
    | ($e * $d)
    | .permissions.allow = ((($e.permissions.allow // []) + ($d.permissions.allow // [])) | unique)
    | .permissions.deny  = ((($e.permissions.deny  // []) + ($d.permissions.deny  // [])) | unique)
  ' "$_bscur" "$_repo/config/box-settings.json" > "$_bsd/merged" 2>/dev/null; then
    _bscur="$_bsd/merged"
  else
    echo "airlock: WARNING: could not merge the settings baseline into $_bs (malformed?); the box runs without it" >&2
  fi

  # Telemetry and error reporting are asserted OFF here every launch, after the baseline
  # merge, so a box whose settings.json lost the keys (or came from the retired `telemetry
  # on`, which deleted DISABLE_TELEMETRY) is corrected on its next launch. The mounted
  # managed settings keep them off regardless; this keeps the file honest.
  _tfilter='.env |= ((if type == "object" then . else {} end) + {DISABLE_TELEMETRY:"1", DISABLE_ERROR_REPORTING:"1"})'
  if jq "$_tfilter" "$_bscur" > "$_bsd/final" 2>/dev/null; then
    _bscur="$_bsd/final"
    # A project switched on with the retired `airlock telemetry on` still has its marker.
    # Clear it and say so once, only now that the box's settings say off.
    if [ -f "$STATE_DIR/telemetry-on" ]; then
      rm -f "$STATE_DIR/telemetry-on"
      echo "airlock: telemetry was on for $(basename "$WORKSPACE"); it is now always off (Remote Control" >&2
      echo "  works without it on Claude Code 2.1.283+). Boxes still running keep it until they restart." >&2
    fi
  else
    echo "airlock: WARNING: could not assert telemetry off in $_bs; the mounted managed settings still apply" >&2
  fi
  _airlock_place "$_bscur" "$_bs"
  rm -rf "$_bsd"
elif ! command -v jq >/dev/null 2>&1; then
  echo "airlock: WARNING: jq not found; the box's settings.json was not checked (the mounted managed settings still apply)" >&2
fi

# --- Concurrent-session guard: warn if this project is already open ---
# Answered from the sessions/ REGISTRY, not from session.lock. The lock is a single slot:
# a second session overwrote it with its own pid, so the first to exit destroyed the live
# session's record and a third session got no warning at all - and it could only ever
# describe ONE peer. The registry holds an entry per live participant, box and raw host
# alike, is already start-time qualified against recycled pids, and prunes its own dead
# entries. Our own pidfile is written well above this, hence the explicit self-exclusion.
#
# The lock is still written below, unchanged in format, AND still read here as a fallback
# - because the registry is only complete if every peer registers, and an older zsh
# wrapper does not. That is not a transient upgrade state: every already-open terminal
# keeps the old `claude` function until it is re-sourced, and a wrapper pasted into an rc
# file never registers at all. Reading the registry alone made this launcher blind to
# those sessions, which main detected. The fallback is strictly ADDITIVE - the lock can
# only contribute a peer the registry missed, never suppress one - so it cannot bring back
# the single-slot problems that motivated the move. It is skipped when the lock's pid is
# already registered, so a modern peer is never counted twice.
if [ "$AIRLOCK_SHELL" != 1 ]; then
  _airlock_peers_in "$SESS_DIR" "$$" || true      # prunes dead entries as a side effect
  _lockpeer=""
  if [ -f "$LOCK" ]; then
    _lp=""; _ls=""
    read -r _lp _ _ _ls < "$LOCK" 2>/dev/null || true
    case "${_lp:-}" in ''|*[!0-9]*) _lp="" ;; esac
    if [ -n "$_lp" ] && [ "$_lp" != "$$" ] && [ ! -e "$SESS_DIR/$_lp" ] \
       && [ -n "$(_airlock_proc_start "$_lp")" ] \
       && { [ -z "${_ls:-}" ] || [ "$_ls" = "$(_airlock_proc_start "$_lp")" ]; }; then
      _lockpeer="$_lp"
    fi
  fi
  if _airlock_history_peers "$SESS_DIR" "$$" || [ -n "$_lockpeer" ]; then
    # Name only the peers that actually triggered this: a `shell` peer holds the mounts
    # but writes no history, so listing it here would be a lie about why we stopped.
    _peers=""
    for _pf in "$SESS_DIR"/*; do
      [ -e "$_pf" ] || continue
      _pfp="${_pf##*/}"
      [ "$_pfp" = "$$" ] && continue
      case "$_pfp" in ''|*[!0-9]*) continue ;; esac
      _pfk=""; read -r _ _pfk < "$_pf" 2>/dev/null || true
      [ "${_pfk:-}" = shell ] && continue
      _peers="$_peers$_pfp "
    done
    [ -n "$_lockpeer" ] && _peers="$_peers$_lockpeer "
    echo "claude-airlock: another session for this project is already open (pid(s): ${_peers% })." >&2
    echo "Two live sessions on one project can corrupt shared --resume history." >&2
    printf "Open another anyway? [y/N] " >&2
    ans=""; _airlock_answer ans
    case "$ans" in y|Y|yes|YES) ;; *) echo "Aborted." >&2; exit 1 ;; esac
  fi
  # Atomic, same reason as the owner file: a plain redirect truncates at open, and a peer
  # reading in that window sees a 0-byte lock and skips the warning entirely.
  printf '%s airlock %s %s\n' "$$" "$(date +%s 2>/dev/null || echo 0)" "$SELF_START" > "$LOCK.tmp.$$"
  mv -f "$LOCK.tmp.$$" "$LOCK"
  LOCK_HELD=1                                    # only now may cleanup remove it
fi

# --- Assemble engine args ---
# Least-privilege capabilities: drop the engine's broad default set and re-add only what
# this box actually needs — NET_ADMIN + NET_RAW so the entrypoint can raise the
# iptables/ipset egress firewall (the ipset match opens a netlink socket that needs
# NET_RAW), and SETUID/SETGID so it can drop root -> the unprivileged `dev` user via
# gosu. no-new-privileges stops anything inside from regaining privileges (e.g. via a
# setuid binary). The agent itself runs as non-root `dev` with no capabilities.
#
# Under rootless podman these caps are namespaced: "root" in the box is root only within
# ITS OWN user namespace, so NET_ADMIN grants control of the box's own network namespace
# and nothing on the host. Under Docker the same caps are backed by real host root.
#
# A workspace holding this account's airlock state would hand the box that state read-write
# through the workspace mount: its managed settings, session files and config, or the
# installed launcher (host code the next launch runs). Refused: the home directory or
# anything above it, and anything inside the directories below. Compared as
# resolved paths, since the engine mounts what a symlinked workspace or home resolves to.
_ws_real="$(readlink -f -- "$WORKSPACE" 2>/dev/null)" || _ws_real="$WORKSPACE"   # readlink, not pwd -P: that keeps "//"
_home_real="$(readlink -f "$HOME" 2>/dev/null)" || _home_real="$HOME"
_ws_pre="${_ws_real%/}/"      # "/" for the root (an inline ${..%/} in a case pattern does not match there)
_held=""
# Also: ~/.local/bin (the launcher links), the install root this launcher runs from (an
# installed one: <root>/versions/<rev>; not a checkout, which may be the workspace on purpose),
# and an AIRLOCK_CONFIG file the account owns (it is sourced at launch: refused only when the
# workspace holds the file itself).
_state_dirs=( "$_home_real" "$HOME/.config/claude-airlock" "$HOME/.local/share/claude-airlock" "$HOME/.local/bin" )
[ "$(basename "$(dirname "$_repo")")" = versions ] && _state_dirs+=( "$(dirname "$(dirname "$_repo")")" )
for _sd in "${_state_dirs[@]}"; do
  _sdr="$(readlink -f "$_sd" 2>/dev/null)" || _sdr="$_sd"
  case "$_sdr/" in "$_ws_pre"*) _held="$_sdr" ;; esac               # the workspace holds it
  [ "$_sdr" = "$_home_real" ] && continue
  case "$_ws_real/" in "$_sdr"/*) _held="$_sdr" ;; esac            # the workspace is inside it
done
if [ -f "$CONFIG_FILE" ] && [ "$(stat -c %u "$CONFIG_FILE")" != 0 ]; then
  _cfr="$(readlink -f "$CONFIG_FILE" 2>/dev/null)" || _cfr="$CONFIG_FILE"
  case "$_cfr" in "$_ws_pre"*) _held="$_cfr" ;; esac
fi
if [ -n "$_held" ]; then
  echo "claude-airlock: the workspace $WORKSPACE ($_ws_real) holds or sits in this account's airlock state ($_held); run it from a project folder, not \$HOME or above; not launching" >&2
  exit 1
fi
# An empty directory, kept in the host-only STATE_DIR (never mounted into a box), to mount
# read-only over the image's managed-settings.d below. Emptied each launch.
mkdir -p "$STATE_DIR/managed-settings.d"
find "$STATE_DIR/managed-settings.d" -mindepth 1 -delete
# A host-side managed-settings drop-in (AIRLOCK_MANAGED_SETTINGS, config or environment only): a
# JSON file root owns and only root may change (the account running the box cannot loosen its own
# box), copied in here, so the box sees it under /etc/claude-code/managed-settings.d. A file that
# fails the check stops the launch: these are restrictions, and a box without them is not the box
# the operator configured.
if [ -n "${AIRLOCK_MANAGED_SETTINGS:-}" ]; then
  _ms="$AIRLOCK_MANAGED_SETTINGS"
  _msr="$(readlink -e "$_ms" 2>/dev/null)" || { echo "claude-airlock: AIRLOCK_MANAGED_SETTINGS '$_ms' does not exist; not launching" >&2; exit 1; }
  if [ ! -f "$_msr" ] || [ "$(stat -c %u "$_msr")" != 0 ] || (( 8#$(stat -c %a "$_msr") & 8#022 )); then
    echo "claude-airlock: AIRLOCK_MANAGED_SETTINGS '$_msr' must be a file root owns and only root may write; not launching" >&2; exit 1
  fi
  if ! command -v jq >/dev/null 2>&1 || ! jq -e 'type == "object"' "$_msr" >/dev/null 2>&1; then
    echo "claude-airlock: AIRLOCK_MANAGED_SETTINGS '$_msr' is not a JSON object (or jq is missing); not launching" >&2; exit 1
  fi
  cp "$_msr" "$STATE_DIR/managed-settings.d/50-host.json"
fi
# The box's timezone: AIRLOCK_TZ, else $TZ, else the host's zone (timedatectl, or where
# /etc/localtime points), else UTC. Only a plain zone name is passed on.
_box_tz() {
  local z="${AIRLOCK_TZ:-${TZ:-}}"
  if [ -z "$z" ]; then
    z="$(timedatectl show -p Timezone --value 2>/dev/null)" || z=""
    if [ -z "$z" ]; then
      z="$(readlink /etc/localtime 2>/dev/null)" || z=""
      case "$z" in */zoneinfo/*) z="${z#*/zoneinfo/}" ;; *) z="" ;; esac
    fi
  fi
  z="${z#:}"   # a POSIX TZ may start with ':'
  if [[ "$z" =~ ^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$ ]]; then printf '%s' "$z"; return; fi
  [ -z "$z" ] || echo "claude-airlock: timezone '$z' is not a plain zone name; the box uses UTC" >&2
  printf UTC
}

args=(
  --rm -i
  --hostname airlock
  --cap-drop=ALL
  --cap-add=SETUID --cap-add=SETGID
  --security-opt=no-new-privileges
  # The engine's default seccomp profile minus new namespaces. With the default, `dev`
  # could `unshare -Ur` and become root with a full capability set inside a nested user
  # namespace (measured) - not an escape, the nested netns is empty and the firewall lives
  # in the outer one, but it is the precondition for most container-to-host kernel
  # exploits (netfilter, overlayfs, keyrings). image/seccomp.json is podman's default
  # with unshare/setns refused, clone allowed only without namespace flags, and clone3
  # answered ENOSYS so libc falls back to the filtered clone (the clone3 argument block
  # cannot be inspected); keyrings, memfd_secret, socket families other than unix, inet,
  # inet6 and netlink, and on x86_64 every i386/x32 syscall are refused too (unused kernel
  # surface; README). Nothing the box runs needs a namespace: Claude Code's own Bash
  # sandbox (bubblewrap) is opt-in, not installed in the image, and documented to fall
  # back to unsandboxed with a warning when unavailable; Chromium runs --no-sandbox.
  # Verified live: git, node workers, python threads, pwsh, kubectl, helm, every
  # validator, Postgres and claude itself run unchanged.
  --security-opt "seccomp=$_repo/image/seccomp.json"
  -e TERM -e "TZ=$(_box_tz)"
  -e DISABLE_AUTOUPDATER=1 -e DISABLE_TELEMETRY=1 -e DISABLE_ERROR_REPORTING=1
  # Managed settings, mounted from this install rather than trusted to the image: the box's
  # .airlock/config can pick any claude-airlock:* tag, including one built before the image
  # carried this file. Only this layer holds against the box; the -e flags above and the
  # asserted settings.json are overridden by a workspace .claude/settings.local.json.
  -v "$_repo/image/managed-settings.json:/etc/claude-code/managed-settings.json:ro"
  # The status line Claude runs (managed `statusLine`), from the installed version and
  # read-only: a copy in the box-writable ~/.claude could be rewritten by the box mid-session,
  # and Claude prints its output to the terminal.
  -v "$_repo/config/airlock-statusline.sh:/etc/airlock/statusline.sh:ro"
  # Drop-ins in managed-settings.d outrank that file, and an image could ship some: cover
  # the directory with an empty read-only one. (An empty bind, not a tmpfs: podman copies
  # the image's files into a tmpfs by default.)
  -v "$STATE_DIR/managed-settings.d:/etc/claude-code/managed-settings.d:ro"
  --env-file "$ENV_FILE"                         # OAuth token + secrets (0600, off the process table)
  -w "$WORKSPACE"
  -v "$STATE_DIR/dot-claude:/home/dev/.claude:rw"
  -v "$STATE_DIR/claude.json:/home/dev/.claude.json:rw"
  -v "$AIRLOCK_TMP:$AIRLOCK_TMP:rw"                 # per-project scratch, same path host & box
  -e "AIRLOCK_TMP=$AIRLOCK_TMP"
)
# A 24-bit terminal says so in COLORTERM, not TERM; without it Claude in the box falls back
# to 256 colours. Passed only when the host sets it.
[ -z "${COLORTERM:-}" ] || args+=( -e "COLORTERM=$COLORTERM" )

# The firewall's capabilities, only where there is a firewall: a proxy-mode box has no
# network to filter, and no use for control of its own network namespace.
if [ -z "$EGRESS_PROXY" ]; then
  args+=( --cap-add=NET_ADMIN --cap-add=NET_RAW )
fi

# Resource limits. Cap the in-box process count so a runaway or compromised agent can't
# fork-bomb the host; podman already defaults pids-limit to 2048, but Docker's default is
# unlimited, so set it explicitly for parity. A RAM cap is opt-in (empty = none): too low
# a ceiling silently breaks real builds (node/webpack, native compiles), so it is off by
# default and set deliberately per host. Both are overridable in host config.
case "$AIRLOCK_PIDS_LIMIT" in
  ''|0) ;;                                          # unset / 0 -> engine default
  *[!0-9]*) echo "claude-airlock: AIRLOCK_PIDS_LIMIT must be a number (got '$AIRLOCK_PIDS_LIMIT') — ignoring." >&2 ;;
  *) args+=( --pids-limit "$AIRLOCK_PIDS_LIMIT" ) ;;
esac
[ -n "$AIRLOCK_MEMORY" ] && args+=( --memory "$AIRLOCK_MEMORY" )

if [ "$AIRLOCK_ENGINE" = podman ]; then
  # Rootless podman puts the box in a user namespace. By DEFAULT it maps the host user
  # to container root, and container uid 1000 (`dev`) to a subuid — so every bind-mounted
  # file would appear root-owned and `dev` could not write its own workspace. keep-id
  # pins host uid/gid -> 1000:1000 instead, which is exactly the uid the image gives
  # `dev`, so mounts line up and files the box writes land on the host owned by you.
  # Container root still maps into the subuid range, so the entrypoint can still raise
  # the firewall before dropping to `dev`.
  args+=( "--userns=keep-id:uid=1000,gid=1000" )
fi

# The current project: read-write, at its REAL host path, so the session
# transcripts (which embed absolute paths) resolve and `--resume` is seamless
# in and out of the box.
args+=( -v "$WORKSPACE:$WORKSPACE:rw" )

# Shadow environment-built artifact dirs (.venv, node_modules, ...) with
# container-local, per-project storage. venvs and node_modules aren't portable
# across the host↔container boundary (different interpreter/libc/arch), so the
# box gets its OWN copy while the host's sits underneath, untouched — neither
# side clobbers the other.
set -f                                          # split, never glob (see the config parser)
for d in $AIRLOCK_ARTIFACT_DIRS; do
  case "$d" in /*|*..*) continue ;; esac        # reject absolute paths / parent escapes
  host_path="$WORKSPACE/$d"
  store="$STATE_DIR/artifacts/$(printf '%s' "$d" | sed 's#/#__#g')"
  mkdir -p "$store"
  if [ ! -e "$host_path" ]; then
    mkdir -p "$host_path"
    # Recorded on disk, not in a shell array: the session that creates this is often not
    # the last one out, and only the last one out may remove it.
    mkdir -p "$STATE_DIR/artifacts-created"
    # `path-` prefix is load-bearing: these names come from $AIRLOCK_ARTIFACT_DIRS, which
    # is mostly dotfiles (.venv), and the cleanup's `*` glob would skip every one of them.
    # Line 1 is the path, line 2 its identity - the marker authorises removing THIS
    # directory, not whatever later occupies the path.
    printf '%s\n%s\n' "$host_path" "$(_airlock_dir_id "$host_path")" \
      > "$STATE_DIR/artifacts-created/path-$(printf '%s' "$d" | sed 's#/#__#g')"
  fi
  # Advisory ownership of the STORE. Two boxes on one project mount the same store, and
  # two concurrent `pip install`s into one venv corrupt it with no signature at all -
  # you get a half-written package tree and an import error days later. Unlike the mount
  # bugs this cannot be fixed by cleanup ordering, so the second box gets it read-only
  # and is told why: a hard, immediate failure beats silent corruption, and the shared
  # cache still works for everyone reading it.
  owner="$store.owner"
  owner_pid=""; owner_start=""
  # `|| true` is load-bearing, not defensive noise. read returns 1 at EOF-without-newline,
  # and under `set -e` that is FATAL as the last command of an && list: a 0-byte or
  # truncated .owner file made the launcher exit 1 with no output at all, leaving the
  # project unlaunchable until someone found an invisible dotfile under ~/.config. A
  # 0-byte read is reachable by design - the writer below truncates at open - so the very
  # race this ownership exists to prevent was killing launches instead.
  if [ -f "$owner" ]; then
    read -r owner_pid owner_start _ < "$owner" 2>/dev/null || true
  fi
  case "${owner_pid:-}" in ''|*[!0-9]*) owner_pid=""; owner_start="" ;; esac
  if [ -n "$owner_pid" ] && [ "$owner_pid" != "$$" ] \
     && [ -n "$(_airlock_proc_start "$owner_pid")" ] \
     && { [ -z "${owner_start:-}" ] || [ "$owner_start" = "$(_airlock_proc_start "$owner_pid")" ]; }; then
    echo "claude-airlock: $d is already held read-write by session $owner_pid; mounting it READ-ONLY here." >&2
    echo "  Two sessions installing into one $d at the same time corrupts it silently." >&2
    # Mounts are fixed at container start, so this box stays read-only for its whole life -
    # closing the other session does NOT upgrade it.
    echo "  Installs in this box will fail. Run them in session $owner_pid, or close that" >&2
    echo "  session and RESTART this box. Ownership is recorded in $owner." >&2
    args+=( -v "$store:$host_path:ro" )
  else
    # Written atomically: a plain redirect truncates at open, so a peer starting inside
    # that window reads a 0-byte file. mv within one directory is atomic, so a reader
    # sees either the old contents or the new, never an empty file.
    printf '%s %s\n' "$$" "$SELF_START" > "$owner.tmp.$$"
    mv -f "$owner.tmp.$$" "$owner"
    STORE_OWNED+=( "$owner" )
    args+=( -v "$store:$host_path:rw" )
  fi
done
set +f

# Host-approved per-project folder shares, mounted at their REAL host path so the box
# sees the same absolute path you do (no /roots translation). `share_rw` mounts rw,
# `share` mounts ro. Skip any that overlap the workspace — it's already read-write, and
# nesting mounts under it can't be set up by the runtime. rw wins over a duplicate ro.
for _m in "${SHARE_RW[@]:-}"; do
  [ -z "$_m" ] && continue
  case "$_m" in "$WORKSPACE"|"$WORKSPACE"/*) continue ;; esac
  case "$WORKSPACE" in "$_m"/*) continue ;; esac
  args+=( -v "$_m:$_m:rw" )
done
for _m in "${SHARE_RO[@]:-}"; do
  [ -z "$_m" ] && continue
  case "$_m" in "$WORKSPACE"|"$WORKSPACE"/*) continue ;; esac
  case "$WORKSPACE" in "$_m"/*) continue ;; esac
  case " ${SHARE_RW[*]:-} " in *" $_m "*) continue ;; esac      # already mounted rw
  args+=( -v "$_m:$_m:ro" )
done

# The paste drop box, read-only at its own path, for every project (AIRLOCK_PASTE_DIR): pastes
# someone else hands this account (it only reads them). The box finds pastes at
# $AIRLOCK_PASTES: that directory, or else this project's $AIRLOCK_TMP/pastes.
_pastes="$AIRLOCK_TMP/pastes"
_paste_pin=""
if [ -n "${AIRLOCK_PASTE_DIR:-}" ]; then
  if _pc="$(_airlock_paste_dir_check "$AIRLOCK_PASTE_DIR" 2>&1)"; then
    args+=( -v "$_pc:$_pc:ro" ); _pastes="$_pc"; _paste_pin="$(stat -c %d:%i "$_pc") $_pc"
  else
    echo "claude-airlock: NOT mounting AIRLOCK_PASTE_DIR: $_pc" >&2; _pastes=""
  fi
fi
[ -z "$_pastes" ] || args+=( -e "AIRLOCK_PASTES=$_pastes" )

# Host-configured extra mounts (AIRLOCK_EXTRA_MOUNTS): "DIR:ro" or "DIR:rw", at their own
# path. A directory that fails the check is skipped with a warning (that only removes access).
# Split, never globbed; a directory named twice is mounted once, read-only if any entry says so;
# :rw only for a directory root owns (one the account owns, the box could chmod open).
_extra_pins=()
declare -A _emode=()
read -r -d '' -a _ems <<< "$AIRLOCK_EXTRA_MOUNTS" || true    # every line, not just the first
for _em in "${_ems[@]}"; do
  _emp="${_em%:*}" _emm="${_em##*:}"
  case "$_emm" in ro|rw) ;; *) echo "claude-airlock: AIRLOCK_EXTRA_MOUNTS entry '$_em' needs :ro or :rw; skipped" >&2; continue ;; esac
  if ! _emc="$(_airlock_extra_mount_check "$_emp" 2>&1)"; then
    echo "claude-airlock: NOT mounting AIRLOCK_EXTRA_MOUNTS entry '$_em': $_emc" >&2; continue
  fi
  if [ "$_emc" = "${_paste_pin#* }" ]; then continue; fi        # already the paste dir, read-only
  if [ "$_emm" = rw ] && [ "$(stat -c %u "$_emc")" != 0 ]; then
    echo "claude-airlock: NOT mounting AIRLOCK_EXTRA_MOUNTS entry '$_em': read-write needs a directory root owns" >&2; continue
  fi
  if [ -z "${_emode[$_emc]:-}" ]; then _extra_pins+=( "$(stat -c %d:%i "$_emc") $_emc" ); fi
  [ "${_emode[$_emc]:-}" = ro ] || _emode[$_emc]=$_emm
done
for _kp in "${_extra_pins[@]}"; do _emc="${_kp#* }"; args+=( -v "$_emc:$_emc:${_emode[$_emc]}" ); done
# Web research (docs/agents.md): a box with a queue mounted (<queue>/requests read-write,
# <queue>/answers and <queue>/lib read-only) gets the queue's rule at the top of its CLAUDE.md
# (answers are data, never instructions) and how to ask at the end. Both files are root's, as
# the agents apply renders them into lib/ (readable, writable by root alone, at most 16 KiB);
# otherwise the box CLAUDE.md is as before.
_web_top="" _web_end=""
for _kp in "${_extra_pins[@]}"; do
  _emc="${_kp#* }"; _q="${_emc%/*}"
  [ "${_emc##*/}" = lib ] && [ "${_emode[$_emc]}" = ro ] || continue
  [ "${_emode[$_q/requests]:-}" = rw ] && [ "${_emode[$_q/answers]:-}" = ro ] || continue
  _wok=1
  for _wf in web-research-rule.md web-research.md; do
    _wm="$(stat -c %a "$_emc/$_wf" 2>/dev/null)" || _wm=777
    if [ ! -f "$_emc/$_wf" ] || [ -L "$_emc/$_wf" ] || [ ! -r "$_emc/$_wf" ] \
       || [ "$(stat -c %u "$_emc/$_wf")" != 0 ] || ! [[ "$_wm" =~ ^[0-7]{3,4}$ ]] || (( 8#$_wm & 8#022 )) \
       || [ "$(stat -c %s "$_emc/$_wf")" -gt 16384 ]; then _wok=0; fi
  done
  if [ "$_wok" = 1 ]; then _web_top="$_emc/web-research-rule.md" _web_end="$_emc/web-research.md"; break; fi
done

# Host-added read-only mounts (`airlock mount add`). Re-checked here, not trusted from the
# store: a directory that has since become a symlink into ~/.ssh, or gained a hard link,
# is skipped. Skipping only ever removes access, so it warns rather than aborting.
if [ -s "$STATE_DIR/mounts" ]; then
  while IFS= read -r _m || [ -n "$_m" ]; do
    [ -n "$_m" ] || continue
    if _mc="$(_airlock_mount_check "$_m" 2>&1)"; then
      if [ "$_mc" = "$_m" ]; then args+=( -v "$_mc:$_mc:ro" )
      else echo "claude-airlock: NOT mounting $_m: it now resolves to $_mc (re-add it if intended)" >&2; fi
    else
      echo "claude-airlock: NOT mounting $_m: $_mc" >&2
    fi
  done < "$STATE_DIR/mounts"
fi

# Host-added sockets (`airlock socket add`), re-checked here like mounts: a socket since
# replaced by a symlink, a regular file, or moved under a writable directory is skipped.
_ksock_pins=()
if [ -s "$STATE_DIR/sockets" ]; then
  while IFS= read -r _k || [ -n "$_k" ]; do
    [ -n "$_k" ] || continue
    if _kc="$(_airlock_socket_check "$_k" 2>&1)"; then
      args+=( -v "$_kc:$_kc:ro" )
      _ksock_pins+=( "$(stat -c %d:%i:%.9Z:%u:%f "$_kc") $_kc" )
    else echo "claude-airlock: NOT mounting socket $_k: $_kc" >&2; fi
  done < "$STATE_DIR/sockets"
fi
# The proxy socket, checked and pinned the same way, but refusal stops the launch. The
# entrypoint bridges it to 127.0.0.1:3128 and points the proxy variables there.
if [ -n "$EGRESS_PROXY" ]; then
  if ! _kc="$(_airlock_socket_check "$EGRESS_PROXY" 2>&1)"; then
    echo "claude-airlock: egress proxy: $_kc; not launching" >&2
    exit 1
  fi
  _kdup=0
  for _kp in "${_ksock_pins[@]}"; do [ "${_kp#* }" = "$_kc" ] && _kdup=1; done
  if [ "$_kdup" = 0 ]; then
    args+=( -v "$_kc:$_kc:ro" )
    _ksock_pins+=( "$(stat -c %d:%i:%.9Z:%u:%f "$_kc") $_kc" )
  fi
  args+=( -e "AIRLOCK_EGRESS_PROXY=$_kc" )
  # Plain-HTTP hosts behind it: their git remotes and gh are pointed at http:// below.
  _airlock_client_manifest "$_kc" || true
fi
# The box's CLAUDE.md, written each launch (whatever the box left there is replaced), in layers:
#   the web research rule (only with a queue mounted, above)
#   the base: the toolkit's config/box-CLAUDE.md, or AIRLOCK_BOX_CLAUDE_MD (a file, or none)
#   the account's own additions: AIRLOCK_BOX_CLAUDE_EXTRA, else
#     ~/.config/claude-airlock/box-CLAUDE.md if it exists
#   the proxy's hosts (from its manifest), then how to ask the web (with the queue)
# The base and the additions come from the config or the launching process, never from
# .airlock/config, and are text the box will trust, so each must be a readable regular file of at
# most 64 KiB that no one else may write, in one of two places no box can write: a root-owned
# tree (the file and every directory above it root's, no symlink on the way), or directly in
# this account's ~/.config/claude-airlock/ (only its state/ is ever mounted). One that fails
# stops the launch: it is what the operator configured the box with.
_airlock_box_md_file() {   # $1 = what (for messages), $2 = path: prints its real path
  local r m d own="$_home_real/.config/claude-airlock"
  r="$(readlink -e -- "$2" 2>/dev/null)" || { echo "claude-airlock: $1 '$2' does not exist; not launching" >&2; return 1; }
  m="$(stat -c %a "$r" 2>/dev/null)" || m=777
  if [ ! -f "$r" ] || [ ! -r "$r" ] || ! [[ "$m" =~ ^[0-7]{3,4}$ ]] || (( 8#$m & 8#022 )) \
     || [ "$(stat -c %s "$r")" -gt 65536 ]; then
    echo "claude-airlock: $1 '$r' must be a readable regular file of at most 64 KiB that no one else may write; not launching" >&2; return 1
  fi
  if [ "${r%/*}" = "$own" ] && [ ! -L "$2" ] && [ "$(stat -c %u "$r")" = "$(id -u)" ]; then
    printf '%s' "$r"; return 0
  fi
  if [ "$r" = "$(realpath -s -- "$2" 2>/dev/null)" ] && [ "$(stat -c %u "$r")" = 0 ]; then
    d="${r%/*}"
    while :; do
      m="$(stat -c %a "${d:-/}" 2>/dev/null)" || m=777
      if [ "$(stat -c %u "${d:-/}" 2>/dev/null)" != 0 ] || ! [[ "$m" =~ ^[0-7]{3,4}$ ]] || (( 8#$m & 8#022 )); then break; fi
      if [ -z "$d" ]; then printf '%s' "$r"; return 0; fi
      d="${d%/*}"
    done
  fi
  echo "claude-airlock: $1 '$2' must be root's in a tree only root may write (no symlinks), or a file of yours directly in $own; not launching" >&2
  return 1
}
_box_base="$_repo/config/box-CLAUDE.md"
if [ "${AIRLOCK_BOX_CLAUDE_MD:-}" = none ]; then _box_base=""
elif [ -n "${AIRLOCK_BOX_CLAUDE_MD:-}" ]; then _box_base="$(_airlock_box_md_file AIRLOCK_BOX_CLAUDE_MD "$AIRLOCK_BOX_CLAUDE_MD")" || exit 1
elif [ ! -f "$_box_base" ]; then _box_base=""; fi
_box_extra=""
if [ -n "${AIRLOCK_BOX_CLAUDE_EXTRA:-}" ]; then
  _box_extra="$(_airlock_box_md_file AIRLOCK_BOX_CLAUDE_EXTRA "$AIRLOCK_BOX_CLAUDE_EXTRA")" || exit 1
elif [ -e "$HOME/.config/claude-airlock/box-CLAUDE.md" ]; then
  _box_extra="$(_airlock_box_md_file "your box CLAUDE.md additions" "$HOME/.config/claude-airlock/box-CLAUDE.md")" || exit 1
fi
_bd="$(_airlock_private_tmp)" || exit 1
_sep() { [ ! -s "$_bd" ] || echo; }   # a blank line between layers, none before the first
if ! { { [ -z "$_web_top" ] || cat "$_web_top"; } > "$_bd" \
       && { [ -z "$_box_base" ] || { _sep; cat "$_box_base"; }; } >> "$_bd" \
       && { [ -z "$_box_extra" ] || { _sep; cat "$_box_extra"; }; } >> "$_bd" \
       && _airlock_box_directives >> "$_bd" \
       && { [ -z "$_web_end" ] || cat "$_web_end"; } >> "$_bd"; } \
   || ! chmod 0644 "$_bd"; then
  rm -f "$_bd"; echo "claude-airlock: could not write the box CLAUDE.md; not launching" >&2; exit 1
fi
_airlock_place "$_bd" "$STATE_DIR/dot-claude/CLAUDE.md"

# Host git must not read instructions a box wrote. In each read-write root (the workspace and
# every share_rw) that holds a git repo, every config file host git reads for it is bound
# read-only: .git/config and its in-root includes, config.worktree, commondir (created as "."
# where git would otherwise look for one, so it can't be added to point git elsewhere), the
# .git pointer files of in-root linked worktrees and submodules, and their gitdirs' configs.
# The hooks too, and an in-root core.hooksPath (per worktree) or hook symlink target. Each git
# directory is bound onto itself so it cannot be renamed away and replaced (under rootful
# docker no user namespace locks the nested mounts). Work happens on canonical paths and binds
# land at the path the box sees. Anything that looks planted (a symlink, a hard link, an
# unreadable git directory, a commondir pointing elsewhere) stops the launch.
# Not covered here, see SECURITY.md: hooks and core.fsmonitor reached through repos a box
# creates (a gitlink, a new submodule), paused rebase/am/cherry-pick state, global config.
_git_roots_c=() _git_roots_l=()   # each read-write root: canonical path, and the path the box sees
_git_add_root() { local c; c="$(realpath -e -- "$1" 2>/dev/null)" || return 0; _git_roots_c+=("$c"); _git_roots_l+=("$1"); }
_git_add_root "$WORKSPACE"
for _m in "${SHARE_RW[@]:-}"; do   # as mounted below: a share the workspace sits inside is not
  [ -n "$_m" ] || continue
  case "$WORKSPACE" in "$_m"/*) continue ;; esac
  _git_add_root "$_m"
done
_git_root_of() {   # the root holding canonical path $1, into _git_ri
  local i
  for i in "${!_git_roots_c[@]}"; do
    case "$1" in "${_git_roots_c[$i]}"|"${_git_roots_c[$i]}"/*) _git_ri=$i; return 0 ;; esac
  done
  return 1
}
_git_bound=()
# Bind existing path $1 ($2 = ro|rw) at the path the box sees. It must be canonical (no
# symlink anywhere in it) and, for a file, its only name: a second name would stay writable.
_git_bind() {
  local b d c
  c="$(realpath -e -- "$1" 2>/dev/null)" || { echo "$1 does not exist" >&2; return 1; }
  if [ "$c" != "$1" ]; then   # a symlink: refused if it or what it reaches is in a root
    if _git_root_of "$c" || _git_root_of "$1"; then echo "$1 is, or goes through, a symlink" >&2; return 1; fi
    return 0
  fi
  _git_root_of "$1" || return 0
  [ "$1" != "${_git_roots_c[$_git_ri]}" ] || return 0   # a root is mounted already (and can't be renamed)
  if [ -f "$1" ] && [ "$(stat -c %h -- "$1")" != 1 ]; then echo "$1 has more than one hard link" >&2; return 1; fi
  d="${_git_roots_l[$_git_ri]}${1#"${_git_roots_c[$_git_ri]}"}"
  for b in "${_git_bound[@]:-}"; do [ "$b" = "$d" ] && return 0; done
  _git_bound+=("$d"); args+=( -v "$1:$d:$2" )
}
_git_readable_dir() { [ -d "$1" ] && [ -r "$1" ] && [ -x "$1" ] || { echo "$1 can't be read (a box may have changed its permissions)" >&2; return 1; }; }
# Read one config file and nothing else: from /, so git discovers no repository (from inside
# the project it would read the project's own config, includes and all, at startup), with no
# system or global config. Exit 1 is "no such key"; anything else (a fatal parse) refuses.
_git_cfg() {
  local out rc=0
  [ -r "${2:?}" ] || { echo "cannot read git config $2" >&2; return 1; }
  out="$(GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null git -C / config --no-includes "$@" 2>&1)" || rc=$?
  case "$rc" in
    0) printf '%s\n' "$out" ;;
    1) ;;
    *) echo "cannot read git config ($2): ${out%%$'\n'*}" >&2; return 1 ;;
  esac
}
# A path named by a config value: $1, relative to $2 (canonical). Inside a read-write root it is
# created if missing ($3 = dir|file) and bound read-only; its canonical form goes to _git_path.
# ~user/ and %(prefix)/ forms only come from config the box can't write: not followed.
_git_guard_path() {
  local p="$1"
  _git_path=""
  # shellcheck disable=SC2088 # a literal ~/ in the config value, expanded the way git does
  case "$p" in "~/"*) p="$HOME/${p#\~/}" ;; "~"*|"%(prefix)"*) return 0 ;; /*) ;; *) [ -n "$2" ] || return 0; p="$2/$p" ;; esac
  p="$(realpath -ms -- "$p")"
  _git_path="$p"
  # Outside every root, also once symlinks are followed: nothing the box can write.
  _git_root_of "$p" || _git_root_of "$(realpath -m -- "$p")" || return 0
  if [ ! -e "$p" ] && [ ! -L "$p" ]; then
    # Created inside a read-write root, so the box decides what its parents are: a parent
    # that is a symlink would make mkdir create (and `: >` truncate) outside it. Refuse
    # unless the path resolves to itself; create the file with O_EXCL (noclobber).
    if [ "$(realpath -m -- "$p")" != "$p" ]; then
      echo "$p goes through a symlink (the box could have put it there); not creating it" >&2; return 1
    fi
    if [ "$3" = dir ]; then mkdir -p -- "$p" || return 1; else { mkdir -p -- "$(dirname -- "$p")" && ( set -C; : > "$p" ); } || return 1; fi
  fi
  _git_bind "$p" ro
}
# Config file $1 (canonical) of a repo with a worktree at $2 (canonical, or "" for none: then a
# relative core.hooksPath has nothing to resolve against). Includes are followed here the way
# git resolves them (relative to the including file, at most 10 deep), never by git. $3: depth.
_git_guard_config() {
  local f="$1" depth="${3:-0}" k k_all v
  [ "$depth" -le 10 ] || { echo "$f: config includes nested more than 10 deep" >&2; return 1; }
  _git_bind "$f" ro || return 1
  v="$(_git_cfg --file "$f" --get core.hooksPath)" || return 1
  [ -z "$v" ] || _git_guard_path "$v" "$2" dir || return 1
  k_all="$(_git_cfg --file "$f" --get-regexp '^(include|includeif\..*)\.path$')" || return 1
  while IFS= read -r k; do
    [ -n "$k" ] || continue
    _git_guard_path "${k#* }" "$(dirname -- "$f")" file || return 1
    if [ -n "$_git_path" ] && [ -f "$_git_path" ]; then _git_guard_config "$_git_path" "$2" $((depth + 1)) || return 1; fi
  done <<< "$k_all"
}
_git_wtcfg=0   # extensions.worktreeConfig of the repo being guarded
_git_guard_wtconfig() {   # config.worktree $1 for worktree $2, when the extension is on
  [ "$_git_wtcfg" = true ] || return 0
  if [ ! -e "$1" ] && [ ! -L "$1" ]; then ( set -C; : > "$1" ) || return 1; fi
  _git_guard_config "$1" "$2"
}
_git_pointer_target() {   # the gitdir a .git pointer file $1 names, canonical-ish (no symlinks resolved)
  local t
  t="$(sed -n '1s/^gitdir: //p' -- "$1")"
  case "$t" in /*) ;; *) t="$(dirname -- "$1")/$t" ;; esac
  realpath -m -- "$t"
}
_git_guard_pointer() {   # a worktree's .git pointer file $1 (as the gitdir records it)
  local p
  p="$(realpath -ms -- "$1")"
  _git_root_of "$p" || _git_root_of "$(realpath -m -- "$p")" || return 0
  [ -e "$p" ] || [ -L "$p" ] || return 0   # a worktree whose checkout is gone
  [ -f "$p" ] || { echo "$p is not a .git pointer file" >&2; return 1; }
  _git_bind "$p" ro
}
# A repo's common git directory $1 (canonical, inside a read-write root), whose main worktree
# is $2 ("" if it has none in view).
_git_guard_common() {
  local c="$1" wt="$2" d e t
  _git_readable_dir "$c" || return 1
  [ -f "$c/config" ] || { echo "$c has no config file" >&2; return 1; }
  [ -d "$c/hooks" ] || [ -L "$c/hooks" ] || mkdir -- "$c/hooks" || return 1
  _git_readable_dir "$c/hooks" || return 1
  _git_bind "$c" rw || return 1
  _git_bind "$c/hooks" ro || return 1
  for e in "$c"/hooks/*; do   # a hook that is a symlink into a read-write root: its target too
    [ -L "$e" ] || continue
    if ! t="$(realpath -e -- "$e" 2>/dev/null)"; then   # dangling: the box could create the target
      t="$(realpath -m -- "$e")"
      if _git_root_of "$t"; then echo "$e is a symlink to $t, which doesn't exist (the box could create it)" >&2; return 1; fi
      continue
    fi
    if _git_root_of "$t"; then _git_bind "$t" ro || return 1; fi
  done
  if [ -e "$c/commondir" ] || [ -L "$c/commondir" ]; then
    [ -f "$c/commondir" ] && [ ! -L "$c/commondir" ] && [ "$(cat -- "$c/commondir")" = . ] \
      || { echo "$c/commondir points git somewhere else" >&2; return 1; }
  else ( set -C; printf '.\n' > "$c/commondir" ) || return 1; fi
  _git_bind "$c/commondir" ro || return 1
  _git_wtcfg="$(_git_cfg --file "$c/config" --bool --get extensions.worktreeConfig)" || return 1
  _git_guard_config "$c/config" "$wt" || return 1
  [ -z "$wt" ] || _git_guard_wtconfig "$c/config.worktree" "$wt" || return 1
  if [ -e "$c/worktrees" ] || [ -L "$c/worktrees" ]; then
    _git_readable_dir "$c/worktrees" || return 1
    for d in "$c"/worktrees/*; do
      [ -e "$d" ] || [ -L "$d" ] || continue
      _git_readable_dir "$d" || return 1
      _git_bind "$d" rw || return 1
      # Without a commondir git takes this directory for a whole repo (its own config and
      # hooks); one that resolves elsewhere points git at another config. Either refuses.
      [ -f "$d/commondir" ] && [ ! -L "$d/commondir" ] \
        && [ "$(realpath -m -- "$d/$(head -n 1 -- "$d/commondir")")" = "$c" ] \
        || { echo "$d/commondir is missing or doesn't lead back to $c" >&2; return 1; }
      _git_bind "$d/commondir" ro || return 1
      e=""
      if [ -e "$d/gitdir" ] || [ -L "$d/gitdir" ]; then
        _git_bind "$d/gitdir" ro || return 1
        e="$(realpath -ms -- "$(head -n 1 -- "$d/gitdir")")"
        if [ -e "$e" ] || [ -L "$e" ]; then
          # The checkout's .git must point back here, or the gitdir file was redirected.
          [ -f "$e" ] && [ "$(_git_pointer_target "$e")" = "$d" ] \
            || { echo "$d/gitdir names $e, which doesn't point back to $d" >&2; return 1; }
          _git_guard_pointer "$e" || return 1
          e="$(dirname -- "$e")"
          _git_guard_config "$c/config" "$e" || return 1
        else e=""; fi   # a checkout that is gone (prunable): nothing to guard, nothing created
      fi
      _git_guard_wtconfig "$d/config.worktree" "$e" || return 1
    done
  fi
}
_git_guard_root() {   # read-write root $1 (canonical)
  local r="$1" g="$1/.git" gd c m mwt
  [ -L "$g" ] && { echo "$g is a symlink" >&2; return 1; }
  if [ -f "$g" ]; then   # a linked worktree (or submodule checkout): guard the chain it points at
    _git_bind "$g" ro || return 1
    gd="$(sed -n '1s/^gitdir: //p' -- "$g")"
    [ -n "$gd" ] || { echo "$g is not a gitdir pointer" >&2; return 1; }
    case "$gd" in /*) ;; *) gd="$r/$gd" ;; esac
    gd="$(realpath -ms -- "$gd")"
    c="$gd"
    [ -f "$gd/commondir" ] && c="$(realpath -ms -- "$gd/$(head -n 1 -- "$gd/commondir")")"
    if _git_root_of "$c"; then _git_guard_common "$c" "" || return 1
    else _git_wtcfg="$(_git_cfg --file "$c/config" --bool --get extensions.worktreeConfig)" || return 1; fi
    if _git_root_of "$gd" && [ "$gd" != "$c" ]; then
      _git_bind "$gd" rw || return 1
      if [ -e "$gd/commondir" ]; then _git_bind "$gd/commondir" ro || return 1; fi
    fi
    _git_guard_config "$c/config" "$r" || return 1
    _git_guard_wtconfig "$gd/config.worktree" "$r" || return 1
    return 0
  fi
  if [ ! -e "$g" ] && [ -f "$r/HEAD" ] && [ -f "$r/config" ] && [ -d "$r/objects" ]; then
    _git_guard_common "$r" "" || return 1   # a bare repo: the root is its git directory
    return 0
  fi
  [ -d "$g" ] || return 0
  _git_guard_common "$g" "$r" || return 1
  # Submodule gitdirs, nested ones included (each holds a HEAD); an unreadable directory under
  # modules/ refuses instead of hiding what is below it.
  if [ -e "$g/modules" ] || [ -L "$g/modules" ]; then
    _git_readable_dir "$g/modules" || return 1
    m="$(find "$g/modules" -maxdepth 64 \( -type d ! \( -readable -executable \) -printf 'UNREADABLE %p\n' -prune \) -o \( -type f -name HEAD -printf '%h\n' \) 2>&1)" \
      || { echo "cannot walk $g/modules: ${m%%$'\n'*}" >&2; return 1; }
    case "$m" in *UNREADABLE*) echo "$g/modules holds a directory that can't be read (a box may have changed its permissions)" >&2; return 1 ;; esac
    while IFS= read -r c; do
      [ -n "$c" ] && [ -f "$c/config" ] || continue
      mwt="$(_git_cfg --file "$c/config" --get core.worktree)" || return 1
      if [ -n "$mwt" ]; then
        case "$mwt" in /*) ;; *) mwt="$c/$mwt" ;; esac
        mwt="$(realpath -ms -- "$mwt")"
        _git_guard_pointer "$mwt/.git" || return 1
      fi
      _git_guard_common "$c" "$mwt" || return 1
    done < <(printf '%s\n' "$m" | sort -u)
  fi
}
if [ "$AIRLOCK_GIT_RO" = 1 ]; then
  for _r in "${_git_roots_c[@]}"; do
    if ! _git_guard_root "$_r" 2>"$STATE_DIR/git-ro.err"; then
      echo "claude-airlock: $(tail -n 1 "$STATE_DIR/git-ro.err"); not launching. A box may have planted it: inspect, fix it on the host, relaunch (AIRLOCK_GIT_RO=0 skips this guard)." >&2
      exit 1
    fi
  done
  rm -f "$STATE_DIR/git-ro.err"
fi

# Broad read-only roots (host-set AIRLOCK_ROOTS) for cross-project inspection, under
# /roots/<name>. Kept off the real-path tree on purpose: nesting a read-write child
# inside a read-only parent mount can't be set up by the container runtime. Empty by
# default — prefer targeted per-project `share =` folders above.
IFS=': ' read -r -a roots <<< "$AIRLOCK_ROOTS"
for r in "${roots[@]}"; do
  [ -z "$r" ] && continue
  [ -d "$r" ] || continue
  [ "$r" = "$WORKSPACE" ] && continue
  if ! _rwhy="$(_airlock_protected_check "$(readlink -f "$r")" 2>&1)"; then
    echo "claude-airlock: AIRLOCK_ROOTS entry $r: $_rwhy; not mounted." >&2
    continue
  fi
  args+=( -v "$r:/roots/$(basename "$r"):ro" )
done

# Live-share THIS project's sessions + memory with host Claude (nothing else).
#
# Transcripts MUST be read-write: the box's Claude records its own session here, and
# that is what makes `--resume` work in and out of the box. There is no read-only
# variant of that — a box that cannot write its transcript cannot hold a session.
#
# memory/ carries a KNOWN, ACCEPTED RISK — read this before changing the default.
#
# The host's Claude auto-loads this project's memories into its context every session,
# unprompted. Mounted read-write, memory/ is therefore a persistent influence channel out
# of the sandbox: a compromised box could write a memory file that the UNSANDBOXED host
# agent later reads and acts on, with your real credentials and no egress firewall. It
# sidesteps containment without touching the network — it just writes a file you have
# already told the host to trust. The egress firewall cannot see this and will not stop it.
#
# It is nonetheless READ-WRITE BY DEFAULT, deliberately. The box is the primary
# workspace, not the exception; making memory read-only would mean the agent can never
# SAVE a memory where you actually do the work, so memories would silently evaporate at
# session end and the feature would be dead. A safety default that gets switched off on
# day two buys nothing. We take the friction win and document the exposure.
#
# Tighten it per-project (or globally) when the code is untrusted:
#   ro  — box reads your memories, cannot author them  (closes the channel)
#   off — box neither reads nor writes them; it gets empty container-local storage
AIRLOCK_SHARE_MEMORY="${AIRLOCK_SHARE_MEMORY:-rw}"
case "$AIRLOCK_SHARE_MEMORY" in
  ro|rw|off) ;;
  *) echo "claude-airlock: AIRLOCK_SHARE_MEMORY must be ro|rw|off (got '$AIRLOCK_SHARE_MEMORY')." >&2; exit 1 ;;
esac

if [ "$AIRLOCK_SHARE_HISTORY" = "1" ]; then
  HOST_PROJ="$HOME/.claude/projects/$HISTSLUG"
  BOX_PROJ="/home/dev/.claude/projects/$HISTSLUG"
  mkdir -p "$HOST_PROJ"
  # No symlinks in the shared directory, ever. Host Claude auto-loads memory/ and
  # follows symlinks when it does (measured: a MEMORY.md pointing outside the directory
  # was loaded verbatim), and the host writes its transcript back into this same
  # directory. So a box that turns memory/MEMORY.md into a symlink to ~/.ssh/id_ed25519
  # gets the key read into the host's context and handed back through the transcript -
  # exfiltration with no network, which the egress firewall cannot see. The host `claude`
  # wrapper runs the same check before every host session; this one catches a planted
  # link before the NEXT box can build on it, and at the moment the operator is looking.
  # Refused, not deleted: a link here is either an attack, in which case you want to know,
  # or something you did on purpose, in which case it is not ours to remove.
  _links="$(find "$HOST_PROJ" -type l 2>/dev/null)"
  if [ -n "$_links" ]; then
    echo "claude-airlock: refusing to start: symlink(s) in the shared session directory" >&2
    echo "  $HOST_PROJ" >&2
    printf '%s\n' "$_links" | sed 's/^/    /' >&2
    echo "  Host Claude follows symlinks when it loads this project's memory, so a box that" >&2
    echo "  planted one can make the host read any file you can. Remove them, then relaunch." >&2
    exit 1
  fi
  args+=( -v "$HOST_PROJ:$BOX_PROJ:rw" )

  # Layer memory/ on top of the rw project mount. A read-only child inside a read-write
  # parent is fine (it's the reverse — rw child under an ro parent — the runtimes refuse).
  case "$AIRLOCK_SHARE_MEMORY" in
    ro)
      mkdir -p "$HOST_PROJ/memory"
      args+=( -v "$HOST_PROJ/memory:$BOX_PROJ/memory:ro" ) ;;
    off)
      # Shadow the host's memories with empty container-local storage: the box neither
      # reads nor writes them, but Claude still has a working memory dir of its own.
      mkdir -p "$STATE_DIR/box-memory"
      args+=( -v "$STATE_DIR/box-memory:$BOX_PROJ/memory:rw" ) ;;
    rw) : ;;   # inherited read-write from the parent mount — the box can author host memories
  esac
fi

# Git identity: the box has no ~/.gitconfig, so supply the host's global
# user.name/email as the box's GLOBAL git config, so commits are attributed
# correctly. A repo's own local .git/config still wins (it's in the mounted repo).
# In proxy mode, also the proxy's plain-HTTP git hosts (its client manifest): their remotes
# become http://<host>/ in the box only, so the box's git goes through the proxy, which adds
# the credential and does the TLS, while the repo's config (the host's git reads it too)
# keeps its ssh or https URLs. AIRLOCK_GIT_SSH_PORTS: ssh ports besides the default that
# remotes name (ssh://git@host:PORT/...), each rewritten too.
GIT_NAME="${AIRLOCK_GIT_NAME:-$(git config --global user.name 2>/dev/null || true)}"
GIT_EMAIL="${AIRLOCK_GIT_EMAIL:-$(git config --global user.email 2>/dev/null || true)}"
_git_ssh_ports=()
read -ra _gp <<< "${AIRLOCK_GIT_SSH_PORTS:-}"
for _p in "${_gp[@]}"; do
  if [[ "$_p" =~ ^[1-9][0-9]{0,4}$ ]] && [ "$_p" -le 65535 ]; then _git_ssh_ports+=( "$_p" )
  else echo "claude-airlock: ignoring AIRLOCK_GIT_SSH_PORTS entry '$_p' (want a port number)" >&2; fi
done
{ if [ -n "$GIT_NAME$GIT_EMAIL" ]; then
    echo "[user]"
    if [ -n "$GIT_NAME" ]; then printf '\tname = %s\n' "$GIT_NAME"; fi
    if [ -n "$GIT_EMAIL" ]; then printf '\temail = %s\n' "$GIT_EMAIL"; fi
  fi
  while IFS= read -r _h; do
    [ -n "$_h" ] || continue
    printf '[url "http://%s/"]\n' "$_h"
    printf '\tinsteadOf = %s\n' "https://$_h/" "https://$_h:443/" "git@$_h:" "$_h:" "ssh://git@$_h/" "ssh://git@$_h:22/" \
      "ssh://$_h/" "git+ssh://git@$_h/" "git://$_h/"
    for _p in "${_git_ssh_ports[@]}"; do printf '\tinsteadOf = ssh://git@%s:%s/\n' "$_h" "$_p"; done
  done < <(_airlock_client_git_hosts)
} > "$STATE_DIR/gitconfig.tmp.$$"
if [ -s "$STATE_DIR/gitconfig.tmp.$$" ]; then
  (umask 077; mkdir -p "$BOX_CFG")
  mv -f "$STATE_DIR/gitconfig.tmp.$$" "$BOX_CFG/gitconfig"
  args+=( -v "$BOX_CFG/gitconfig:/home/dev/.gitconfig:rw" )
fi
rm -f "$STATE_DIR/gitconfig.tmp.$$"

# Inject per-project secrets (host-controlled grant) as env into the box. pass:
# refs resolve here via `pass show` — if pass/gpg is locked it prompts, and on
# failure we exit asking you to unlock. The box gets values, never the store.
SECRETS_FILE="$STATE_DIR/secrets"
if [ -f "$SECRETS_FILE" ]; then
  while IFS= read -r _sline || [ -n "$_sline" ]; do
    _sline="${_sline%%#*}"
    case "$_sline" in *=*) ;; *) continue ;; esac
    _skey="$(printf '%s' "${_sline%%=*}" | tr -d '[:space:]')"
    case "$_skey" in ''|*[!A-Za-z0-9_]*) continue ;; esac
    if _airlock_secret_reserved "$_skey"; then
      echo "claude-airlock: ignoring secret $_skey: AIRLOCK_* and *_PROXY are reserved (airlock secret rm $_skey)" >&2
      continue
    fi
    _sval="$(printf '%s' "${_sline#*=}" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    case "$_sval" in
      pass:*)
        if _airlock_secret_denied "${_sval#pass:}"; then
          echo "claude-airlock: secret $_skey names '${_sval#pass:}', which matches AIRLOCK_SECRET_DENY;" >&2
          echo "  refusing to start. Remove it: airlock secret rm $_skey" >&2
          exit 1
        fi
        _resolved="$(pass show "${_sval#pass:}" </dev/null 2>/dev/null | head -n1)"
        if [ -z "$_resolved" ]; then
          echo "claude-airlock: could not resolve secret $_skey via 'pass show ${_sval#pass:}'." >&2
          echo "  Unlock your password store first (run: pass show ${_sval#pass:}), then relaunch." >&2
          exit 1
        fi
        printf '%s=%s\n' "$_skey" "$_resolved" >> "$ENV_FILE" ;;   # into the 0600 env-file, not argv
      "") : ;;
      *) printf '%s=%s\n' "$_skey" "$_sval" >> "$ENV_FILE" ;;      # into the 0600 env-file, not argv
    esac
  done < "$SECRETS_FILE"
fi

# gh, when the proxy serves api.github.com by plain HTTP with a credential: a box-only gh
# config sends gh's requests over the proxy socket itself (gh's http_unix_socket, plain HTTP
# there), with a placeholder token the proxy replaces with the real one. Read-only: the
# launcher owns it. Without a credential there is nothing to replace the placeholder, which
# GitHub would refuse even on public endpoints, and gh won't run without a token: not set up.
_gh_line="$(awk '$1 == "api.github.com"' <<< "$_CLIENT_HOSTS")"
if [ -n "$_gh_line" ] && [ "${_gh_line##* }" != yes ]; then
  echo "claude-airlock: the proxy has no credential for api.github.com, so gh is not set up for it" >&2
elif [ -n "$_gh_line" ]; then
  (umask 077; mkdir -p "$BOX_CFG/gh")
  { echo "# Written by claude-airlock for this box: gh speaks plain HTTP over the proxy socket."
    echo "version: 1"
    echo "git_protocol: https"
    printf "http_unix_socket: '%s'\n" "${EGRESS_PROXY//\'/\'\'}"
  } > "$BOX_CFG/gh/config.yml"
  # No telemetry or update checks: they would only reach the proxy and be refused.
  args+=( -v "$BOX_CFG/gh:/etc/airlock-box/gh:ro" -e "GH_CONFIG_DIR=/etc/airlock-box/gh"
          -e GH_TELEMETRY=0 -e GH_NO_UPDATE_NOTIFIER=1 )
  # A GH_TOKEN secret is left to win (and named below); otherwise the placeholder.
  grep -qE '^GH_TOKEN=' "$ENV_FILE" || args+=( -e "GH_TOKEN=airlock-proxy-adds-the-credential" )
  _gh_rules="$(awk '{ print $2 }' <<< "$_gh_line")"
  if [ "$_gh_rules" != github-api ]; then
    echo "claude-airlock: gh: api.github.com has the $_gh_rules rules on this proxy, so writes beyond them (PR create or edit, for github-issues) get 403" >&2
  fi
fi
# tea, for each Forgejo host the proxy serves (forgejo rules) with a credential: a box-only login
# at http://<host>, through the proxy, which replaces the placeholder token with the bot's. tea
# matches a repo's remote to a login by host (ssh_host covers ssh remotes on any port). tea has
# no config-path option and reads only ~/.config/tea, which the image doesn't have: mounted
# read-only here, the entrypoint copies it into place for dev (an image without that step just
# has no tea login).
_fj_hosts=()
while IFS= read -r _h; do [ -n "$_h" ] && _fj_hosts+=( "$_h" ); done \
  < <(awk '$2 == "forgejo" && $3 == "yes" { print $1 }' <<< "$_CLIENT_HOSTS")
while IFS= read -r _h; do
  [ -n "$_h" ] && echo "claude-airlock: the proxy has no credential for $_h, so tea is not set up for it" >&2
done < <(awk '$2 == "forgejo" && $3 != "yes" { print $1 }' <<< "$_CLIENT_HOSTS")
if [ "${#_fj_hosts[@]}" -gt 0 ]; then
  (umask 077; mkdir -p "$BOX_CFG/tea")
  { echo "# Written by claude-airlock for this box: tea speaks plain HTTP through the proxy, which"
    echo "# adds the credential (the token here is a placeholder)."
    echo "logins:"
    _fj_def=true
    for _h in "${_fj_hosts[@]}"; do
      printf -- '- name: %s\n  url: http://%s\n  token: airlock-proxy-adds-the-credential\n  default: %s\n  ssh_host: %s\n' \
        "$_h" "$_h" "$_fj_def" "$_h"
      _fj_def=false
    done
  } > "$BOX_CFG/tea/config.yml"
  args+=( -v "$BOX_CFG/tea:/etc/airlock-box/tea:ro" )
fi

# kubectl, for each Kubernetes API server the proxy serves (kubernetes-read rules) with a
# credential: a box-only kubeconfig at http://<host>, through the proxy, which adds the token. It
# names no user and holds no token. Read-only: the launcher owns it. A KUBECONFIG secret is left
# to win (and named).
_kube_hosts=()
while IFS= read -r _h; do [ -n "$_h" ] && _kube_hosts+=( "$_h" ); done \
  < <(awk '$2 == "kubernetes-read" && $3 == "yes" { print $1 }' <<< "$_CLIENT_HOSTS")
while IFS= read -r _h; do
  [ -n "$_h" ] && echo "claude-airlock: the proxy has no credential for $_h, so kubectl is not set up for it" >&2
done < <(awk '$2 == "kubernetes-read" && $3 != "yes" { print $1 }' <<< "$_CLIENT_HOSTS")
if [ "${#_kube_hosts[@]}" -gt 0 ] && grep -qE '^KUBECONFIG=' "$ENV_FILE"; then
  echo "claude-airlock: the proxy adds the Kubernetes token for ${_kube_hosts[*]}, yet a KUBECONFIG secret is set and used instead (airlock secret rm KUBECONFIG)" >&2
elif [ "${#_kube_hosts[@]}" -gt 0 ]; then
  (umask 077; mkdir -p "$BOX_CFG/kube")
  { echo "# Written by claude-airlock for this box: kubectl speaks plain HTTP through the proxy, which"
    echo "# adds the token (none here)."
    echo "apiVersion: v1"
    echo "kind: Config"
    echo "clusters:"
    for _h in "${_kube_hosts[@]}"; do printf -- '- name: %s\n  cluster:\n    server: http://%s\n' "$_h" "$_h"; done
    echo "contexts:"
    for _h in "${_kube_hosts[@]}"; do printf -- '- name: %s\n  context:\n    cluster: %s\n    user: airlock-proxy\n' "$_h" "$_h"; done
    printf 'current-context: %s\n' "${_kube_hosts[0]}"
    echo "users:"
    echo "- name: airlock-proxy"
    echo "  user: {}"
  } > "$BOX_CFG/kube/config"
  args+=( -v "$BOX_CFG/kube:/etc/airlock-box/kube:ro" -e "KUBECONFIG=/etc/airlock-box/kube/config" )
fi

# With the proxy holding credentials, a GitHub token among the secrets puts one in the box
# anyway: named by key (GitHub-ish names) or by value (GitHub's token prefixes), never shown.
if grep -q ' yes$' <<< "$_CLIENT_HOSTS"; then
  _gh_tok="$(awk -F= '{ k = $1; v = substr($0, length($1) + 2) }
    toupper(k) ~ /(^|_)(GH|GITHUB|GIT)_([A-Z0-9_]*_)?(TOKEN|PAT)$/ || v ~ /^(ghp_|gho_|ghs_|ghu_|ghr_|github_pat_)/ { printf "%s ", k }' "$ENV_FILE")"
  if [ -n "$_gh_tok" ]; then
    echo "claude-airlock: the proxy adds credentials, yet secret(s) ${_gh_tok% } look like a GitHub token and put one in the box (airlock secret rm ...)" >&2
  fi
fi

[ -n "$AIRLOCK_MODEL" ] && args+=( -e "ANTHROPIC_MODEL=$AIRLOCK_MODEL" )
args+=( -e "AIRLOCK_HOST_USER=$(id -un)" )   # whose box this is, for the status line (the box user is always dev)
[ -n "${AIRLOCK_EXTRA_EGRESS:-}" ] && args+=( -e "AIRLOCK_EXTRA_EGRESS=$AIRLOCK_EXTRA_EGRESS" )
args+=( -e "AIRLOCK_EGRESS_GROUPS=$AIRLOCK_EGRESS_GROUPS" )   # host-set egress posture (minimal / dev / group subset)

# Starting permission mode, passed through to Claude. Precedence, most-specific first:
#   1. an explicit --permission-mode on the command line (handled below — it always wins;
#      a stored default must never override what you just typed)
#   2. AIRLOCK_PERMISSION_MODE — a per-INVOCATION override (the one-shot flag a broker uses
#      to dispatch ONE worker in `auto` without changing the repo's persistent setting)
#   3. the stored per-project default (`airlock mode <x>`)
# So the env beats the stored file: "override for this launch only" is exactly its job.
# (In headless `-p` dispatch the mode is moot — `-p` auto-approves regardless — so this
# matters for INTERACTIVE dispatch, e.g. watching a worker run in auto.)
# Validated below, so a stale/hand-edited state file can't launch a box that dies on a bad flag.
claude_args=()
# The `|| true` matters: under `set -e`, a failing command substitution (no stored-mode
# file — the common case) would abort the whole launch here.
PERMISSION_MODE="${AIRLOCK_PERMISSION_MODE:-$(cat "$STATE_DIR/permission-mode" 2>/dev/null || true)}"
if [ -n "$PERMISSION_MODE" ]; then
  case " $AIRLOCK_PERMISSION_MODES " in
    *" $PERMISSION_MODE "*) ;;
    *) echo "claude-airlock: ignoring invalid permission mode '$PERMISSION_MODE' (valid: $AIRLOCK_PERMISSION_MODES)" >&2
       PERMISSION_MODE="" ;;
  esac
fi
if [ -n "$PERMISSION_MODE" ]; then
  for _a in "$@"; do
    case "$_a" in --permission-mode|--permission-mode=*) PERMISSION_MODE="" ;; esac
  done
fi
# --permission-mode belongs to an interactive SESSION, not to `claude <subcommand>`
# (remote-control, mcp, setup-token, doctor, ...). Injecting it into a subcommand makes
# the mode value look like a stray positional and the subcommand dies — "Unknown argument:
# auto" — which reads as the subcommand being broken rather than the launcher adding a
# flag the caller never typed. A leading non-flag word is a subcommand; anything starting
# with '-' (or nothing at all) is a session.
case "${1:-}" in
  ''|-*) ;;
  *) PERMISSION_MODE="" ;;
esac
if [ -n "$PERMISSION_MODE" ]; then
  claude_args+=( --permission-mode "$PERMISSION_MODE" )
fi

# A terminal only when there is one: a run from a script or a service unit (`claude -p`,
# `airlock exec`) has none, and the engine refuses -t then.
if [ -t 0 ] && [ -t 1 ]; then args+=( -t ); fi
# An exec'd command is the box's PID 1, where a signal with no handler is ignored: stopping
# the unit that ran it would wait out its timeout and leave the box running. An init (the
# engine's own: catatonit under podman, docker-init under docker) passes signals on and reaps.
[ ${#AIRLOCK_EXEC[@]} -eq 0 ] || args+=( --init )

# --- Network and DNS (shared with the doctor's box: lib/host-dns.sh) ---------------
# Assembled here, after every prompt and guard, because it asks podman and pasta what
# they support (a query, not a box). Only the share/socket re-checks come later: they
# must stay the last thing before the run.
# shellcheck disable=SC1091  # linted on its own (Makefile SHELL_SCRIPTS)
source "$_repo/lib/host-dns.sh"
# The image must be installed for this account: an account can hold base without dev (a
# bundle reader on base loads no dev). Left to the run, a missing image becomes a registry
# pull, refused or opaque. The same query answers the proxy posture's label check below.
if ! _img_proxy="$("$AIRLOCK_ENGINE" image inspect --format '{{index .Config.Labels "org.claude-airlock.egress-proxy"}}' "$AIRLOCK_IMAGE" 2>/dev/null)"; then
  echo "claude-airlock: $AIRLOCK_IMAGE is not installed for this account." >&2
  echo "  Install it (make install-airlock, or from a bundle: set AIRLOCK_IMAGE to it in this account's" >&2
  echo "  config and run install-bundle.sh again), or run another image." >&2
  exit 1
fi
if [ -n "$EGRESS_PROXY" ]; then
  # No interfaces but loopback, and no resolver: the proxy socket is the only way out.
  # The entrypoint refuses to start Claude if it finds any other interface.
  args+=( --network=none )
  # An image from before this posture would try to raise the firewall without the
  # capabilities for it and die with a confusing error; say what is actually wrong.
  if [ "$_img_proxy" != 1 ]; then
    echo "claude-airlock: $AIRLOCK_IMAGE predates the proxy posture (no socket bridge in its entrypoint)." >&2
    echo "  Rebuild the images (make install-airlock), or pick another posture: airlock egress minimal" >&2
    exit 1
  fi
elif [ "$AIRLOCK_ENGINE" = podman ]; then
  case "$AIRLOCK_PODMAN_NETWORK" in pasta|pasta:*|'') airlock_podman_probe ;; esac  # once
  # pasta maps 169.254.1.2 (host.containers.internal) to the host: from the box it
  # reaches any host service bound to 0.0.0.0 - a dev server, Postgres, an MCP server,
  # `podman system service` (measured: a listener on 0.0.0.0 answered, one on 127.0.0.1
  # did not). Until now the in-box firewall was the ONLY thing between the box and that
  # address. `--map-guest-addr none` removes the mapping in pasta itself, so a firewall
  # that failed to come up, or a rule that was talked into allowing it (`egress =
  # 169.254.1.2:22` is a bare IP in the approval prompt), has nothing to reach. Verified:
  # with it, the address times out with the firewall down, and DNS, the firewall's
  # self-test and api.anthropic.com still work with it up. The cost is
  # host.containers.internal, which nothing in airlock uses. podman already passes
  # --no-map-gw (the gateway address never reached the host) and forwards no ports.
  # slirp4netns needs nothing here: podman's allow_host_loopback defaults to false.
  args+=( "$(airlock_podman_network_arg "$AIRLOCK_PODMAN_NETWORK")" )
fi

# DNS: point the box at the network stack's forwarder to the host resolver, and tell the
# firewall which public resolvers the host actually chose. Without both, a loopback-only
# host resolver makes the engine fall back to Google Public DNS (see lib/host-dns.sh).
# A proxy-mode box has no resolver to reach: the proxy resolves.
if [ -z "$EGRESS_PROXY" ]; then
  while IFS= read -r _ns; do
    if [ -n "$_ns" ]; then args+=( "--dns=$_ns" ); fi
  done < <(airlock_dns_forwarders "$AIRLOCK_ENGINE" "$AIRLOCK_PODMAN_NETWORK")
  args+=( -e "AIRLOCK_HOST_DNS=$(airlock_host_nameservers)" )
fi

# From here this session has actually MOUNTED the project's shared directories, so its
# cleanup may remove them if it turns out to be the last one out. Before this point a run
# that exits - a declined concurrent-session prompt, a rejected egress entry - mounted
# nothing, and must not rmdir a directory some other kind of session is using. "No
# registered peers" is not "nobody there": the lock format is deliberately shared with a
# raw host `claude`, which uses $AIRLOCK_TMP under the same name. The wrapper registers
# in sessions/ via `airlock session`, so it IS counted - but only if that call succeeded,
# which is why its failure is reported rather than swallowed.
# Granted sockets were checked while the launch was assembled, and prompts may have run
# since. Re-check each and require the same device, inode, change time (to the
# nanosecond), owner and mode right before the engine starts; any change aborts the launch rather than
# mounting something that was never approved. The inode number alone is not enough: a
# filesystem may hand a deleted socket's inode number straight to its replacement.
# This proves identity in the host's mount namespace. Rootless podman resolves -v in its
# own namespace, where a process running as you could bind-mount over the path; the box
# cannot reach that namespace (no host podman, unshare/setns refused by seccomp), so this
# only matters against something already running as you on the host.
for _kp in "${_ksock_pins[@]}"; do
  _kpath="${_kp#* }"
  if ! _kwhy="$(_airlock_socket_check "$_kpath" 2>&1)" \
      || [ "$(stat -c %d:%i:%.9Z:%u:%f "$_kpath" 2>/dev/null)" != "${_kp%% *}" ]; then
    echo "claude-airlock: socket $_kpath changed after it was checked (${_kwhy:-different inode, change time, owner or mode}); not launching" >&2
    exit 1
  fi
done

# Shares too: re-run every check and require the same directory, so a path swapped for a
# symlink while a prompt or pinentry waited is never mounted. -v still resolves the path
# again, so this narrows the window to the time between here and the engine's own lookup.
for _kp in "${SHARE_PINS[@]}"; do
  _ks="${_kp#* }"
  if ! _kreal="$(_airlock_share_check "$_ks" 2>/dev/null)" \
      || [ "$(stat -c %d:%i "$_kreal" 2>/dev/null)" != "${_kp%% *}" ]; then
    echo "claude-airlock: share $_ks changed after it was checked; not launching" >&2
    exit 1
  fi
done

# The paste dir the same way.
if [ -n "$_paste_pin" ]; then
  _kpath="${_paste_pin#* }"
  if ! _airlock_paste_dir_check "$_kpath" >/dev/null 2>&1 \
      || [ "$(stat -c %d:%i "$_kpath" 2>/dev/null)" != "${_paste_pin%% *}" ]; then
    echo "claude-airlock: the paste dir $_kpath changed after it was checked; not launching" >&2
    exit 1
  fi
fi

# The extra mounts the same way.
for _kp in "${_extra_pins[@]}"; do
  _kpath="${_kp#* }"
  if ! _airlock_extra_mount_check "$_kpath" >/dev/null 2>&1 \
      || [ "$(stat -c %d:%i "$_kpath" 2>/dev/null)" != "${_kp%% *}" ]; then
    echo "claude-airlock: the extra mount $_kpath changed after it was checked; not launching" >&2
    exit 1
  fi
done

MOUNTED=1
if [ ${#AIRLOCK_EXEC[@]} -gt 0 ]; then
  "$AIRLOCK_ENGINE" run "${args[@]}" "$AIRLOCK_IMAGE" "${AIRLOCK_EXEC[@]}"
elif [ "$AIRLOCK_SHELL" = 1 ]; then
  "$AIRLOCK_ENGINE" run "${args[@]}" "$AIRLOCK_IMAGE" bash -l
else
  "$AIRLOCK_ENGINE" run "${args[@]}" "$AIRLOCK_IMAGE" claude "${claude_args[@]}" "$@"
fi
