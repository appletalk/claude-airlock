#!/usr/bin/env bash
# update-runsc: install or update gVisor (runsc) from Google's release bucket, for boxes that run
# under it (docs/gvisor.md). Root; `make install-agents` runs it, or run it by hand.
#
#   sudo update-runsc            install, update to the latest release, or repair an installed
#                                copy that no longer matches what was installed
#   sudo update-runsc --check    say whether anything is waiting; exit 10 if so
#   sudo update-runsc --first    install when nothing is installed, else only --check (what
#                                install-agents runs: it never replaces a runtime on its own)
#   sudo update-runsc --force    go ahead even while gVisor boxes are running
#
# It tracks the latest release. Most distributions don't package gVisor, so it comes from
# upstream: the tarball, never the loose binaries (upstream stopped publishing those while the
# tarball kept moving; fetching them installs a stale build, checksum-verified and exit 0). The
# checksum file is fetched first, so an unchanged upstream costs a few bytes rather than a 120 MB
# download. Every change is logged to $LOG.
#
# The checksum comes from the same bucket as the tarball: it proves the download is intact, not
# who published it.
#
# The installed binaries are never run as root here (the agent users run boxes under runsc; one
# they could change must not become root's code). What is installed is known from $STATE: the
# tarball's checksum, the release, and each file's sha256. A file that no longer matches that
# record, or that anyone but root can write, counts as not installed: the next run reinstalls it.
#
# Running boxes: a gVisor box holds runsc open and keeps working after it is replaced, but the
# box's later stop and cleanup run the new runsc against state the old one made. It refuses
# while any are running (checked before the download and again before the files are replaced);
# stop them first, or pass --force. Boxes that are created but stopped aren't seen: remove them.
set -euo pipefail
umask 022

ROOT="${AIRLOCK_RUNSC_ROOT:-}"   # test hook: file paths go under it (commands are stubbed); never set in use
ARCH="$(uname -m)"
URL="https://storage.googleapis.com/gvisor/releases/release/latest/${ARCH}"
DEST="$ROOT/usr/local/bin"
STATE="$ROOT/var/lib/claude-airlock/update-runsc.state"
LOG="$ROOT/var/log/update-runsc.log"
# What the tarball may hold: the runtime and its containerd shim, and gVisor's helpers in their
# own directory (never anything else on root's PATH).
allowed() { case "$1" in runsc|containerd-shim-runsc-v1|gvisor-bin/[A-Za-z0-9]*) [[ "$1" =~ ^[A-Za-z0-9/._-]+$ && "$1" != *..* ]] ;; *) false ;; esac; }
die() { echo "update-runsc: $*" >&2; exit 1; }

mode=update force=0
for a in "$@"; do
    case "$a" in
        --check) mode=check ;;
        --first) mode=first ;;
        --force) force=1 ;;
        -h|--help) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
        *) echo "usage: ${0##*/} [--check | --first] [--force]" >&2; exit 2 ;;
    esac
done
[ -n "$ROOT" ] || [ "$EUID" -eq 0 ] || die "run as root: sudo ${0##*/}"
cmd="sudo ${0##*/}"

# The release and the sha512 the record names, and whether every recorded file is in place as
# installed: a regular file, root's (outside the test root), mode 0755, the recorded sha256.
rec() { [ -f "$STATE" ] && awk -v k="$1" '$1 == k { print $2; exit }' "$STATE"; }
intact() {
    local sum rel f n=0
    [ -f "$STATE" ] || return 1
    while read -r _ sum rel; do
        f="$DEST/$rel"; n=$((n + 1))
        allowed "$rel" && [ -f "$f" ] && [ ! -L "$f" ] && [ "$(stat -c %a "$f")" = 755 ] || return 1
        [ -n "$ROOT" ] || [ "$(stat -c %u "$f")" = 0 ] || return 1
        [ "$(sha256sum < "$f" | cut -d' ' -f1)" = "$sum" ] || return 1
        # its own directory below $DEST (gvisor-bin/): root's 0755 too
        if [ "$(dirname "$f")" != "$DEST" ]; then
            [ ! -L "$(dirname "$f")" ] && [ "$(stat -c %a "$(dirname "$f")")" = 755 ] || return 1
            [ -n "$ROOT" ] || [ "$(stat -c %u "$(dirname "$f")")" = 0 ] || return 1
        fi
    done < <(awk '$1 == "file"' "$STATE")
    [ "$n" -gt 0 ] && [ -n "$(rec release)" ]
}
# gVisor box processes: the sandbox re-executes runsc as runsc-sandbox, its file proxy as
# runsc-gofer. pgrep exits 1 for none; anything else means it can't tell, which is a stop.
boxes() {
    local n rc=0
    command -v pgrep >/dev/null || die "pgrep is missing: can't tell whether gVisor boxes are running"
    n="$(pgrep -c -f '^runsc-(sandbox|gofer)( |$)')" || rc=$?
    case "$rc" in 0|1) echo "${n:-0}" ;; *) die "pgrep failed (exit $rc): can't tell whether gVisor boxes are running" ;; esac
}
no_boxes() {
    local n; n="$(boxes)"
    [ "$n" -gt 0 ] || return 0
    [ "$force" = 1 ] || die "$n gVisor box process(es) running. Stop the boxes first (the agents' sessions: <command> stop, and web stop with web research), then run it again; or pass --force"
    echo "update-runsc: WARNING: $n gVisor box process(es) running; replacing runsc under them (--force)" >&2
}

recorded="$(rec release || true)"     # what the record says, for the log
installed="$recorded"
if [ -n "$installed" ] && ! intact; then
    echo "installed: $installed, but the files no longer match the record (a plain run reinstalls them)"
    installed=""
fi
echo "installed: ${installed:-none}"
# --first installs only onto nothing: a runsc or a record already there (as installed, or changed
# since, or put there by hand) is only checked; a repair or an update is a run of its own.
present=0
if [ -n "$recorded" ] || [ -e "$DEST/runsc" ] || [ -L "$DEST/runsc" ]; then present=1; fi
if [ "$mode" = first ] && [ "$present" = 1 ]; then mode=check; fi

# Work in a directory of root's beside the record (a noexec /tmp would stop the version run). One
# run at a time; then whatever a killed run left (its download, staged files) can go.
install -d -m 0755 "$(dirname "$STATE")"
exec 9> "$(dirname "$STATE")/update-runsc.lock"
flock -n 9 || die "another update-runsc is running"
find "$(dirname "$STATE")" -maxdepth 1 -name 'tmp.*' -exec rm -rf -- {} + 2>/dev/null || true
find "$DEST" -name '*.update-runsc.*' -delete 2>/dev/null || true
tmp="$(mktemp -d "$(dirname "$STATE")/tmp.XXXXXX")"
# Also sweep staged files an interrupted install left behind.
trap 'rm -rf "$tmp"; find "$DEST" -name "*.update-runsc.$$" -delete 2>/dev/null || true' EXIT

fetch() { curl -fsSL --proto '=https' --proto-redir '=https' --retry 3 -o "$tmp/$1" "$URL/$1" || die "could not fetch $1 from $URL"; }
fetch gvisor.tar.zstd.sha512
remote_sum="$(awk '{ print $1; exit }' "$tmp/gvisor.tar.zstd.sha512")"
[[ "$remote_sum" =~ ^[0-9a-f]{128}$ ]] || die "the checksum file from $URL is not a sha512"

if [ -n "$installed" ] && [ "$remote_sum" = "$(rec tarball || true)" ]; then
    echo "up to date: the upstream tarball is unchanged since the last install"
    exit 0
fi
if [ "$mode" = check ]; then
    if [ -n "$installed" ]; then echo "update available: the upstream tarball differs from the last install ($cmd)"
    elif [ "$present" = 1 ]; then echo "the runsc in $DEST doesn't match this script's record ($cmd reinstalls it)"
    else echo "runsc is not installed ($cmd installs it)"; fi
    exit 10
fi

no_boxes
fetch gvisor.tar.zstd
[ "$(sha512sum < "$tmp/gvisor.tar.zstd" | cut -d' ' -f1)" = "$remote_sum" ] \
    || die "the tarball does not match its checksum; nothing installed"

mkdir -m 0700 "$tmp/new"
tar --zstd -xf "$tmp/gvisor.tar.zstd" -C "$tmp/new" --no-same-owner || die "could not unpack the tarball (is zstd installed?)"
chmod -R go-w "$tmp/new"
files=()
while IFS= read -r -d '' p; do
    rel="${p#"$tmp/new/"}"
    [ -d "$p" ] && [ ! -L "$p" ] && continue
    if ! { [ -f "$p" ] && [ ! -L "$p" ] && allowed "$rel"; }; then
        die "the tarball holds $rel, which isn't runsc, its shim or a gvisor-bin/ helper; nothing installed"
    fi
    files+=("$rel")
done < <(find "$tmp/new" -mindepth 1 -print0)
[ -f "$tmp/new/runsc" ] || die "the tarball has no runsc; nothing installed"

# The new release's name, from the new binary, run as nobody: the checksum shows the download is
# intact, not whose it is, so it doesn't run as root before it is installed. A copy of runsc alone
# is reachable for nobody (the unpacked tree stays root's).
mkdir -m 0755 "$tmp/ver" && cp "$tmp/new/runsc" "$tmp/ver/runsc" && chmod 0755 "$tmp/ver/runsc"
chmod 0711 "$tmp"
ver="$(cd / && setpriv --reuid=65534 --regid=65534 --clear-groups --no-new-privs "$tmp/ver/runsc" --version 2>"$tmp/ver.err")" || ver=""
candidate="$(awk '/^runsc version/ { print $3 }' <<< "$ver" | head -n 1)"
if ! [[ "$candidate" =~ ^[A-Za-z0-9._-]+$ ]]; then
    # its last line, printable characters only (it is the downloaded binary's text)
    why=""; [ ! -s "$tmp/ver.err" ] || why=" ($(tail -c 4096 "$tmp/ver.err" | tail -n 1 | tr -cd '[:print:]' | cut -c1-200))"
    die "the unpacked runsc reports no version$why; nothing installed"
fi

new_state="$tmp/state"
{
    echo "tarball $remote_sum"
    echo "release $candidate"
    for rel in "${files[@]}"; do echo "file $(sha256sum < "$tmp/new/$rel" | cut -d' ' -f1) $rel"; done
} > "$new_state"

# A new tarball can carry exactly the files in place (a rebuild): record it and leave them alone.
same=1
for rel in "${files[@]}"; do
    [ -n "$installed" ] && [ -f "$DEST/$rel" ] && cmp -s "$tmp/new/$rel" "$DEST/$rel" || same=0
done
install -d -m 0755 "$(dirname "$STATE")" "$(dirname "$LOG")"
if [ "$same" = 1 ] && [ "$candidate" = "$installed" ]; then
    install -m 0644 "$new_state" "$STATE.new" && mv -f "$STATE.new" "$STATE"
    printf '%s  %s: a new tarball with the same files, its checksum recorded\n' "$(date -Is)" "$candidate" >> "$LOG"
    echo "already on $candidate: checksum recorded, nothing installed"
    exit 0
fi

# Last look before anything changes: a box started during the download counts too.
no_boxes
# Stage each file beside its target and rename it over: a running sandbox holds runsc open for
# execution, so writing in place fails (ETXTBSY), while a rename publishes the new file whole and
# leaves running boxes on the old inode. Root-owned, 0755: the agent users run boxes under it.
for rel in "${files[@]}"; do
    dst="$DEST/$rel"
    install -d -m 0755 "$(dirname "$dst")"
    install -m 0755 "$tmp/new/$rel" "$dst.update-runsc.$$"
    mv -f "$dst.update-runsc.$$" "$dst"
done
install -m 0644 "$new_state" "$STATE.new" && mv -f "$STATE.new" "$STATE"
note=""
if [ -n "$recorded" ] && [ -z "$installed" ]; then note=" (reinstalled: the files no longer matched the record)"
elif [ -z "$recorded" ] && [ "$present" = 1 ]; then note=" (replaced a runsc with no record)"; fi
printf '%s  %s -> %s%s\n' "$(date -Is)" "${recorded:-none}" "$candidate" "$note" >> "$LOG"
echo "installed runsc $candidate (was ${recorded:-none})$note"
