                ws=${u%%:*}
                [ -z "${2:-}" ] || [ "$2" = "$ws" ] || continue
                echo "==> ${u#*:}, workspace ~/$ws: in the box, /login, then /exit"
                # shellcheck disable=SC2016  # expanded on that user's side
                ( AS=${u#*:}; oexec /bin/bash -c 'mkdir -p "$HOME/$1" && cd "$HOME/$1" && exec "$HOME/.local/bin/airlock"' bash "$ws" ) \
                    || echo "(${u#*:} ~/$ws: the box ended with an error)"
            done ;;
        stop)
            n="$(web_target stop "${2:-}")" || exit 1
            AS=$WEB octl stop "$WEB-session@$n.service" ;;
        restart)
            n="$(web_target restart "${2:-}")" || exit 1
            AS=$WEB fresh "$WEB-session@$n.service"
            AS=$WEB octl restart "$WEB-session@$n.service"
            echo "a fresh $WEB session $n: $CMD web $n" ;;
        new)
            # another interactive session, by name (a typo'd `<command> web <name>` never starts one)
            n="${2:-}"; name_ok "$n" || die "usage: $CMD web new <name> (letters, digits, - and _)"
            AS=$WEB fresh "$WEB-session@$n.service"
            AS=$WEB octl start "$WEB-session@$n.service"
            AS=$WEB oexec /usr/bin/tmux -S "$(wsock "$n")" attach ;;
        *)
            # attach: the named session if it runs; with no name the one running, else main,
            # started if needed
            n="$sub"
            if [ -z "$n" ]; then
                n="$(web_running)"
                [ "$(printf '%s' "$n" | grep -c .)" -le 1 ] || die "several $WEB sessions run ($(printf '%s' "$n" | tr '\n' ' ')): say which, $CMD web <name>"
                n="${n:-main}"
                AS=$WEB fresh "$WEB-session@$n.service"
                AS=$WEB octl start "$WEB-session@$n.service"
            else
                name_ok "$n" || die "unknown command or bad session name '$n' ($CMD --help)"
                web_running | grep -qx "$n" || die "no $WEB session $n is running (start one: $CMD web new $n)"
            fi
            AS=$WEB oexec /usr/bin/tmux -S "$(wsock "$n")" attach ;;
    esac
}

# ---- audit ------------------------------------------------------------------------------------
# The audit store (audit on: docs/agents.md, Audit), read through its socket, which the operator
# may connect to (queries only, vmauth refuses the rest). Every field in it is the agents' text
# (hosts, paths, TLS names): formatted as data, never as a query, and cleaned on the way out.
AUDIT_SOCK="${AGENTS_AUDIT_SOCK:-/run/airlock-audit/vl.sock}"   # test knob, like AGENTS_NODUMP_DIR
audit_ready() {
    [ "${AGENTS_AUDIT:-off}" = on ] || die "no audit store here (agents.conf: audit on, then sudo airlock-agents-apply --confirm)"
    [ -S "$AUDIT_SOCK" ] || die "the audit store's socket $AUDIT_SOCK is missing (sudo airlock-audit status)"
}
# audit denies: Envoy's own refusals, newest first, from one fixed query (no model). Each with
# who (user, listener), what (method and host, or the TLS name), the route and which site file
# line would change it. A refused TLS name carries no user: joined to the CONNECT that opened its
# tunnel (Envoy's connection id, the latest CONNECT before it: ids restart with Envoy).
audit_denies() {
    local since=24h limit=50 full=0 cutoff W
    while [ $# -gt 0 ]; do
        case "$1" in
            --since) [ $# -ge 2 ] || die "--since needs <n>d, <n>h or YYYY-MM-DD"; since=$2; shift ;;
            --limit) [ $# -ge 2 ] && [[ "$2" =~ ^([1-9][0-9]{0,2}|1000)$ ]] || die "--limit needs a number from 1 to 1000"; limit=$2; shift ;;
            --full) full=1 ;;
            *) die "usage: $CMD audit denies [--since <n>d|<n>h|YYYY-MM-DD] [--limit <n>] [--full]" ;;
        esac
        shift
    done
    cutoff="$(since_epoch "$since")"
    audit_ready
    set_cols
    python3 -I - "$AUDIT_SOCK" "$(date -u -d "@$cutoff" +%Y-%m-%dT%H:%M:%SZ)" "$limit" "$CMD" "$full" "$W" <<"PY" | clean
import datetime, json, re, subprocess, sys, unicodedata
sock, start, limit, cmd, full = sys.argv[1], sys.argv[2], int(sys.argv[3]), sys.argv[4], sys.argv[5] == "1"
width = int(sys.argv[6])

# Lines are fitted to the terminal here, by display width (a wide character takes two columns),
# as audit events does: the shell's cut counts bytes, and would split a character and drop the
# rest of a wrapped line.
def cols(c):
    return 2 if unicodedata.east_asian_width(c) in ("W", "F") else 1

def fit(s, w):
    out, n = [], 0
    for c in s:
        n += cols(c)
        if n > w:
            break
        out.append(c)
    return "".join(out)

def wrapped(s, w):   # s wrapped at spaces to w columns (display width), a word too long cut in pieces of w
    line, n = "", 0
    for word in s.split():
        while sum(map(cols, word)) > w:   # a word wider than a line: pieces of it
            if line:
                yield line
                line, n = "", 0
            piece = fit(word, w) or word[0]
            yield piece
            word = word[len(piece):]
        wn = sum(map(cols, word))
        if line and n + 1 + wn > w:
            yield line
            line, n = "", 0
        if word:
            line, n = (f"{line} {word}", n + 1 + wn) if line else (word, wn)
    if line:
        yield line

# Envoy's own refusals: a deny- route (CONNECT or plain HTTP outside the listener, an internal
# name asked of web), a TLS name no destination takes (NR) or an address entry refuses (RBAC), a
# push to a protected branch (the push check, UAEX: Envoy answers git with a 200 and a refusal in
# the pack status), an MCP tool the rules refuse (a 200 with a JSON-RPC error; every answer Envoy's
# Lua code makes on a box listener is a refusal), web failing to reach a name (UF, DF: its kernel filter refuses an internal
# address that way), and any 4xx/5xx Envoy answered itself (a preset's rules, a locked
# credential, a body too large, a request the parser rejected): not one passed on from upstream,
# not an upstream failure, not a timeout (a slow client or a long stream is no refusal).
# The store's Vector classifies each Envoy line at ingest (audit.kind); these rules are the same,
# kept for lines stored before that (until sudo airlock-audit reset reads them in again).
REFUSED = ('(audit.kind:in("envoy-refused","envoy-web-refused") or (audit.kind:"" '
           'log_type:in("envoy-access","envoy-web") (envoy.flags:NR or envoy.flags:UAEX '
           'or envoy.details:="lua_response" or envoy.details:~"^rbac_access_denied" or envoy.route:~"^deny-" '
           'or (log_type:envoy-web envoy.flags:~"UF|DF") '
           'or (envoy.status:>=400 -envoy.details:via_upstream '
           '-envoy.details:~"^(upstream_|no_healthy_upstream)" -envoy.details:~"timeout"))))')
FIELDS = ('_time, log_type, envoy.listener, envoy.user, envoy.connection, envoy.method, envoy.authority, '
          'envoy.path, envoy.sni, envoy.route, envoy.status, envoy.flags, envoy.details')

def printable(s, n):
    s = "".join(c if c.isprintable() else "?" for c in str(s))
    return s if len(s) <= n else s[:n - 3] + "..."

def query(q):
    p = subprocess.run(["curl", "-sS", "--max-time", "30", "--unix-socket", sock, "-w", "\n%{http_code}",
                        "http://x/select/logsql/query", "--data-urlencode", "query=" + q],
                       stdin=subprocess.DEVNULL, capture_output=True)
    body, _, code = p.stdout.decode("utf-8", "replace").rpartition("\n")
    if p.returncode != 0 or code != "200":
        why = (body or p.stderr.decode("utf-8", "replace")).strip()
        print(f"{cmd} audit denies: no answer from the audit store (curl {p.returncode}, HTTP {code or '-'}): "
              f"{printable(why, 300)}", file=sys.stderr)
        sys.exit(1)
    rows = []
    for line in body.splitlines():
        try:
            o = json.loads(line)
        except ValueError:
            continue
        if isinstance(o, dict):
            rows.append({k: v if isinstance(v, str) else json.dumps(v) for k, v in o.items()})
    return rows

def when(t):  # VictoriaLogs' RFC 3339 UTC time: a sort key, and the local time to show
    m = re.match(r"(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(?:\.(\d{1,9}))?Z$", t or "")
    if not m:
        return (0, 0), "?"
    d = datetime.datetime.strptime(m.group(1), "%Y-%m-%dT%H:%M:%S").replace(tzinfo=datetime.timezone.utc)
    return (int(d.timestamp()), int((m.group(2) or "0").ljust(9, "0"))), d.astimezone().strftime("%Y-%m-%d %H:%M:%S")

since = f"_time:>={start} "
# Repeats collapse (as in audit events): consecutive refusals alike in user, listener and every
# field Envoy logged for them (not the connection id) are one row with their count and when the
# run began, so one client retrying can't push the rest out of view. Up to FETCH lines are read
# for that; --limit counts rows.
FETCH = 10000
rows = query(f"{since}{REFUSED} | sort by (_time desc) | limit {FETCH} | fields {FIELDS}")
total = query(f"{since}{REFUSED} | stats count() n")
total = int(total[0].get("n", "0")) if total and total[0].get("n", "").isdigit() else len(rows)

# An SNI line (the TLS listener's, after a CONNECT) has no user or status of its own; an HTTP
# line always has both, a method or not (a request the parser rejected has none).
def is_sni(r):
    return r.get("log_type") == "envoy-access" and not r.get("envoy.user") and not r.get("envoy.status")

# Their users: the CONNECT that opened the tunnel, by Envoy's connection id. A TLS name is read
# within 15 s of the tunnel opening (the inspector's timeout), so only a CONNECT from 20 s before
# the SNI line to 3 s after counts: ids restart with Envoy, and a CONNECT line the journal
# dropped in a flood must not pin the refusal on an older tunnel with the same id (shown as ?).
# One time window per row (merged where they overlap), and only the tunnel's first and last
# lines (not the periodic ones a long tunnel logs every minute), so the lookup stays small; in
# batches cut by size, each query well under VictoriaLogs' length limit (16 KiB): a window with
# many ids (a burst) is split across queries.
JOIN_BEFORE, JOIN_AFTER = 20, 3   # after: Envoy flushes its log once a second
opened = {}
def utc(t):
    return datetime.datetime.fromtimestamp(t, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
JOIN_BYTES = 10000   # windows and ids per query (the rest of the query is under 300 bytes)
# The lookup runs JOIN_CHUNK TLS names at a time, when the rows reach the first not looked up
# yet, so names past the last row shown cost no query (a sparse 10000 would be some 70).
JOIN_CHUNK = 500
def lookup(chunk):
    sni_rows = [r for r in chunk if is_sni(r) and re.fullmatch(r"[0-9]{1,20}", r.get("envoy.connection", ""))]
    ids = sorted({r["envoy.connection"] for r in sni_rows})
    if ids:
        spans = []   # [start, end, {ids}]
        for k, cid in sorted((when(r.get("_time"))[0][0], r["envoy.connection"]) for r in sni_rows):
            if spans and k - JOIN_BEFORE <= spans[-1][1]:
                spans[-1][1] = k + JOIN_AFTER + 1
                spans[-1][2].add(cid)
            else:
                spans.append([k - JOIN_BEFORE, k + JOIN_AFTER + 1, {cid}])
        batches, cur, size = [], [], 0   # each: [(start, end, [ids])]
        for a, b, s in spans:
            win = len(f"_time:[{utc(a)}, {utc(b)}] or ")
            todo = sorted(s, key=int)
            while todo:
                if cur and size + win + len(todo[0]) + 1 > JOIN_BYTES:
                    batches.append(cur); cur, size = [], 0
                room, take = JOIN_BYTES - size - win, []
                while todo and (not take or room >= len(todo[0]) + 1):
                    room -= len(todo[0]) + 1; take.append(todo.pop(0))
                cur.append((a, b, take)); size = JOIN_BYTES - room
        if cur:
            batches.append(cur)
        for batch in batches:
            times = " or ".join(f"_time:[{utc(a)}, {utc(b)}]" for a, b, _ in batch)
            bids = sorted({i for _, _, t in batch for i in t}, key=int)
            for c in query(f'({times}) log_type:envoy-access envoy.method:CONNECT '
                           f'envoy.log_type:in(DownstreamTunnelSuccessfullyEstablished,DownstreamEnd) '
                           f'envoy.connection:in({",".join(bids)}) | sort by (_time desc) | limit 10000 '
                           f'| fields _time, envoy.connection, envoy.user, envoy.listener, envoy.authority'):
                opened.setdefault(c.get("envoy.connection", ""), []).append((when(c.get("_time"))[0], c))

def hint(r, sni_line):
    route, st, fl, det = r.get("envoy.route", ""), r.get("envoy.status", ""), r.get("envoy.flags", ""), r.get("envoy.details", "")
    l, a, sni = r.get("envoy.listener", "") or "?", r.get("envoy.authority", "") or "?", r.get("envoy.sni", "")
    host = re.sub(r":[0-9]+$", "", a)
    if route in ("", "-"):
        route = ""
    if r.get("log_type") == "envoy-web":
        if route.startswith("deny-"):
            return f"{sni or '?'} is an internal name: web never reaches one; a destination of its own on the {l} lines"
        if "DF" in fl:
            return f"web could not resolve {sni or '?'}"
        if "UF" in fl:
            return f"web could not connect to {sni or '?'} (down, or an internal address its kernel filter refuses)"
        return f"web refused the TLS name {sni or '(none)'}"
    if route == "deny-connect":
        return f"{a} is not a destination of {l}: add it to the {l} lines"
    if route == "deny-http":
        return f"{a} is not a plain-HTTP host of {l}: an http line for it, and http://{host} on the {l} lines"
    if route.startswith("deny-connect-http-"):
        return f"{a} is a plain-HTTP host here: the client should use http://{host}, not a tunnel"
    if route.startswith("deny-web-internal"):
        return f"{a} is an internal name, never web: a destination of its own on the {l} lines"
    if sni_line:
        if det.startswith("rbac_access_denied"):
            return f"{a} is an address entry, which passes only TLS without a name; the client sent {sni or '?'}"
        if not sni:
            return f"the tunnel to {a} sent no TLS name (not TLS, or none sent): only TLS naming {host} passes"
        return f"the tunnel to {a} sent the TLS name {sni}: only {host} passes"
    if det == "ext_authz_error":   # (Envoy flags its own errors UAEX too)
        return f"the push check for {a} could not decide, so the push was refused (it fails closed)"
    if ("UAEX" in fl or det == "ext_authz_denied") and st == "200":
        return f"a push to a protected branch of {a}: protect on its http line"
    if "UAEX" in fl or det == "ext_authz_denied":
        return f"the push check refused the push to {a} (Envoy's own log says why)"
    if det == "lua_response" and st == "423":
        return f"the credential for {a} is locked: airlock-envoy-cred unlock"
    if det == "lua_response" and st == "503":
        return f"the credential for {a} has no token (airlock-envoy-cred)"
    if det == "lua_response" and st == "200":
        return f"a tool call the mcp rules of {a} refuse: tools or deny-tools on its http line"
    if st == "413" and det in ("direct_response", "request_payload_too_large"):
        return f"a body over the limit of the rules of {a} (its http line)"
    if route and (det == "direct_response" or (det == "lua_response" and st == "403")):
        return f"refused by the rules of {a}: its http line (what each preset allows: airlock-envoy docs/presets.md)"
    return f"Envoy refused the request itself ({det or 'no details'})"

groups = []   # [row (newest, joined), its time shown, oldest time shown, count, key, what, status, tag, sni line]
stopped = False   # the row limit, not the lines read, ended the rows
JOINED = ("log_type", "envoy.sni", "envoy.route", "envoy.status", "envoy.flags", "envoy.details")   # not joined
joined_to = 0   # rows before this index are looked up
for i, r in enumerate(rows):
    key, t = when(r.get("_time"))
    sni_line = is_sni(r)
    if sni_line and i >= joined_to:
        # rows full, and this line can't go on the last one whoever opened its tunnel: done
        if len(groups) == limit and not (groups[-1][8] and all(r.get(f, "") == groups[-1][0].get(f, "") for f in JOINED)):
            stopped = True
            break
        chunk, j = [], i
        while j < len(rows) and len(chunk) < JOIN_CHUNK:
            if is_sni(rows[j]):
                chunk.append(rows[j])
            j += 1
        lookup(chunk)
        joined_to = j
    if sni_line:
        c = [x for x in opened.get(r.get("envoy.connection", ""), [])
             if (key[0] - JOIN_BEFORE, key[1]) <= x[0] <= (key[0] + JOIN_AFTER, key[1])]
        if c:
            o = max(c, key=lambda x: x[0])[1]
            r = dict(r, **{"envoy.user": o.get("envoy.user", ""), "envoy.listener": o.get("envoy.listener", ""),
                           "envoy.authority": o.get("envoy.authority", "")})
        else:
            r = dict(r, **{"envoy.listener": "", "envoy.authority": ""})
        what = f"TLS {r.get('envoy.sni') or '(no name)'} in a tunnel to {r.get('envoy.authority') or '?'}"
        st = "-"
    elif r.get("log_type") == "envoy-web":
        what, st = f"web TLS {r.get('envoy.sni') or '(no name)'}", "-"
    elif not r.get("envoy.method"):
        what, st = f"(a request Envoy could not read) {r.get('envoy.authority', '')}", r.get("envoy.status", "") or "-"
    else:
        what = f"{r.get('envoy.method', '')} {r.get('envoy.authority', '')}{r.get('envoy.path', '') if r.get('envoy.method') != 'CONNECT' else ''}"
        st = r.get("envoy.status", "") or "-"
    tag = r.get("envoy.route", "") or "no route"
    if r.get("envoy.flags", "") not in ("", "-"):
        tag += " " + r["envoy.flags"]
    gkey = (sni_line,) + tuple(r.get(f, "") for f in ("log_type", "envoy.user", "envoy.listener", "envoy.method",
                                                      "envoy.authority", "envoy.path", "envoy.sni", "envoy.route",
                                                      "envoy.status", "envoy.flags", "envoy.details"))
    if groups and groups[-1][4] == gkey:
        groups[-1][2] = t
        groups[-1][3] += 1
    else:
        if len(groups) == limit:
            stopped = True
            break
        groups.append([r, t, t, 1, gkey, what, st, tag, sni_line])

# Each row's reason: under it with --full; else each distinct reason once, numbered, below the
# rows, and the row carries its number (a column, not at the end: the row is cut to the width).
lines, notes = 0, {}
for r, t, oldest, n, _, what, st, tag, sni_line in groups:
    lines += n
    # the count before the route tag, not after it, for the same reason; a run begun the same day
    # says only its time
    # the last row when the lines read ran out first: its run may go on past them (x5000+)
    more = "+" if len(rows) == FETCH and not stopped and groups[-1][0] is r else ""
    run = f" (x{n}{more}, from {oldest[11:] if oldest[:10] == t[:10] else oldest})" if n > 1 or more else ""
    why = printable(hint(r, sni_line), 200)
    ref = "" if full else f"#{notes.setdefault(why, len(notes) + 1):<3} "
    # On a narrow terminal the user and listener columns shrink (under 120 columns; under 100
    # the time drops its year too), and the run count drops its "from" when what would get
    # under 20 columns: the host and the count stay on the row.
    uw, lw = (16, 24) if width >= 120 else (10, 14) if width >= 100 else (8, 12)
    head = (f"{t if width >= 100 else t[5:]}  {printable(r.get('envoy.user') or '?', uw):<{uw}} "
            f"{printable(r.get('envoy.listener') or '?', lw):<{lw}} {printable(st, 3):>3}  {ref}")
    if run and width - sum(map(cols, head + run)) - 6 < 20:
        run = f" (x{n}{more})"
    what = printable(what, 120)
    # what is shortened rather than the count after it (the route tag goes first); when it
    # has to be, a little of the tag stays
    room = width - sum(map(cols, head + run))
    if sum(map(cols, what)) > room:
        what = fit(what, max(6, room - 9)) + "..."
    print(fit(f"{head}{what}{run}  [{printable(tag, 60)}]", width))
    if full:
        for line in wrapped(why, max(20, width - 4)):
            print(f"    {line}")
if notes:
    print("")
    for why, i in notes.items():
        for j, line in enumerate(wrapped(why, max(20, width - 6))):
            print(f"{('#' + str(i)) if j == 0 else '':<5} {line}")

start_local = when(start)[1]
nrows = f"{len(groups)} row{'s' if len(groups) != 1 else ''}"
if total == 0:
    print(f"(no refusals since {start_local})")
elif len(rows) == FETCH and not stopped and total > lines:
    print(fit(f"({nrows}, {lines} of {total} refusals, since {start_local}, newest first; only the newest "
              f"{FETCH} were read, so older refusals are not shown and the last count may be low)", width))
elif total > lines:
    print(fit(f"({nrows}, {lines} of {total} refusals, since {start_local}, newest first: --limit <n> for more)", width))
else:
    print(fit(f"({total} refusal{'s' if total != 1 else ''} in {nrows} since "
              f"{start_local}; the site file: /etc/airlock-envoy/site.conf)", width))
PY
}
# ---- the auditor (an auditor line in agents.conf) ----------------------------------------------
# A fresh one-shot Claude in the auditor user's box (lib/audit-run), which reaches only Anthropic
# and the store. Its report is its model's words after reading text the agents chose: kept and
# shown as that, cleaned, never acted on. The file is written here, as the operator, into a dir
# the auditor can't read or write, with the queries Envoy logged for the auditor's user over the
# run (the store's copy of Envoy's lines), not the ones the model says it ran.
auditor_ready() {
    [ -n "$AUDITOR" ] || die "no auditor here (agents.conf: an auditor line, then sudo airlock-agents-apply --confirm)"
    getent passwd "$AUDITOR" >/dev/null || die "$AUDITOR is not provisioned yet (sudo airlock-agents-apply --confirm)"
    ! halted || die "halted ($CMD halt): the auditor is stopped too; $CMD resume first ($CMD audit denies and events work meanwhile)"
}
audit_login() {
    auditor_ready
    echo "==> $AUDITOR, workspace ~/audit: in the box, /login, then /exit"
    # shellcheck disable=SC2016  # expanded on the auditor's side
    AS=$AUDITOR oexec /bin/bash -c 'mkdir -p "$HOME/audit" && cd "$HOME/audit" && exec "$HOME/.local/bin/airlock"' bash
}
audit_run() {  # audit_run review <days> | ask <question>
    local reports="${AGENTS_AUDIT_REPORTS:-}" start end rc=0 out what
    auditor_ready
    audit_ready
    [ -n "$reports" ] && [ -d "$reports" ] && [ ! -L "$reports" ] && [ -w "$reports" ] \
        || die "no reports dir ${reports:-(agents.env has none)} you can write (sudo airlock-agents-apply --confirm)"
    if [ "$1" = review ]; then what="a review of the last $2 days"; else what="your question"; fi
    out="$(mktemp)" || die "no private work file (\$TMPDIR)"
    # shellcheck disable=SC2064  # the path now
    trap "rm -f -- '$out'" EXIT
    start="$(date -u +%s)"
    echo "==> $AUDITOR: $what, in a fresh box (20 min at most; the report follows)" >&2
    AS=$AUDITOR orun "$AGENTS_LIB/audit-run" "$@" > "$out" || rc=$?
    end="$(date -u +%s)"
    # 64 with audit-run's own line: it refused before any run (its reason is all it printed): no report
    if [ "$rc" = 64 ] && head -c 4096 "$out" | grep -q '^audit-run: '; then head -c 4096 "$out" >&2; die "no run, no report"; fi
    { python3 -I - "$AUDIT_SOCK" "$AUDITOR" "$start" "$end" "$rc" "$out" "$reports" "$CMD" "$1" "${2:-}" <<"PY"
import datetime, json, os, re, subprocess, sys, time, urllib.parse
sock, auditor, start, end, rc, out, reports, cmd, mode, arg = sys.argv[1:11]
start, end, rc = int(start), int(end), int(rc)
CAP = 1048576   # the auditor's text kept, at most

def iso(t):
    return datetime.datetime.fromtimestamp(t, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
def utc(t):
    return datetime.datetime.fromtimestamp(t, datetime.timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
def printable(s):  # one line of text from the store: control characters (newline too) shown as ?
    return "".join(c if c.isprintable() else "?" for c in str(s))

def query(q, limit=30):
    p = subprocess.run(["curl", "-sS", "--max-time", str(max(1, int(limit))), "--unix-socket", sock, "-w", "\n%{http_code}",
                        "http://x/select/logsql/query", "--data-urlencode", "query=" + q],
                       stdin=subprocess.DEVNULL, capture_output=True)
    body, _, code = p.stdout.decode("utf-8", "replace").rpartition("\n")
    if p.returncode != 0 or code != "200":
        return None
    rows = []
    for line in body.splitlines():
        try:
            o = json.loads(line)
        except ValueError:
            continue
        if isinstance(o, dict):
            rows.append({k: v if isinstance(v, str) else json.dumps(v) for k, v in o.items()})
    return rows

# Envoy writes each line when its request ends and the store has it within a second or two
# (measured on the first host runs: 0.02 to 1 s). The list is in when it is complete and settled:
# every tunnel the run opened has its own closing line, paired by Envoy's connection id (a
# refused or failed CONNECT logs a close with no open, and must not stand in for one), there is
# at least one (the run's model traffic rides one: none means the store is behind, whatever the
# run's exit), and the auditor's lines have held still for three polls; from 5 s after the run,
# about 30 s at most, then what is there, said so. A count the store didn't answer never counts
# as settled. (Another run or an audit login in this window shows here too.)
win = f"_time:[{iso(start - 1)}, {iso(end + 10)}]"
COUNT = f'{win} log_type:envoy-access envoy.user:="{auditor}" | stats count() n'
TUNNELS = (f'{win} log_type:envoy-access envoy.user:="{auditor}" envoy.method:CONNECT '
           f'envoy.log_type:in(DownstreamTunnelSuccessfullyEstablished,DownstreamEnd) '
           f'| stats by (envoy.log_type, envoy.connection) count() c | limit 5000')
caught, answered, last, still, seen = False, False, None, 0, ("?", "?", "?")
deadline = time.monotonic() + 30
time.sleep(min(6, max(0, end + 6 - time.time())))
while time.monotonic() < deadline:
    r = query(COUNT, deadline - time.monotonic())
    t = query(TUNNELS, deadline - time.monotonic()) if r else None
    cur = None
    if r and t is not None and r[0].get("n", "").isdigit():
        opened = {x.get("envoy.connection") for x in t if x.get("envoy.log_type") == "DownstreamTunnelSuccessfullyEstablished"}
        closed = {x.get("envoy.connection") for x in t if x.get("envoy.log_type") == "DownstreamEnd"}
        cur = (r[0]["n"], len(opened), len(opened & closed))
    if cur is not None:
        answered, seen = True, tuple(str(v) for v in cur)
        complete = cur[1] > 0 and cur[2] == cur[1]
        if cur == last and complete:
            still += 1
            if still >= 2:
                caught = True
                break
        elif cur != last:
            still = 0
    else:
        still = 0
    last = cur
    time.sleep(min(2, max(0, deadline - time.monotonic())))
rows = query(f'{win} log_type:envoy-access envoy.user:="{auditor}" | sort by (_time) | limit 5001 '
             f'| fields _time, envoy.listener, envoy.method, envoy.authority, envoy.path, envoy.status, envoy.route, envoy.bytes_in')

with open(out, "rb") as f:
    text = f.read(CAP + 1)
cut = len(text) > CAP
text = text[:CAP].decode("utf-8", "replace").rstrip("\n")

L = []
L.append(f"# Audit report, {utc(start)}")
L.append("")
L.append(f"- What: " + (f"a review of the last {arg} days" if mode == "review" else "the operator's question:"))
if mode == "ask":
    for q in arg.splitlines() or [""]:
        L.append("    " + printable(q))
L.append(f"- Auditor: {auditor}, from {utc(start)} to {utc(end)} ({end - start} s), exit {rc}"
         + (" (timed out: the report may be missing or cut)" if rc == 124 else ""))
L.append("")
L.append("## Queries actually run (Envoy's log of the auditor's requests, not its own account)")
L.append("")
if rows is None:
    L.append(f"The store did not answer: the list is missing ({cmd} audit events --agent {auditor} --kind envoy-allowed --since 1h, later).")
else:
    if not answered:
        L.append(f"(The store didn't answer how many of the auditor's lines it holds: this list may be short. Later: "
                 f"{cmd} audit events --agent {auditor} --severity info --since 1h)")
        L.append("")
    elif not caught:
        L.append(f"(The auditor's lines in the store were incomplete or still changing 30 s after the run ({seen[0]} lines, "
                 f"{seen[2]} of {seen[1]} tunnels closed): this list may be short. Later: "
                 f"{cmd} audit events --agent {auditor} --severity info --since 1h)")
        L.append("")
    tunnels, reqs, refused = {}, [], 0
    for r in rows[:5000]:
        if r.get("envoy.method") == "CONNECT":
            a = printable(r.get("envoy.authority", "?"))
            tunnels[a] = tunnels.get(a, 0) + 1
        else:
            reqs.append(r)
    for r in reqs:
        st = r.get("envoy.status", "")
        refused += not (st.isdigit() and 200 <= int(st) < 300)
    L.append(f"{len(reqs)} request(s) to plain-HTTP hosts ({refused} not answered 2xx); "
             + (", ".join(f"{n} tunnel(s) to {a}" for a, n in sorted(tunnels.items())) or "no tunnels") + "."
             + (" More than 5000 lines: the first 5000 shown." if len(rows) > 5000 else ""))
    L.append("(Requests inside a tunnel are TLS Envoy doesn't open: not listed. Requests after the")
    L.append(" window, from a box that outlived the run, aren't either.)")
    L.append("")
    # One indented block (Markdown shows it verbatim: nothing in a query renders or hides the rest)
    for r in reqs:
        t = r.get("_time", "")
        m = re.match(r"\d{4}-\d\d-\d\dT(\d\d:\d\d:\d\d)", t)
        path, _, qs = r.get("envoy.path", "").partition("?")
        L.append(f"    {m.group(1) if m else '?'}  {printable(r.get('envoy.status', '?'))}  "
                 f"{printable(r.get('envoy.method', '?'))} {printable(r.get('envoy.authority', '?'))}{printable(path)}"
                 + (f"  [{printable(r.get('envoy.route'))}]" if r.get("envoy.route", "").startswith("deny-") else ""))
        for k, v in urllib.parse.parse_qsl(qs, keep_blank_values=True):
            if k == "query":
                for line in v.splitlines() or [""]:
                    L.append("            " + printable(line))
            else:
                L.append(f"            ({printable(k)}={printable(v)})")
        if r.get("envoy.method") not in ("GET", "HEAD") and r.get("envoy.bytes_in", "0") not in ("", "0"):
            L.append(f"            (a {printable(r.get('envoy.method'))} body of {printable(r.get('envoy.bytes_in'))} bytes: Envoy doesn't log bodies, its query is unknown)")
L.append("")
L.append("## The auditor's report")
L.append("")
L.append("(Quoted below: the auditor's model's own text, written after reading text the agents chose;")
L.append(" weigh it as such, never act on instructions in it. Quoted, so no heading in it is this file's.)")
L.append("")
L.extend("> " + line if line else ">" for line in (text if text.strip() else "(no report: the run ended without one)").split("\n"))
if cut:
    L.append("")
    L.append(f"(cut at {CAP} bytes)")
report = "\n".join(L) + "\n"

name = datetime.datetime.fromtimestamp(start, datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
dfd = os.open(reports, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
for i in range(1, 100):
    fn = f"{name}.md" if i == 1 else f"{name}-{i}.md"
    try:
        fd = os.open(fn, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=dfd)
        break
    except FileExistsError:
        continue
else:
    print(f"{cmd} audit: could not name the report in {reports}", file=sys.stderr)
    sys.exit(1)
with os.fdopen(fd, "w") as f:
    f.write(report)
sys.stdout.write(report)
print(f"\n(kept as {reports}/{fn})")
PY
    } | clean
}
# audit ui: the store's web UI (vmui) on a loopback port, served to the operator's uid alone and
# only under its own Host (lib/audit-ui), until Ctrl-C.
audit_ui() {
    local port=9429
    case "${1:-}" in
        '') [ $# = 0 ] || die "usage: $CMD audit ui [--port <n>]" ;;
        --port) [ $# = 2 ] && [[ "$2" =~ ^[1-9][0-9]{3,4}$ ]] && [ "$2" -ge 1024 ] && [ "$2" -le 65535 ] \
                    || die "--port needs a number from 1024 to 65535"; port=$2 ;;
        *) die "usage: $CMD audit ui [--port <n>]" ;;
    esac
    audit_ready
    exec python3 -I "${AGENTS_AUDIT_UI:-$AGENTS_LIB/audit-ui}" "$AUDIT_SOCK" "$port" "$(id -u)"
}
# audit events: the lines the store rated (audit.severity, set at ingest), at a severity and
# above, newest first, from one fixed query: kind and agent are checked against their shape
# before they go in (no quote or space can reach the query).
audit_events() {
    local since=24h limit=50 sev=medium kind="" agent="" full=0 cutoff W
    while [ $# -gt 0 ]; do
        case "$1" in
            --since) [ $# -ge 2 ] || die "--since needs <n>d, <n>h or YYYY-MM-DD"; since=$2; shift ;;
            --limit) [ $# -ge 2 ] && [[ "$2" =~ ^([1-9][0-9]{0,2}|1000)$ ]] || die "--limit needs a number from 1 to 1000"; limit=$2; shift ;;
            --severity) [ $# -ge 2 ] && [[ "$2" =~ ^(high|medium|low|info)$ ]] || die "--severity needs high, medium, low or info"; sev=$2; shift ;;
            --kind) [ $# -ge 2 ] && [[ "$2" =~ ^[a-z][a-z-]{0,31}$ ]] || die "--kind needs a kind (envoy-refused, privilege, login, session, nft-drop, box-drop, ...)"; kind=$2; shift ;;
            --agent) [ $# -ge 2 ] && [[ "$2" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "--agent needs an agent user's name"; agent=$2; shift ;;
            --full) full=1 ;;
            *) die "usage: $CMD audit events [--severity high|medium|low|info] [--kind <kind>] [--agent <name>] [--since <n>d|<n>h|YYYY-MM-DD] [--limit <n>] [--full]" ;;
        esac
        shift
    done
    cutoff="$(since_epoch "$since")"
    audit_ready
    set_cols
    python3 -I - "$AUDIT_SOCK" "$(date -u -d "@$cutoff" +%Y-%m-%dT%H:%M:%SZ)" "$limit" "$CMD" "$sev" "$kind" "$agent" "$full" "$W" <<"PY" | clean
import datetime, json, re, subprocess, sys, textwrap, unicodedata
sock, start, limit, cmd, sev, kind, agent = sys.argv[1], sys.argv[2], int(sys.argv[3]), sys.argv[4], sys.argv[5], sys.argv[6], sys.argv[7]
full, width = sys.argv[8] == "1", int(sys.argv[9])
FULL_MAX, FULL_LINES = 2000, 40   # one event's whole text under --full: characters, lines

# Lines are fitted to the terminal here, by display width (a wide character takes two columns),
# not by the shell's cut, which counts bytes and would split a character.
def cols(c):
    return 2 if unicodedata.east_asian_width(c) in ("W", "F") else 1

def fit(s, w):
    out, n = [], 0
    for c in s:
        n += cols(c)
        if n > w:
            break
        out.append(c)
    return "".join(out)

def chunks(s, w):   # s in pieces of at most w columns
    while s:
        piece = fit(s, w) or s[0]
        yield piece
        s = s[len(piece):]
ORDER = ["high", "medium", "low", "info"]
levels = ORDER[:ORDER.index(sev) + 1]

def printable(s, n):
    s = "".join(c if c.isprintable() else "?" for c in str(s))
    return s if len(s) <= n else s[:n - 3] + "..."

def query(q):
    p = subprocess.run(["curl", "-sS", "--max-time", "30", "--unix-socket", sock, "-w", "\n%{http_code}",
                        "http://x/select/logsql/query", "--data-urlencode", "query=" + q],
                       stdin=subprocess.DEVNULL, capture_output=True)
    body, _, code = p.stdout.decode("utf-8", "replace").rpartition("\n")
    if p.returncode != 0 or code != "200":
        why = (body or p.stderr.decode("utf-8", "replace")).strip()
        print(f"{cmd} audit events: no answer from the audit store (curl {p.returncode}, HTTP {code or '-'}): "
              f"{printable(why, 300)}", file=sys.stderr)
        sys.exit(1)
    rows = []
    for line in body.splitlines():
        try:
            o = json.loads(line)
        except ValueError:
            continue
        if isinstance(o, dict):
            rows.append({k: v if isinstance(v, str) else json.dumps(v) for k, v in o.items()})
    return rows

def when(t):
    m = re.match(r"(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(?:\.\d{1,9})?Z$", t or "")
    if not m:
        return "?"
    d = datetime.datetime.strptime(m.group(1), "%Y-%m-%dT%H:%M:%S").replace(tzinfo=datetime.timezone.utc)
    return d.astimezone().strftime("%Y-%m-%d %H:%M:%S")

f = f'_time:>={start} audit.severity:in({",".join(levels)})'
if kind:
    f += f' audit.kind:="{kind}"'
if agent:
    f += f' audit.agent:="{agent}"'
# Repeats collapse: consecutive lines alike in severity, kind, agent, session, redaction and their
# whole raw text (every line of a journal message; every Envoy field) are one row with their count
# and when the run began, so one repeating failure can't push the rest out of view, and lines that
# only look alike on screen (the same first line, a cut, a replaced character) stay apart. Up to
# FETCH lines are read for that; --limit counts rows.
FETCH = 10000
rows = query(f"{f} | sort by (_time desc) | limit {FETCH} | fields _time, audit.severity, audit.kind, audit.agent, "
             "audit.session, audit.redacted, log_type, _msg, envoy.method, envoy.authority, envoy.path, envoy.route, "
             "envoy.status, envoy.sni, envoy.flags, envoy.details, envoy.listener")
counts = {r.get("audit.severity", ""): r.get("n", "0") for r in query(f"{f} | stats by (audit.severity) count() n")}
groups = []   # [first row (newest), oldest time, count, key, what, who, flag]
for r in rows:
    if r.get("log_type") in ("envoy-access", "envoy-web"):
        m = r.get("envoy.method", "")
        what = (f"{m} {r.get('envoy.authority', '')}{r.get('envoy.path', '') if m and m != 'CONNECT' else ''}"
                if m else f"TLS {r.get('envoy.sni') or '(no name)'}")
        what += f"  [{r.get('envoy.route') or 'no route'} {r.get('envoy.status', '')}]".rstrip("] ") + "]"
    else:
        what = (r.get("_msg") or "").split("\n")[0]
    who = r.get("audit.agent") or "-"
    if r.get("audit.session"):
        who += "/" + r["audit.session"]
    flag = " (redacted)" if r.get("audit.redacted") == "true" else ""
    raw = (r.get("_msg"),) if r.get("log_type") not in ("envoy-access", "envoy-web") else tuple(
        r.get(f) for f in ("envoy.listener", "envoy.method", "envoy.authority", "envoy.path", "envoy.route", "envoy.status",
                           "envoy.sni", "envoy.flags", "envoy.details"))
    key = (r.get("audit.severity"), r.get("audit.kind"), who, flag) + raw
    if groups and groups[-1][3] == key:
        groups[-1][1] = r.get("_time")
        groups[-1][2] += 1
    else:
        if len(groups) == limit:
            break
        groups.append([r, r.get("_time"), 1, key, what, who, flag])
lines = 0
for r, oldest, n, _, what, who, flag in groups:
    lines += n
    run = f" (x{n}, from {when(oldest)})" if n > 1 else ""
    print(fit(f"{when(r.get('_time'))}  {printable(r.get('audit.severity') or '?', 6):<6}  {printable(r.get('audit.kind') or '?', 19):<19}  "
              f"{printable(who, 28):<28}  {printable(what, 160)}{flag}{run}", width))
    if full:
        # The whole text under the row, each line cleaned (a newline in it starts a new one),
        # wrapped to the terminal, at most FULL_MAX characters in all.
        if r.get("log_type") in ("envoy-access", "envoy-web"):
            text = " ".join(f"{k.split('.', 1)[1]}={r[k]}" for k in ("envoy.listener", "envoy.method", "envoy.authority",
                            "envoy.path", "envoy.sni", "envoy.route", "envoy.status", "envoy.flags", "envoy.details") if r.get(k))
        else:
            text = r.get("_msg") or ""
        out = []
        for part in text[:FULL_MAX].split("\n"):
            for line in textwrap.wrap(printable(part, FULL_MAX), max(20, width - 6), break_long_words=True,
                                      break_on_hyphens=False) or [""]:
                out.extend(chunks(line, max(20, width - 6)) if line else [""])
        cut = len(text) > FULL_MAX or len(out) > FULL_LINES
        for line in out[:FULL_LINES]:
            print("      " + line)
        if cut:
            print(f"      ...[cut at {FULL_MAX} characters or {FULL_LINES} lines]")
by = ", ".join(f"{s} {counts[s]}" for s in levels if s in counts) or "none"
total = sum(int(v) for v in counts.values() if v.isdigit())
if len(rows) == FETCH and len(groups) < limit and total > lines:
    more = f"; only the newest {FETCH} lines were read: narrow --since, --kind or --agent for the rest"
elif total > lines:
    more = f"; newest {len(groups)} rows ({lines} lines) shown, --limit <n> for more"
else:
    more = ""
print(fit(f"({by} since {when(start)}, {sev} and above{more}; lines from before the store rated them are not counted)", width))
PY
}
AUDIT_USAGE="usage: $CMD audit [--days <n>] | \"<question>\" | login | denies [--since <n>d|<n>h|YYYY-MM-DD] [--limit <n>] [--full] | events [--severity <s>] [--kind <k>] [--agent <a>] [--since ...] [--limit <n>] [--full] | ui [--port <n>]"
audit() {
    local sub="${1:-}"
    case "$sub" in
        denies) shift; audit_denies "$@" ;;
        ui) shift; audit_ui "$@" ;;
        events) shift; audit_events "$@" ;;
        login) shift; [ $# = 0 ] || die "usage: $CMD audit login"; audit_login ;;
        '') audit_run review 7 ;;
        --days)
            [ $# = 2 ] && [[ "$2" =~ ^[1-9][0-9]?$ ]] && [ "$2" -le 90 ] || die "usage: $CMD audit [--days <1 to 90>]"
            audit_run review "$2" ;;
        -*) die "$AUDIT_USAGE" ;;
        *)
            # a question: one argument (quoted), so a typo'd command name never starts a run
            [ $# = 1 ] || die "a question is one argument: $CMD audit \"<question>\" (quote it)"
            [[ "$1" == *[[:space:]]* ]] || die "unknown audit command '$1' (a question has spaces; $AUDIT_USAGE)"
            audit_run ask "$1" ;;
    esac
}

# ---- halt / resume ----------------------------------------------------------------------------
# What halt did, for resume (root's: written under sudo, readable). Test knobs, like AGENTS_NODUMP_DIR.
HALT_MARK="${AGENTS_HALT_MARK:-/var/lib/airlock-agents-halt/halted}"
ENVOY_STOPPED="${AGENTS_ENVOY_STOPPED:-/etc/airlock-envoy/stopped}"
ENVOY_SBIN="${AGENTS_ENVOY_SBIN:-/usr/local/sbin}"   # where airlock-envoy installs its tools
ENVOY_CRED_STATE="${AGENTS_ENVOY_CRED_STATE:-/run/airlock-envoy-cred/state}"
have_apply() { [ -x "$ENVOY_SBIN/airlock-envoy-apply" ]; }
have_cred() { [ -x "$ENVOY_SBIN/airlock-envoy-cred" ]; }
# Halting (the operator's own mark, made before the kill: until root's mask, nothing of the
# operator's may start a manager again, a tab completion included) or halted (masked).
# A fixed path under $HOME: the completions run this with a bare environment (HOME, no XDG_*).
# HOME unset (rare) must not stop halt before its kill: the account's home instead.
OPHOME="${HOME:-$(getent passwd "$(id -u)" | cut -d: -f6 || true)}"
HALTING="$OPHOME/.local/state/airlock-agents/halting"
halted() { [ -e "$HALTING" ] || [ "$(systemctl is-enabled "user@$AGENTS_AGENT_UID.service" 2>/dev/null)" = masked ]; }
# As root (one sudo for each verb). Each step runs even if one before it failed: in an
# emergency a half-done stop is worse than a noisy one. The uids are checked to be numbers.
# Order: nothing may start them again (mask), they die (their manager's cgroup and every
# session scope), egress is cut, and only then the managers' stop, which can be slow.
# The mark says "envoy-stopped-by-halt <nonce>" only for a kill switch a halt turned on itself:
# root writes the nonce into the stopped file, which airlock-envoy only tests for (a --stop by
# hand, or a --start that undoes itself, writes an empty one: that is the operator's or must be
# claimed again). Resume lifts only a switch still holding the nonce, and drops the line once
# lifted. "envoy-locked-by-halt": the credentials were unlocked when halt locked them, so resume
# ends with an unlock (the operator's own, interactive, for the usual lifetime).
# shellcheck disable=SC2016  # expanded by the root shell, on purpose
ROOT_HALT='
umask 022   # the mark is for the operator to read too
mark=$1 stopped=$2 sbin=$3 credstate=$4; shift 4
rc=0; units=()
# An interrupt (Ctrl-C, the terminal closed) cuts the step running, never the ones after it. A
# handler, not an ignore: a hung child can still be interrupted.
trap "echo \"    (interrupted: going on with the next step)\" >&2; rc=1" INT TERM QUIT
trap "" HUP   # the terminal gone: no step is cut (the steps inherit the ignore)
newnonce() { local n; n=$(od -An -N16 -tx1 /dev/urandom 2>/dev/null | tr -d " \n"); [ -n "$n" ] || n=$(tr -d - < /proc/sys/kernel/random/uuid); printf "%s" "$n"; }
for u; do case "$u" in ""|0|*[!0-9]*) echo "bad uid $u" >&2; exit 2 ;; esac; units+=("user@$u.service"); done
mkdir -p "$(dirname "$mark")"
[ -e "$mark" ] || echo "halted $(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$mark" || rc=1
echo "==> masking and killing ${units[*]}"
systemctl mask "${units[@]}" || rc=1
systemctl kill -s KILL "${units[@]}" 2>/dev/null || true
for u; do loginctl terminate-user "$u" 2>/dev/null || true; done
nonce=$(sed -n "s/^envoy-stopped-by-halt //p" "$mark")
if [ -x "$sbin/airlock-envoy-apply" ] && [ -d "$(dirname "$stopped")" ]; then
    echo "==> airlock-envoy: turning its kill switch on"
    # Ours: none was on, the one on holds our nonce, or a halt cut short claimed it.
    ours=0
    if [ ! -e "$stopped" ]; then ours=1
    elif [ -n "$nonce" ] && [ "$(head -c 64 "$stopped")" = "$nonce" ]; then ours=1
    elif grep -qx envoy-claim-pending "$mark"; then ours=1; fi
    # Decided before the file is touched: a halt cut short after --stop keeps the claim.
    if [ "$ours" = 1 ]; then grep -qx envoy-claim-pending "$mark" || echo envoy-claim-pending >> "$mark" || rc=1; fi
    "$sbin/airlock-envoy-apply" --stop || { rc=1; echo "    FAILED: $sbin/airlock-envoy-apply --stop (above)" >&2; }
    # Claimed on the switch being on, whatever --stop returned (it writes the file first).
    sed -i "/^envoy-stopped-by-halt /d" "$mark" || rc=1
    if [ "$ours" = 1 ] && [ -e "$stopped" ]; then
        nonce=$(newnonce)
        if [ -n "$nonce" ] && printf "%s" "$nonce" > "$stopped" && echo "envoy-stopped-by-halt $nonce" >> "$mark"; then
            sed -i "/^envoy-claim-pending$/d" "$mark" || rc=1
        else rc=1; fi   # the pending claim stays: the next halt claims the switch
    else
        sed -i "/^envoy-claim-pending$/d" "$mark" || rc=1
    fi
elif [ -x "$sbin/airlock-envoy-apply" ]; then
    echo "==> airlock-envoy: no config directory ($(dirname "$stopped")): no kill switch to turn on"
fi
if [ -x "$sbin/airlock-envoy-cred" ]; then
    echo "==> airlock-envoy: locking its credentials"
    was=locked; ! head -n 1 "$credstate" 2>/dev/null | grep -q "^unlocked" || was=unlocked
    if "$sbin/airlock-envoy-cred" lock; then
        [ "$was" != unlocked ] || grep -qx envoy-locked-by-halt "$mark" || echo envoy-locked-by-halt >> "$mark" || rc=1
    else rc=1; echo "    FAILED: $sbin/airlock-envoy-cred lock (above): the credentials may still be unlocked" >&2; fi
fi
echo "==> stopping ${units[*]}"
systemctl stop "${units[@]}" || rc=1
exit "$rc"
'
# shellcheck disable=SC2016  # expanded by the root shell, on purpose
ROOT_RESUME='
umask 022
mark=$1 stopped=$2 sbin=$3; shift 3
rc=0; units=()
newnonce() { local n; n=$(od -An -N16 -tx1 /dev/urandom 2>/dev/null | tr -d " \n"); [ -n "$n" ] || n=$(tr -d - < /proc/sys/kernel/random/uuid); printf "%s" "$n"; }
for u; do case "$u" in ""|0|*[!0-9]*) echo "bad uid $u" >&2; exit 2 ;; esac; units+=("user@$u.service"); done
# Only the kill switch a halt left (its nonce in the file); the line goes once lifted, so a
# retry leaves Envoy alone. A --start that undoes itself writes the switch again: claimed again.
nonce=$(sed -n "s/^envoy-stopped-by-halt //p" "$mark" 2>/dev/null)
# A halt cut short between its --stop and the nonce: the switch it turned on is its own.
if [ -z "$nonce" ] && grep -qx envoy-claim-pending "$mark" 2>/dev/null && [ -e "$stopped" ]; then
    nonce=$(newnonce)
    { [ -n "$nonce" ] && printf "%s" "$nonce" > "$stopped" && echo "envoy-stopped-by-halt $nonce" >> "$mark" && sed -i "/^envoy-claim-pending$/d" "$mark"; } \
        || { rc=1; nonce=""; echo "==> airlock-envoy: could not record the switch of a halt cut short: the agents stay halted, resume again" >&2; }
fi
if [ -n "$nonce" ]; then
    if [ ! -e "$stopped" ]; then
        echo "==> airlock-envoy: its kill switch is off already (if Envoy is not up, $sbin/airlock-envoy-apply --status)"; sed -i "/^envoy-stopped-by-halt /d" "$mark" || rc=1
    elif [ "$(head -c 64 "$stopped")" != "$nonce" ] && ! grep -qx envoy-claim-pending "$mark"; then
        echo "==> airlock-envoy: its kill switch was rewritten since the halt (a --stop, or a --start that failed, by hand): left on ($sbin/airlock-envoy-apply --start lifts it)"
        sed -i "/^envoy-stopped-by-halt /d" "$mark" || rc=1
    elif [ ! -x "$sbin/airlock-envoy-apply" ]; then
        echo "==> airlock-envoy: the halt turned its kill switch on, and $sbin/airlock-envoy-apply is gone: reinstall airlock-envoy and resume again, or give the switch up (sudo rm $stopped)" >&2; rc=1
    else
        echo "==> airlock-envoy: kill switch off (applies, starts everything); your own boxes on its sockets need a relaunch (new socket files)"
        if "$sbin/airlock-envoy-apply" --start; then sed -i "/^envoy-stopped-by-halt /d" "$mark" || rc=1
        else
            rc=1
            if [ -e "$stopped" ]; then
                nonce=$(newnonce)
                # The record first: a write cut between leaves a claim the next resume re-claims.
                [ -n "$nonce" ] && sed -i "s/^envoy-stopped-by-halt .*/envoy-stopped-by-halt $nonce/; \$a envoy-claim-pending" "$mark" && printf "%s" "$nonce" > "$stopped" && sed -i "/^envoy-claim-pending$/d" "$mark"
            fi
        fi
    fi
elif [ -x "$sbin/airlock-envoy-apply" ]; then
    echo "==> airlock-envoy: no kill switch of a halt to lift: left as it is ($sbin/airlock-envoy-apply --start lifts one)"
fi
# The agents come back only with what they had: an Envoy step that failed keeps them halted.
if [ "$rc" != 0 ]; then
    echo "==> the agents stay halted until that is fixed: resume again" >&2
    exit "$rc"
fi
echo "==> unmasking and starting ${units[*]}"
systemctl unmask "${units[@]}" || rc=1
systemctl start "${units[@]}" || rc=1
[ "$rc" != 0 ] || rm -f "$mark"
exit "$rc"
'
agent_users() {  # users[] and uids[]: the provisioned agent users
    local u uid
    users=() uids=()
    for u in "$AGENT" $WEB $GUARD $AUDITOR; do
        uid="$(getent passwd "$u" | cut -d: -f3)" || continue
        [ -n "$uid" ] || continue
        users+=("$u"); uids+=("$uid")
    done
}
halt() {
    local u log users uids
    agent_users
    [ ${#users[@]} -gt 0 ] || die "no agent user is provisioned"
    log="${XDG_STATE_HOME:-$OPHOME/.local/state}/airlock-agents/halt-$(date -u +%Y%m%dT%H%M%SZ).log"
    # Nothing before the root steps may stop them: a full disk (a runaway agent's) or an
    # unwritable state dir costs the record and the mark, never the kill.
    mkdir -p "$(dirname "$log")" 2>/dev/null || true
    # The record, first (bounded: 2 s, 256 KiB), to the log only: an agent's flood can't hold
    # up the kill or the terminal. Their command lines are theirs to write: cleaned.
    { { echo "halt $(date -u +%Y-%m-%dT%H:%M:%SZ) by $(id -un): ${users[*]}"
        timeout -k 1 2 ps -o user=,pid=,etime=,args= -u "$(IFS=,; echo "${uids[*]}")" 2>/dev/null | head -c 262144 || true
      } | clean | cut -c1-200 > "$log"; } 2>/dev/null || { log=""; echo "    (no record: the state directory can't be written)"; }
    # 1. Now, as the operator (no prompt): each agent user kills every process it may signal,
    # its boxes too (their uids are mapped in a user namespace it owns), and its own manager.
    # All at once, never on the terminal (machinectl would take it: a background job under
    # timeout stops on it, and typed-ahead keys would go to a pty the agent owns).
    echo "==> killing every process of ${users[*]}"
    { mkdir -p "${HALTING%/*}" && : > "$HALTING"; } 2>/dev/null || echo "    (no halting mark: the state directory can't be written; your other commands still work until root's mask)"
    if nd_ok >/dev/null; then
        local pids=() i
        for u in "${users[@]}"; do
            timeout -k 2 10 machinectl shell -q "$u@" "$ND/sh" -c 'kill -KILL -1' </dev/null >/dev/null 2>&1 & pids+=($!)
        done
        for i in "${!users[@]}"; do
            # machinectl shell doesn't return the remote status: this says only that it ran
            if wait "${pids[$i]}"; then echo "    ${users[$i]}: kill sent"
            else echo "    ${users[$i]}: could not (left to root's kill, next)"; fi
        done
    else
        echo "    (the execute-only copies are missing: left to root's kill, next)"
    fi
    if [ -n "$log" ]; then
        echo "What was running (all in $log):"
        sed -n '2,21p' "$log" | sed 's/^/    /'
    fi
    # 2. As root: nothing restarts them.
    echo
    echo "$CMD halt: next, as root, so nothing starts them again (a reboot included): mask, kill and"
    echo "stop the user managers of ${users[*]}$(have_apply && echo ", cut airlock-envoy's egress")$(have_cred && echo ", lock airlock-envoy's credentials")."
    echo "sudo asks for your password for that."
    if sudo -- /bin/bash -c "$ROOT_HALT" halt "$HALT_MARK" "$ENVOY_STOPPED" "$ENVOY_SBIN" "$ENVOY_CRED_STATE" "${uids[@]}"; then
        echo "$CMD halt: done. Everything stays stopped until: $CMD resume"
    else
        die "halt: a root step failed or sudo was refused (above); the agents' processes were killed first, and your commands stay refused. Run $CMD halt again"
    fi
}
resume() {
    local users uids envoy="" line unlock=0
    agent_users
    [ ${#users[@]} -gt 0 ] || die "no agent user is provisioned (to clear a halt left from before: rm $HALTING)"
    # The mark is readable; Envoy's config directory isn't (root decides, and says what it did).
    line=$(sed -n 's/^envoy-stopped-by-halt //p' "$HALT_MARK" 2>/dev/null || true)
    if [ -n "$line" ] || grep -qx envoy-claim-pending "$HALT_MARK" 2>/dev/null; then envoy=", and lift airlock-envoy's kill switch if it is still the one the halt turned on"
    elif have_apply; then envoy=" (airlock-envoy: no kill switch of a halt to lift, left as it is)"
    fi
    # Unlocked when halted: resume ends with the unlock (read before root removes the mark).
    ! grep -qx envoy-locked-by-halt "$HALT_MARK" 2>/dev/null || unlock=1
    echo "$CMD resume: as root, unmask and start the user managers of ${users[*]} (their sessions come"
    echo "back by themselves)$envoy."
    echo "sudo asks for your password for that."
    sudo -- /bin/bash -c "$ROOT_RESUME" resume "$HALT_MARK" "$ENVOY_STOPPED" "$ENVOY_SBIN" "${uids[@]}" || die "resume: a root step failed (above); run $CMD resume again"
    rm -f "$HALTING"
    if [ "$unlock" = 1 ] && have_cred; then
        echo "==> unlocking airlock-envoy's pass credentials (unlocked when you halted): airlock-envoy-cred unlock"
        "$ENVOY_SBIN/airlock-envoy-cred" unlock || echo "    not unlocked (above): $ENVOY_SBIN/airlock-envoy-cred unlock when you're ready"
    elif [ "$unlock" = 1 ]; then
        echo "    airlock-envoy's credentials were unlocked when you halted, and $ENVOY_SBIN/airlock-envoy-cred is gone: not unlocked"
    fi
    echo "$CMD resume: done."
}

cmd="${1:-ls}"; shift || true
case "$cmd" in
    halt|resume|audit|-h|--help|help) ;;   # audit: reads the store only, nothing of the agents
    _complete) ! halted || exit 0 ;;   # nothing reaches a halted agent, completion included
    *) ! halted || die "halted ($CMD halt): $CMD resume first" ;;
esac
case "$cmd" in
    halt) [ $# = 0 ] || die "usage: $CMD halt"; halt ;;
    resume) [ $# = 0 ] || die "usage: $CMD resume"; resume ;;
    ls|list)
        octl list-units --all --full --no-legend --plain "$UNIT*.service" 2>/dev/null \
            | awk -v pre="$UNIT" '{ u=$1; if (index(u, pre) == 1) u = substr(u, length(pre) + 1); sub(/\.service$/,"",u); printf "%-40s %s/%s\n", u, $3, $4 }'
        web_waiting_line ;;
    new)
        [ $# -ge 1 ] || die "usage: $CMD new <project> [name]"
        s="$(session "$@")"
        fresh "$UNIT$s.service"
        octl enable --now "$UNIT$s.service"
        echo "started $s: $CMD attach $s" ;;
    attach)
        if [ $# -ge 1 ]; then s="$(target "$1")" || exit 1; else s="$(only_session attach)" || exit 1; fi
        oexec /usr/bin/tmux -S "$(sock "$s")" attach ;;
    stop)
        if [ $# -ge 1 ]; then s="$(target "$1")" || exit 1; else s="$(only_session stop)" || exit 1; fi
        octl disable --now "$UNIT$s.service" ;;
    restart)
        if [ $# -ge 1 ]; then s="$(target "$1")" || exit 1; else s="$(only_session restart)" || exit 1; fi
        fresh "$UNIT$s.service"
        octl reset-failed "$UNIT$s.service" 2>/dev/null || true
        octl restart "$UNIT$s.service" ;;
    paste)
        # The clipboard's image as a PNG (lib/clipboard-image.sh, shared with `airlock paste`).
        # Read and converted in a directory of our own, never in pastes/ (a converter writing to
        # a name planted there would write through it: pentest O22), then copied in under a
        # mktemp name and renamed, so no half-written file ever looks like a finished paste.
        # shellcheck source=lib/clipboard-image.sh
        . "${AGENTS_CLIP_LIB:-/usr/local/lib/airlock-agents/clipboard-image.sh}"
        clip_abs_path
        clip_backend || die "$CLIP_ERR"
        [ -d "$INBOX/pastes" ] && [ -w "$INBOX/pastes" ] || die "$INBOX/pastes missing or not writable (airlock-agents-apply)"
        work="$(mktemp -d)" || die "no private work directory (\$TMPDIR)"
        pub=""
        trap 'rm -rf -- "$work"; [ -z "$pub" ] || rm -f -- "$pub"' EXIT
        clip_png "$work/raw" "$work/png" || die "$CLIP_ERR"
        f="$INBOX/pastes/$(date +%Y%m%d-%H%M%S%3N).png"
        pub="$(mktemp --suffix=.work "$INBOX/pastes/.paste.XXXXXX")" || die "could not write in $INBOX/pastes"
        { cp -- "$work/png" "$pub" && chmod 0640 "$pub" && mv -fT -- "$pub" "$f"; } || die "could not move the image into $INBOX/pastes"
        pub=""
        # The clipboard writer forks an owner that keeps stdout open: never hang a caller's $(...).
        if case "$CLIP_BACKEND" in
               wayland) printf '%s' "$f" | wl-copy >/dev/null 2>&1 ;;
               x11)     printf '%s' "$f" | xclip -selection clipboard -i >/dev/null 2>&1 ;;
           esac; then echo "$f (path on the clipboard)"
        else echo "$f (could not put the path on the clipboard)"; fi ;;
    update)
        # Your installed version (what your own boxes run), not the checkout: bundled into the
        # inbox, installed by the agent, then the web, guard and auditor users (when provisioned) from there,
        # then removed. On any failure the bundle stays for a look (tmpfiles removes it within
        # a day, or at the next boot).
        bundle="$HOME/.local/share/claude-airlock/current/bin/bundle.sh"
        [ -x "$bundle" ] || die "no installed claude-airlock with bundles ($bundle): make install-airlock in claude-airlock first"
        [ -d "$INBOX/airlock" ] && [ -w "$INBOX/airlock" ] || die "$INBOX/airlock missing or not writable (airlock-agents-apply)"
        "$bundle" "$INBOX/airlock"
        failed=()
        for AS in "$AGENT" $WEB $GUARD $AUDITOR; do
            if [ "$AS" != "$AGENT" ] && ! getent passwd "$AS" >/dev/null; then
                echo "$AS: not provisioned, skipped"; continue
            fi
            echo "==> $AS"
            if orun /bin/bash "$INBOX/airlock/install-bundle.sh"; then echo "$AS has it"
            else failed+=("$AS"); fi
        done
        AS=$AGENT
        [ ${#failed[@]} -eq 0 ] || die "the install failed for ${failed[*]} (above); the bundle stays in $INBOX/airlock for a look"
        "$bundle" --clean "$INBOX/airlock"
        echo "done; restart running sessions to use it ($CMD restart <session>)" ;;
    shell)
        oexec /bin/bash -l ;;
    reload)
        # Each user manager's units after an apply changes them; the web and guard users' workers'
        # path and timer units started too (enabled by airlock-agents-apply).
        rc=0
        for AS in "$AGENT" $WEB $GUARD $AUDITOR; do
            if [ "$AS" != "$AGENT" ] && ! getent passwd "$AS" >/dev/null; then continue; fi
            octl daemon-reload || rc=1
            case "$AS" in "$WEB"|"$GUARD") octl start "$AS-worker.path" "$AS-worker.timer" || rc=1 ;; esac
        done
        AS=$AGENT
        exit "$rc" ;;
    web)
        [ -n "$WEB" ] || die "no web research here (agents.conf has no web and guard users)"
        web "$@" ;;
    audit)
        audit "$@" ;;
    _complete)
        # For the shell completion (share/completion.zsh, .bash): names only, one per line, a tab,
        # then a short description. Each name is checked against its shape and every description
        # cleaned, so nothing from a session or the queue reaches the terminal raw.
        exec </dev/null
        case "${1:-}" in
            sessions)
                # checked raw, before any cleaning: a name cleaning would change is not offered
                OCTL_RAW=1 octl list-units --all --full --no-legend --plain "$UNIT*.service" 2>/dev/null \
                    | LC_ALL=C awk -v pre="$UNIT" '{ u = $1; if (index(u, pre) != 1 || !sub(/\.service$/, "", u)) next
                                                    printf "%s\t%s/%s\n", substr(u, length(pre) + 1), $3, $4 }' \
                    | LC_ALL=C grep -aE $'^[A-Za-z0-9][A-Za-z0-9_-]{0,63}\\.[A-Za-z0-9][A-Za-z0-9_-]{0,63}\t[a-z-]+/[a-z-]+$' || true ;;
            web-sessions)
                [ -n "$WEB" ] || exit 0
                web_running | while IFS= read -r n; do name_ok "$n" && printf '%s\trunning\n' "$n"; done || true ;;
            ids)
                # Newest first, at most 50, each id one the verb accepts (its state as web_state
                # says). Candidates come from where each verb's ids live (held/, quarantine/, the
                # stage logs; requests/ for show), only ids that have a request, gathered in one
                # bounded pass (complete_ids) that reads only the logs the verb needs: no file the
                # agent or the workers write can bury the real ones or blow up the work here.
                [ -n "$WEB" ] || exit 0
                verb="${2:-show}"
                case "$verb" in show|approve|reject|release|retry) ;; *) exit 0 ;; esac
                declare -A wl=() gl=()
                cands=()
                while IFS=$'\t' read -r k i st; do
                    case "$k" in C) cands+=("$i") ;; W) wl[$i]=$st ;; G) gl[$i]=$st ;; esac
                done < <(complete_ids "$verb")
                n=0
                for id in "${cands[@]}"; do
                    [[ "$id" =~ $ID_RE ]] || continue
                    STAGE_WEB="${wl[$id]:-}" STAGE_GUARD="${gl[$id]:-}"
                    web_state_set "$id"
                    case "$verb:$STATE" in
                        show:*|approve:held|reject:held|release:quarantined) ;;
                        retry:failed*|retry:changed*|"retry:gate failed"*|"retry:quarantined, release failed"*) ;;
                        *) continue ;;
                    esac
                    printf '%s\t%s\n' "$id" "$(printf '%s' "$STATE" | clean | tr -cd '[:print:]' | cut -c1-60)"
                    n=$((n + 1)); [ "$n" -lt 50 ] || break
                done ;;
            *) die "usage: $CMD _complete sessions|web-sessions|ids [verb]" ;;
        esac ;;
    -h|--help|help)
        sed -n '2,/^set -euo/p' "$0" | sed "\$d; s/^# \\{0,1\\}//; s/<command>/$CMD/g" ;;
    *) die "unknown command $cmd (see $CMD --help)" ;;
esac
