            elif [ -e "$QUEUE/quarantine/$id" ]; then
                echo "== quarantined: findings"; qread 1048576 "quarantine/$id/findings.json" || echo "(not a plain file)"
                echo; echo "== the report (normalized)"; qread 1048576 "quarantine/$id/normalized.md" || echo "(not a plain file)"
            elif [ -e "$QUEUE/held/$id.json" ]; then
                echo "== held: the request"; qread 16384 "held/$id.json" || echo "(not a plain file)"; echo
            else echo "$id: $(web_state "$id")"; fi; } | clean ;;
