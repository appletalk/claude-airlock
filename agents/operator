    held = [i for i in set(names("held", ".json")) & set(reqs)
            if not any(exists(p) for p in ("decisions/%s.approve" % i, "decisions/%s.reject" % i,
                                           "answers/%s.md" % i, "quarantine/" + i))]
    cands = newest(held, 50)
elif verb == "release":
    # quarantined and not answered; and only an id the guard tail shows, its last state not a
    # failed release (one whose line scrolled out is unknown: not offered, rather than guessed)
    q = [i for i in set(names("quarantine", "")) & set(reqs) if not exists("answers/%s.md" % i)]
    g = stages(guard, set(q))
    cands = newest([i for i in q if i in g and "release failed, gave up" not in g[i]], 50)
