    ok = [i for i in reqs if any(x in w.get(i, "") for x in ("gave up", "changed")) or "gave up" in g.get(i, "")]
    cands = newest(ok, 50)
else:
    cands = newest(reqs, 50)
    w, g = stages(web, set(cands)), stages(guard, set(cands))
keep = set(cands)
for i in cands:
    print("C\t" + i)
for k, m in (("W", w), ("G", g)):
    for i, st in m.items():
        if i in keep:
            print(k + "\t" + i + "\t" + st)' "$QUEUE" "$1" "$WEB" "$GUARD"
}
web_decide() {  # web_decide approve|reject|release <id>
    local what=$1 id=$2 f held sum=""
    id_ok "$id"
    case $what in
        approve|reject) [ "$(web_state "$id")" = held ] || die "$id is not held ($(web_state "$id"))" ;;
        release) [ "$(web_state "$id")" = quarantined ] || die "$id is not quarantined ($(web_state "$id"))" ;;
    esac
    if [ "$what" = approve ]; then
        # An approval is of this text: its sha256 goes in the marker, and the worker researches the
        # request only while it still hashes to that (the agent can rewrite it at any time).
        held="$(qread 16384 "held/$id.json" | base64 -w0)" || die "$id: the held copy is not readable"
        [ -n "$held" ] || die "$id: the held copy is empty"
        sum="sha256 $(printf '%s' "$held" | base64 -d | sha256sum | cut -d' ' -f1)"
        # Shown with every character outside printable ASCII escaped (\uXXXX): nothing in what is
        # approved can be hidden from the screen (a control sequence clean would drop, bidi
        # reordering, look-alike letters).
        echo "approving exactly this request (characters outside ASCII shown as \\uXXXX):"
        printf '%s' "$held" | base64 -d | python3 -I -c 'import json, sys
data = sys.stdin.buffer.read()
try:
    print(json.dumps(json.loads(data), ensure_ascii=True, indent=1))
except Exception:
    print("(not JSON; the raw bytes)", ascii(data))' | clean; echo
    fi
    f="$QUEUE/decisions/$id.$what"
    printf '%s%s' "$sum" "${sum:+$'\n'}" > "$f.tmp" && chmod 0640 "$f.tmp" && mv -f "$f.tmp" "$f"
    echo "$id: $what recorded; the worker picks it up within minutes"
}
# web ls: the last 24 hours and whatever waits on the operator, newest first, cut to the
# terminal; a closing line says what it left out.
web_ls() {
    local mode=recent cutoff="" id st cl t W shown=0 left=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --waiting) mode=waiting ;;
            --all) mode=all ;;
            --since) [ $# -ge 2 ] || die "--since needs <n>d, <n>h or YYYY-MM-DD"; cutoff="$(since_epoch "$2")"; mode=since; shift ;;
            *) die "usage: $CMD web ls [--waiting | --since <n>d|<n>h|YYYY-MM-DD | --all]" ;;
        esac
        shift
    done
    [ "$mode" != recent ] || cutoff="$(since_epoch 24h)"
    set_cols
    while IFS=$'\x1f' read -r id st cl t; do
        case "$mode" in
            waiting) [ "$cl" = waiting ] || { left=$((left + 1)); continue; } ;;
            recent|since) [ "$cl" = waiting ] || [ "$t" -ge "$cutoff" ] || { left=$((left + 1)); continue; } ;;
        esac
        row "$id" "$st" "$W"; shown=$((shown + 1))
    done < <(web_rows)
    if [ $((shown + left)) = 0 ]; then echo "(no requests)"; return 0; fi
    case "$mode" in
        all) ;;
        waiting) echo "($shown waiting on you; $left others: $CMD web ls --all)" ;;
        *) [ "$left" = 0 ] || echo "($shown shown; $left older: $CMD web ls --since 7d, --all)" ;;
    esac
}
# web purge: delete finished entries from the queue, as root (the answers, logs and quarantine
# are the workers', in root's dirs). Never one in flight. Each id goes to root with the class it
# was picked for, and root checks it again: one that changed meanwhile stays.
web_purge() {
    local mode=old age="" cutoff id st cl t W picked=() n=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --waiting) mode=waiting ;;
            --all) mode=all ;;
            --older-than) [ $# -ge 2 ] || die "--older-than needs <n>d or <n>h"; age=$2; shift ;;
            *) die "usage: $CMD web purge [--older-than <n>d|<n>h] | --waiting | --all" ;;
        esac
        shift
    done
    [ -z "$age" ] || [ "$mode" = old ] || die "--older-than goes with a plain purge, not --waiting or --all"
    age=${age:-7d}
    [[ "$age" =~ ^[1-9][0-9]{0,3}[dh]$ ]] || die "bad age '$age' (<n>d or <n>h)"
    cutoff="$(since_epoch "$age")"
    set_cols
    while IFS=$'\x1f' read -r id st cl t; do
        case "$mode:$cl" in
            old:done) [ "$t" -lt "$cutoff" ] || continue ;;
            all:done|all:waiting|waiting:waiting) ;;
            *) continue ;;
        esac
        case "$st" in
            held) cl=held ;;
            "quarantined, release failed"*) cl=releasefailed ;;
            quarantined*) cl=quarantined ;;
            failed*|changed*|"gate failed"*) cl=failed ;;
        esac
        row "$id" "$st" "$W"; picked+=("$id:$cl"); n=$((n + 1))
    done < <(web_rows)
    [ "$n" -gt 0 ] || { echo "nothing to purge"; return 0; }
    echo
    echo "$CMD web purge: next, as root, delete these $n entries from the queue (request, answer, report,"
    echo "quarantine, held copy, decisions, transcripts; the stage logs keep their lines)."
    echo "sudo asks for your password for that."
    sudo -- /bin/bash -c "$ROOT_PURGE" purge "$QUEUE" "$WEB" "$GUARD" "${picked[@]}" || die "purge: a step failed (above)"
}
# shellcheck disable=SC2016  # expanded by the root shell, on purpose
ROOT_PURGE='
