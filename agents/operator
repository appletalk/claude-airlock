#!/bin/bash
# The operator command (installed under the site's name, agents.conf `command`; default the agent
# user's name): the operator's handle on the agent's Claude sessions (docs/agents.md). Each
# session is <agent>-session@<project>.<name>.service in the agent's user manager: a tmux server
# holding the boxed Claude for /home/<agent>/development/<project>. Run as the operator; polkit
# lets the operator (only) open a shell as the agent users, and everything on their side runs
# inside that user's manager (its own network namespace and /tmp), never in the login session
# machinectl opens.
#
#   <command> ls | list                 sessions and their state (also plain `<command>`)
#   <command> new <project> [name]      start one (name: main) and keep it across reboots
#   <command> attach [<project>[.name]] join its tmux (detach: Ctrl-b d; the session keeps running);
#                                       with none, the one session running
#   <command> stop|restart [<session>]  stop it (and don't start it at boot) / restart it
#                                       (a bare <project> only while it has a single session; none:
#                                       the one session running)
#   <command> paste                     the clipboard image into the inbox's pastes/
#   <command> update                    give the agent users the claude-airlock you have installed
#                                       (a bundle through the inbox; they build nothing)
#   <command> shell                     a shell as the agent, inside its user manager (setup work)
#   <command> reload                    reload the agents' user units (after an apply changes them)
#                                       and start the web research queue workers
#
# Emergency stop (something has gone wrong):
#   <command> halt                      kill every process of the agent users at once (no
#                                       prompt), then, with sudo: mask, kill and stop their user
#                                       managers (nothing restarts them, a reboot included) and,
#                                       if airlock-envoy is installed, cut its egress (kill
#                                       switch) and lock its credentials
#   <command> resume                    undo halt (sudo; a kill switch halt didn't set stays on),
#                                       then unlock Envoy's credentials if they were unlocked when halted
#
# Web research (when agents.conf has web and guard users):
#   <command> web [name]                attach to the interactive session (main, started if needed;
#                                       a named one only while it runs); a fresh box, ends after 1 h idle
#   <command> web new <name>            start another one and attach
#   <command> web stop|restart [name]   end it / a fresh one now (a bare one only while one runs)
#   <command> web ask "<question>"      queue a question as the operator
#   <command> web ls [--waiting | --since <n>d|<n>h|YYYY-MM-DD | --all]
#                                       the last 24 h and what waits on you (held, quarantined,
#                                       failed), newest first; --waiting: only that
#   <command> web show [id]             the answer, the quarantine findings, or the held question
#                                       (no id: the newest request)
#   <command> web approve|reject <id>   a held question (no id: the candidates)
#   <command> web release <id>          a quarantined answer, after a look (no id: the candidates)
#   <command> web retry <id>            an id a worker gave up on, from the start
#   <command> web purge [--older-than <n>d|<n>h] | --waiting | --all
#                                       delete finished entries older than 7 days (sudo);
#                                       --waiting: what waits on you; --all: both. Never one in flight
#   An id can be given by its last 6 characters.
#   <command> web login [research|gate|chat]   /login in each workspace's box (all three if none given)
set -euo pipefail
# Internal to this script (set per call below), never taken from the caller's environment.
unset OCTL_RAW STAGE_WEB STAGE_GUARD STATE

# The site's names (rendered by airlock-agents-apply from agents.conf).
# shellcheck source=/dev/null
. "${AIRLOCK_AGENTS_ENV:-/etc/claude-airlock/agents/agents.env}"
CMD=$AGENTS_COMMAND
AGENT=$AGENTS_AGENT
AS=$AGENT   # whose side oexec, octl and orun reach (update sets each user in turn)
UNIT=$AGENT-session@
INBOX=$AGENTS_INBOX
die() { echo "$CMD: $*" >&2; exit 1; }
# The processes a host shell as an agent user leaves in the host's own namespaces (the attach
# client, octl's and orun's shell, systemctl and systemd-run) run from execute-only copies
# (0711, root's: airlock-agents-apply, refreshed by a package manager hook). The user can't read
# them, so the kernel makes those processes non-dumpable and the user's sandboxed code can't look
# through /proc/<pid>/root into the host's unsandboxed tree (R1, docs/agents.md). Never the
# readable originals.
ND="${AGENTS_NODUMP_DIR:-$AGENTS_LIB/bin}"   # test knob: the tests point it at stubs
nd_ok() {
    local b
    for b in sh systemd-run systemctl; do [ "$(stat -c %u:%g:%a "$ND/$b" 2>/dev/null)" = 0:0:711 ] || { echo "$b"; return 1; }; done
}
nd_check() {
    local b
    b="$(nd_ok)" || die "$ND/$b missing or not root's 0711: sudo airlock-agents-apply --confirm (the execute-only copies)"
}
# Every agent-side process goes through a host shell as the agent user (the one polkit action
# the operator has) and from there into its user manager, so it gets the manager's sandbox.
oexec() { nd_check; exec machinectl shell -q "$AS@" "$ND/systemd-run" --user --pty --wait --collect --quiet --same-dir -- "$@"; }
# Text from the agents' side on its way to the operator's terminal: NUL, bidi controls (which
# reorder what the operator reads), CSI and OSC sequences, C1 controls
# (U+0080-U+009F, which a terminal can read as ESC sequences) and every other control
# character dropped; tab and newline stay. C0 goes before C1, and C1 as whole runs of 0xC2
# and 0x80-0x9F bytes, so no deletion can join the two bytes of a C1 control around it.
clean() {
    # NUL and the bidi controls first, so neither can split a sequence the rest removes.
    # Until nothing changes: a deletion can join the bytes around it into a new control.
    LC_ALL=C sed -u -E -e ':a' -e 's/\x00//g' \
        -e $'s#\xe2\x80[\x8e\x8f\xaa-\xae]##g; s#\xe2\x81[\xa6-\xa9]##g; s#\xd8\x9c##g' \
        -e $'s#\x1b\\[[0-?]*[ -/]*[@-~]##g; s#\x1b\\][^\x07\x1b]*(\x07|\x1b\\\\)##g; s#\xc2\x9b[0-?]*[ -/]*[@-~]##g; s#\xc2\x9d[^\x07\x1b\xc2]*(\x07|\x1b\\\\|\xc2\x9c)##g; s#[\x01-\x08\x0b-\x1f\x7f]##g; s#\xc2+[\x80-\x9f]+##g' -e 'ta'
}
# machinectl shell doesn't return the remote exit status, and the remote side has a pty: no
# pager, no colours, the status carried back on a marker line, the output cleaned.
octl() {
    local out rc
    nd_check
    # shellcheck disable=SC2016  # expanded by the remote sh, on purpose
    out="$(machinectl shell -q -E SYSTEMD_PAGER=cat -E SYSTEMD_COLORS=0 "$AS@" "$ND/sh" -c \
        'nd=$1; shift; "$nd/systemctl" --user --no-pager "$@" 2>&1; echo "agent-rc=$?"' sh "$ND" "$@" | tr -d '\r')"
    rc="$(printf '%s\n' "$out" | sed -n 's/^agent-rc=\([0-9][0-9]*\)$/\1/p' | tail -1)"
    # OCTL_RAW: uncleaned, for a caller that keeps only lines of a strict shape (no control bytes)
    printf '%s\n' "$out" | LC_ALL=C grep -av '^agent-rc=[0-9]*$' | if [ -n "${OCTL_RAW:-}" ]; then cat; else clean; fi || true
    return "${rc:-1}"
}
sock() { printf '/run/user/%s/%s-%s.sock' "$AGENTS_AGENT_UID" "$AGENT" "$1"; }
# Run a command in $AS's user manager and return its exit status: its output streams back
# cleaned, and the status comes on a marker line of its own, which only counts as the very
# last line. Advisory: the agent controls what runs there, so it can claim any status; a false
# one only costs the operator a kept or a removed bundle. A command killed by a signal fails (systemd
# would count TERM, HUP, INT and PIPE as a clean exit).
orun() {
    local rc=1 line last="" have=0
    nd_check
    # shellcheck disable=SC2016  # expanded by the remote sh, on purpose
    while IFS= read -r line || [ -n "$line" ]; do
        [ "$have" = 0 ] || printf '%s\n' "$last"
        last=$line have=1
    done < <(machinectl shell -q "$AS@" "$ND/sh" -c \
        'nd=$1; shift; "$nd/systemd-run" --user --wait --pipe --collect --quiet -- /bin/sh -c '"'"'trap "exit 143" TERM HUP INT PIPE; "$@"'"'"' sh "$@" 2>&1; printf "\nagent-rc=%s\n" "$?"' sh "$ND" "$@" \
        | clean)
    if [[ "$last" =~ ^agent-rc=([0-9]{1,3})$ ]]; then rc=${BASH_REMATCH[1]}
    elif [ "$have" = 1 ]; then printf '%s\n' "$last"; fi
    return "$rc"
}

# Before a start or restart: a unit an apply rewrote since $AS's manager read it would start as the
# old one (a reload doesn't touch what runs, so it is done here rather than left to the operator).
fresh() {
    [ "$(OCTL_RAW=1 octl show -p NeedDaemonReload --value "$1" 2>/dev/null)" = yes ] || return 0
    echo "$1 changed on disk since $AS's manager read it: reloading first"
    octl daemon-reload || die "the reload failed (above); $1 not started"
}

name_ok() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$ ]]; }
session() {  # session <project>[.name] or <project> <name> -> <project>.<name>
    local p=${1%%.*} n=${2:-}
    [[ "$1" != *. ]] || die "bad session name '$1' (<project>.<name>)"
    [[ "$1" == *.* ]] && n=${1#*.}
    n=${n:-main}
    if ! name_ok "$p" || ! name_ok "$n"; then die "bad session name '$1${2:+ $2}' (letters, digits, - and _)"; fi
    printf '%s.%s' "$p" "$n"
}

# The session a bare `<command> attach|stop|restart` means: the one running, never a guess.
only_session() {  # only_session <cmd>
    local found
    found="$(octl list-units --state=active --full --no-legend --plain "$UNIT*.service" 2>/dev/null \
        | awk -v pre="$UNIT" '{ u = $1; if (index(u, pre) == 1 && sub(/\.service$/, "", u)) print substr(u, length(pre) + 1) }')" || true
    case "$(printf '%s' "$found" | grep -c .)" in
        0) die "no session is running ($CMD ls; $CMD new <project>)" ;;
        1) session "$found" ;;
        *) die "several sessions run ($(printf '%s' "$found" | tr '\n' ' ' | sed 's/ $//')): say which, e.g. $CMD $1 $(printf '%s' "$found" | head -1)" ;;
    esac
}
# The one session a stop, restart or attach means: <project>.<name> as given, or a bare
# <project> only while that project has exactly one session, counting every one that ever ran
# (its id file in the agent's ~/.local/state/<agent>-session) as well as the loaded units: a
# stopped one drops out of systemd's list but is still one the operator may mean. With several, say which
# (never guess: a restart or stop of the wrong one throws away its work).
target() {
    local p=$1 found
    if [[ "$p" == *.* ]]; then session "$p"; return; fi
    name_ok "$p" || die "bad session name '$p' (letters, digits, - and _)"
    found="$( {
        octl list-units --all --full --no-legend --plain "$UNIT$p.*.service" 2>/dev/null \
            | awk -v pre="$UNIT" '{ u = $1; if (index(u, pre) == 1 && sub(/\.service$/, "", u)) print substr(u, length(pre) + 1) }'
        # shellcheck disable=SC2016  # $HOME is the agent's: expanded on its side
        orun /bin/sh -c 'ls -1 "$HOME/.local/state/$1-session" 2>/dev/null' sh "$AGENT" 2>/dev/null \
            | sed -n 's/\.id$//p'
    } | awk -v p="$p" 'index($0, p ".") == 1' | sort -u)" || true
    case "$(printf '%s' "$found" | grep -c .)" in
        0) [ "$p" != web ] || die "$WEB's sessions are $CMD web's: $CMD web"
           die "no session for $p ($CMD ls); give its full name, <project>.<name>" ;;
        1) session "$found" ;;
        *) die "$p has several sessions ($(printf '%s' "$found" | tr '\n' ' ' | sed 's/ $//')): say which, e.g. $CMD $cmd $(printf '%s' "$found" | head -1)" ;;
    esac
}

# --- web research ------------------------------------------------------------------------------
# The operator's side of the queue: what the operator may read and write there directly (the
# queue's ACLs), the rest through the web and guard users' managers. Everything shown from the
# queue is the agent's or the web's text: it goes through clean, never raw to the terminal.
QUEUE=$AGENTS_QUEUE
WEB=$AGENTS_WEB GUARD=$AGENTS_GUARD
ID_RE='^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{6}$'
id_ok() { [[ "$1" =~ $ID_RE ]] || die "not an id: '$1' ($CMD web ls)"; }
wsock() { printf '/run/user/%s/%s-%s.sock' "$AGENTS_WEB_UID" "$WEB" "$1"; }
# The running interactive sessions' names. Every list-units here takes --full: machinectl's remote
# side has a terminal, and systemctl cuts long unit names to its width ("<web>-session@main.servi...").
web_running() {
    AS=$WEB octl list-units --state=active --full --no-legend --plain "$WEB-session@*.service" 2>/dev/null \
        | awk -v pre="$WEB-session@" '{ u = $1; if (index(u, pre) == 1 && sub(/\.service$/, "", u)) print substr(u, length(pre) + 1) }'
}
# The session a bare `<command> web stop|restart` means: the one running, never a guess.
web_target() {  # web_target <cmd> [name]
    local found
    if [ -n "${2:-}" ]; then name_ok "$2" || die "bad session name '$2'"; printf '%s' "$2"; return; fi
    found="$(web_running)"
    case "$(printf '%s' "$found" | grep -c .)" in
        0) die "no $WEB session is running" ;;
        1) printf '%s' "$found" ;;
        *) die "several $WEB sessions run ($(printf '%s' "$found" | tr '\n' ' ' | sed 's/ $//')): say which, e.g. $CMD web $1 $(printf '%s' "$found" | head -1)" ;;
    esac
}
# A queue file's bytes, at most <cap>: only a regular file, reached without following a link
# at any step below the queue (the agent users can plant links and FIFOs in the dirs they
# write). Nothing on stdout otherwise, status 3. The caller cleans what it prints.
qread() {  # qread <cap> <path below the queue>
    python3 -I -c 'import os, stat, sys
root, cap, rel = sys.argv[1], int(sys.argv[2]), sys.argv[3]
try:
    fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY)
    parts = rel.split("/")
    for p in parts[:-1]:
        fd = os.open(p, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
    f = os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd)
    if not stat.S_ISREG(os.fstat(f).st_mode):
        sys.exit(3)
    data = b""
    while len(data) < cap:
        chunk = os.read(f, cap - len(data))
        if not chunk:
            break
        data += chunk
    sys.stdout.buffer.write(data)
except OSError:
    sys.exit(3)' "$QUEUE" "$1" "$2"
}
# The question of a request, one line (a newline in it can't make a row of its own).
question_of() {  # question_of <id>
    qread 16384 "requests/$1.json" | python3 -I -c 'import json, sys
try:
    q = json.loads(sys.stdin.buffer.read()).get("question", "")
    print(" ".join(str(q).split())[:100])
except Exception:
    print("(unreadable request)")'
}
# The last stage line a worker logged for an id, "stage: result" (fields it wrote: ids
# checked, words fixed, so the pattern holds them).
last_stage() {  # last_stage <web>|<guard> <id>: read like any queue file (a FIFO or link a worker
    # user left there must not hang or redirect it), at most 64 MB
    { qread 67108864 "log/$1/stages.jsonl" || true; } | grep -aF "\"id\":\"$2\"" | tail -1 \
        | LC_ALL=C sed -n 's/^.*"stage":"\([a-z]*\)","result":"\([a-z0-9 ,;()'"'"'-]*\)".*$/\1: \2/p'
}
# One word for where an id stands, from what the operator can see. (STAGE_WEB and STAGE_GUARD, when
# set, are the id's last stage lines, read once for many ids by the caller.)
web_state() { web_state_set "$1"; printf '%s\n' "$STATE"; }  # web_state <id>
# The same, into STATE, without a subshell (completion takes many ids at once).
web_state_set() {  # web_state_set <id>
    local id=$1 last
    if [ -e "$QUEUE/answers/$id.md" ]; then
        if [ -e "$QUEUE/quarantine/$id" ]; then STATE="released by $AGENTS_OPERATOR"; else STATE=answered; fi
    elif [ -e "$QUEUE/quarantine/$id" ]; then
        last="${STAGE_GUARD-$(last_stage "$GUARD" "$id")}"
        case "$last" in *"release failed, gave up"*) STATE="quarantined, release failed ($last)" ;; *) STATE=quarantined ;; esac
    elif [ -e "$QUEUE/decisions/$id.reject" ]; then STATE=rejected
    elif [ -e "$QUEUE/held/$id.json" ] && [ ! -e "$QUEUE/decisions/$id.approve" ]; then STATE=held
    else
        last="${STAGE_WEB-$(last_stage "$WEB" "$id")}"
        case "$last" in
            *"gave up"*) STATE="failed ($last)" ;;
            *changed*) STATE="changed after its check ($last)" ;;
            "publish: published"*)
                last="${STAGE_GUARD-$(last_stage "$GUARD" "$id")}"
                case "$last" in *"gave up"*) STATE="gate failed ($last)" ;; *) STATE=gating ;; esac ;;
            "") STATE=queued ;;
            *) STATE="researching ($last)" ;;
        esac
    fi
}
# Where a state leaves the operator: done (answered, released, rejected), waiting (on the
# operator: held, quarantined, failed), or in flight (queued, researching, gating).
state_class() {
    case "$1" in
        answered|"released by "*|rejected) echo "done" ;;
        held|quarantined*|failed*|changed*|"gate failed"*) echo waiting ;;
        *) echo inflight ;;
    esac
}
# The tests set file times with touch (mtime): a test hook, honoured only with the tests' own
# agents.env (AIRLOCK_AGENTS_ENV). A real queue goes by ctime, which no user can set.
WHEN_FIELD=st_ctime
[ -z "${AIRLOCK_AGENTS_ENV:-}" ] || [ "${AGENTS_TEST_WHEN:-}" != mtime ] || WHEN_FIELD=st_mtime
# Every entry, newest first: "<id>US<state>US<class>US<when>" (US = \x1f; a state has spaces).
# An entry is an id in requests/, held/, quarantine/ or answers/ (the agent can delete its
# request and leave the rest). <when> is the epoch of its newest file (an answer that came today
# to an old question is recent), by ctime: the agent picks an id's time, never a file's ctime. The stage logs are read once
# for all ids, whole, as last_stage reads them (no link, a regular file, 64 MB at most).
web_rows() {
    local id w g t cl
    python3 -I -c 'import os, re, stat, sys
root, web, guard, field = sys.argv[1:5]
ID = re.compile(r"[0-9]{8}T[0-9]{6}Z-[0-9a-f]{6}")
def read_log(user):
    try:
        fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY)
        for p in ("log", user):
            fd = os.open(p, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
        f = os.open("stages.jsonl", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd)
        if not stat.S_ISREG(os.fstat(f).st_mode):
            return b""
        data, cap = b"", 67108864
        while len(data) < cap:
            c = os.read(f, min(1048576, cap - len(data)))
            if not c:
                break
            data += c
        return data
    except OSError:
        return b""
STAGE = re.compile(rb""".*"stage":"([a-z]*)","result":"([a-z0-9 ,;()\x27-]*)".*""")
REF = re.compile(rb"(?=\x22id\x22:\x22([0-9]{8}T[0-9]{6}Z-[0-9a-f]{6})\x22)")
def stages(user):
    # each id with the stage of the last line referring to it (grep -F of the reference, tail -1)
    last = {}
    if not user:
        return last
    for line in read_log(user).split(b"\n"):
        ids = REF.findall(line)
        if not ids:
            continue
        m = STAGE.fullmatch(line)
        st = (m.group(1) + b": " + m.group(2)).decode() if m else ""
        for i in ids:
            last[i.decode()] = st
    return last
when = {}
for d, suffix in (("requests", ".json"), ("held", ".json"), ("quarantine", ""), ("answers", ".md")):
    try:
        ents = os.listdir(os.path.join(root, d))
    except OSError:
        continue
    for e in ents:
        if suffix and not e.endswith(suffix):
            continue
        n = e[: -len(suffix)] if suffix else e
        if not ID.fullmatch(n):
            continue
        try:
            t = int(getattr(os.lstat(os.path.join(root, d, e)), field))
        except OSError:
            continue
        when[n] = max(t, when.get(n, 0))
w, g = stages(web), stages(guard)
for i in sorted(when, key=lambda i: (when[i], i), reverse=True):
    print("%s\x1f%s\x1f%s\x1f%d" % (i, w.get(i, ""), g.get(i, ""), when[i]))' "$QUEUE" "$WEB" "$GUARD" "$WHEN_FIELD" \
    | while IFS=$'\x1f' read -r id w g t; do
        [[ "$id" =~ $ID_RE && "$t" =~ ^[0-9]+$ ]] || continue
        STAGE_WEB=$w STAGE_GUARD=$g web_state_set "$id"
        case "$STATE" in
            answered|"released by "*|rejected) cl="done" ;;
            held|quarantined*|failed*|changed*|"gate failed"*) cl=waiting ;;
            *) cl=inflight ;;
        esac
        printf '%s\x1f%s\x1f%s\x1f%s\n' "$id" "$STATE" "$cl" "$t"
    done
}
# A time as epoch seconds, to compare with an entry's <when>.
since_epoch() {  # since_epoch <n>d | <n>h | YYYY-MM-DD (local midnight)
    local t
    if [[ "$1" =~ ^([1-9][0-9]{0,3})([dh])$ ]]; then
        t="${BASH_REMATCH[1]} $([ "${BASH_REMATCH[2]}" = d ] && echo days || echo hours) ago"
    elif [[ "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then t="$1 00:00"
    else die "bad time '$1' (<n>d, <n>h or YYYY-MM-DD)"; fi
    date -d "$t" +%s 2>/dev/null || die "bad time '$1' (<n>d, <n>h or YYYY-MM-DD)"
}
# The width to cut rows to, into W: the terminal's, else 200. Set in the caller (a command
# substitution has no terminal on stdout).
set_cols() {
    local c=""
    W=200
    [ -t 1 ] || return 0
    c="$(stty size </dev/tty 2>/dev/null)" || return 0
    c=${c#* }
    [[ "$c" =~ ^[0-9]+$ ]] && [ "$c" -ge 40 ] && W=$c
    return 0
}
row() {  # row <id> <state> <width>: one cleaned line
    printf '%s  %-28s  %s\n' "$1" "$2" "$(question_of "$1")" | clean | cut -c1-"$3"
}
# An id as given, or its last 6 hex digits when only one request ends in them.
resolve_id() {  # resolve_id <id | 6 hex>
    local f m=() id
    if [[ "$1" =~ $ID_RE ]]; then printf '%s' "$1"; return; fi
    [[ "$1" =~ ^[0-9a-f]{6}$ ]] || die "not an id: '$1' ($CMD web ls)"
    # Every place an id lives, not only requests/: the agent owns its requests and can delete
    # one, leaving its held copy; a short id must never land on another request then.
    for f in "$QUEUE"/requests/*-"$1".json "$QUEUE"/held/*-"$1".json "$QUEUE"/quarantine/*-"$1" "$QUEUE"/answers/*-"$1".md; do
        [ -e "$f" ] || [ -L "$f" ] || continue
        id="${f##*/}"; id="${id%.json}"; id="${id%.md}"
        [[ "$id" =~ $ID_RE ]] || continue
        [[ " ${m[*]} " == *" $id "* ]] || m+=("$id")
    done
    case ${#m[@]} in
        0) die "no request ends in $1 ($CMD web ls)" ;;
        1) printf '%s' "${m[0]}" ;;
        *) die "several requests end in $1: give the whole id (${m[*]})" ;;
    esac
}
# The ids a verb could act on, listed, and a refusal: an approval or release is the operator's
# decision about one request, never "the latest".
candidates() {  # candidates <verb>
    local id st n=0 ok W
    set_cols
    while IFS=$'\x1f' read -r id st _ _; do
        ok=0
        # exactly what each verb accepts
        case "$1:$st" in approve:held|reject:held|release:quarantined|retry:failed*|retry:changed*|"retry:gate failed"*|"retry:quarantined, release failed"*) ok=1 ;; esac
        [ "$ok" = 1 ] || continue
        row "$id" "$st" "$W"; n=$((n + 1))
    done < <(web_rows)
    [ "$n" -gt 0 ] || die "nothing to $1"
    die "say which: $CMD web $1 <id> (or its last 6 characters)"
}
# One line for `<command> ls`: what in the web queue waits on the operator, if anything.
web_waiting_line() {
    local id st h=0 q=0 f=0
    [ -n "$WEB" ] && [ -d "$QUEUE/requests" ] || return 0
    while IFS=$'\x1f' read -r id st _ _; do
        case "$st" in held) h=$((h + 1)) ;; quarantined*) q=$((q + 1)) ;; failed*|changed*|"gate failed"*) f=$((f + 1)) ;; esac
    done < <(web_rows)
    [ $((h + q + f)) -gt 0 ] || return 0
    printf 'web: %s waiting on you (%s held, %s quarantined, %s failed): %s web ls --waiting\n' "$((h + q + f))" "$h" "$q" "$f" "$CMD"
