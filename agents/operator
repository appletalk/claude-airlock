trap "echo \"    (interrupted: going on with the next step)\" >&2; rc=1" INT TERM QUIT
trap "" HUP   # the terminal gone: no step is cut (the steps inherit the ignore)
newnonce() { local n; n=$(od -An -N16 -tx1 /dev/urandom 2>/dev/null | tr -d " \n"); [ -n "$n" ] || n=$(tr -d - < /proc/sys/kernel/random/uuid); printf "%s" "$n"; }
for u; do case "$u" in ""|0|*[!0-9]*) echo "bad uid $u" >&2; exit 2 ;; esac; units+=("user@$u.service"); done
mkdir -p "$(dirname "$mark")"
[ -e "$mark" ] || echo "halted $(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$mark" || rc=1
echo "==> masking and killing ${units[*]}"
systemctl mask "${units[@]}" || rc=1
systemctl kill -s KILL "${units[@]}" 2>/dev/null || true
for u; do loginctl terminate-user "$u" 2>/dev/null || true; done
nonce=$(sed -n "s/^envoy-stopped-by-halt //p" "$mark")
if [ -x "$sbin/airlock-envoy-apply" ] && [ -d "$(dirname "$stopped")" ]; then
    echo "==> airlock-envoy: turning its kill switch on"
    # Ours: none was on, the one on holds our nonce, or a halt cut short claimed it.
    ours=0
    if [ ! -e "$stopped" ]; then ours=1
    elif [ -n "$nonce" ] && [ "$(head -c 64 "$stopped")" = "$nonce" ]; then ours=1
    elif grep -qx envoy-claim-pending "$mark"; then ours=1; fi
    # Decided before the file is touched: a halt cut short after --stop keeps the claim.
    if [ "$ours" = 1 ]; then grep -qx envoy-claim-pending "$mark" || echo envoy-claim-pending >> "$mark" || rc=1; fi
    "$sbin/airlock-envoy-apply" --stop || { rc=1; echo "    FAILED: $sbin/airlock-envoy-apply --stop (above)" >&2; }
    # Claimed on the switch being on, whatever --stop returned (it writes the file first).
    sed -i "/^envoy-stopped-by-halt /d" "$mark" || rc=1
    if [ "$ours" = 1 ] && [ -e "$stopped" ]; then
        nonce=$(newnonce)
        if [ -n "$nonce" ] && printf "%s" "$nonce" > "$stopped" && echo "envoy-stopped-by-halt $nonce" >> "$mark"; then
            sed -i "/^envoy-claim-pending$/d" "$mark" || rc=1
        else rc=1; fi   # the pending claim stays: the next halt claims the switch
    else
        sed -i "/^envoy-claim-pending$/d" "$mark" || rc=1
    fi
elif [ -x "$sbin/airlock-envoy-apply" ]; then
    echo "==> airlock-envoy: no config directory ($(dirname "$stopped")): no kill switch to turn on"
fi
if [ -x "$sbin/airlock-envoy-cred" ]; then
    echo "==> airlock-envoy: locking its credentials"
    was=locked; ! head -n 1 "$credstate" 2>/dev/null | grep -q "^unlocked" || was=unlocked
    if "$sbin/airlock-envoy-cred" lock; then
        [ "$was" != unlocked ] || grep -qx envoy-locked-by-halt "$mark" || echo envoy-locked-by-halt >> "$mark" || rc=1
    else rc=1; echo "    FAILED: $sbin/airlock-envoy-cred lock (above): the credentials may still be unlocked" >&2; fi
fi
echo "==> stopping ${units[*]}"
systemctl stop "${units[@]}" || rc=1
exit "$rc"
'
# shellcheck disable=SC2016  # expanded by the root shell, on purpose
ROOT_RESUME='
umask 022
mark=$1 stopped=$2 sbin=$3; shift 3
rc=0; units=()
newnonce() { local n; n=$(od -An -N16 -tx1 /dev/urandom 2>/dev/null | tr -d " \n"); [ -n "$n" ] || n=$(tr -d - < /proc/sys/kernel/random/uuid); printf "%s" "$n"; }
for u; do case "$u" in ""|0|*[!0-9]*) echo "bad uid $u" >&2; exit 2 ;; esac; units+=("user@$u.service"); done
# Only the kill switch a halt left (its nonce in the file); the line goes once lifted, so a
# retry leaves Envoy alone. A --start that undoes itself writes the switch again: claimed again.
nonce=$(sed -n "s/^envoy-stopped-by-halt //p" "$mark" 2>/dev/null)
# A halt cut short between its --stop and the nonce: the switch it turned on is its own.
if [ -z "$nonce" ] && grep -qx envoy-claim-pending "$mark" 2>/dev/null && [ -e "$stopped" ]; then
    nonce=$(newnonce)
    { [ -n "$nonce" ] && printf "%s" "$nonce" > "$stopped" && echo "envoy-stopped-by-halt $nonce" >> "$mark" && sed -i "/^envoy-claim-pending$/d" "$mark"; } \
        || { rc=1; nonce=""; echo "==> airlock-envoy: could not record the switch of a halt cut short: the agents stay halted, resume again" >&2; }
fi
if [ -n "$nonce" ]; then
    if [ ! -e "$stopped" ]; then
        echo "==> airlock-envoy: its kill switch is off already (if Envoy is not up, $sbin/airlock-envoy-apply --status)"; sed -i "/^envoy-stopped-by-halt /d" "$mark" || rc=1
    elif [ "$(head -c 64 "$stopped")" != "$nonce" ] && ! grep -qx envoy-claim-pending "$mark"; then
        echo "==> airlock-envoy: its kill switch was rewritten since the halt (a --stop, or a --start that failed, by hand): left on ($sbin/airlock-envoy-apply --start lifts it)"
        sed -i "/^envoy-stopped-by-halt /d" "$mark" || rc=1
    elif [ ! -x "$sbin/airlock-envoy-apply" ]; then
        echo "==> airlock-envoy: the halt turned its kill switch on, and $sbin/airlock-envoy-apply is gone: reinstall airlock-envoy and resume again, or give the switch up (sudo rm $stopped)" >&2; rc=1
    else
        echo "==> airlock-envoy: kill switch off (applies, starts everything); your own boxes on its sockets need a relaunch (new socket files)"
        if "$sbin/airlock-envoy-apply" --start; then sed -i "/^envoy-stopped-by-halt /d" "$mark" || rc=1
        else
            rc=1
            if [ -e "$stopped" ]; then
                nonce=$(newnonce)
                # The record first: a write cut between leaves a claim the next resume re-claims.
                [ -n "$nonce" ] && sed -i "s/^envoy-stopped-by-halt .*/envoy-stopped-by-halt $nonce/; \$a envoy-claim-pending" "$mark" && printf "%s" "$nonce" > "$stopped" && sed -i "/^envoy-claim-pending$/d" "$mark"
            fi
        fi
    fi
elif [ -x "$sbin/airlock-envoy-apply" ]; then
    echo "==> airlock-envoy: no kill switch of a halt to lift: left as it is ($sbin/airlock-envoy-apply --start lifts one)"
fi
# The agents come back only with what they had: an Envoy step that failed keeps them halted.
if [ "$rc" != 0 ]; then
    echo "==> the agents stay halted until that is fixed: resume again" >&2
    exit "$rc"
fi
echo "==> unmasking and starting ${units[*]}"
systemctl unmask "${units[@]}" || rc=1
systemctl start "${units[@]}" || rc=1
[ "$rc" != 0 ] || rm -f "$mark"
exit "$rc"
'
agent_users() {  # users[] and uids[]: the provisioned agent users
    local u uid
    users=() uids=()
    for u in "$AGENT" $WEB $GUARD; do
        uid="$(getent passwd "$u" | cut -d: -f3)" || continue
        [ -n "$uid" ] || continue
        users+=("$u"); uids+=("$uid")
    done
}
halt() {
    local u log users uids
    agent_users
    [ ${#users[@]} -gt 0 ] || die "no agent user is provisioned"
    log="${XDG_STATE_HOME:-$OPHOME/.local/state}/airlock-agents/halt-$(date -u +%Y%m%dT%H%M%SZ).log"
    # Nothing before the root steps may stop them: a full disk (a runaway agent's) or an
    # unwritable state dir costs the record and the mark, never the kill.
    mkdir -p "$(dirname "$log")" 2>/dev/null || true
    # The record, first (bounded: 2 s, 256 KiB), to the log only: an agent's flood can't hold
    # up the kill or the terminal. Their command lines are theirs to write: cleaned.
    { { echo "halt $(date -u +%Y-%m-%dT%H:%M:%SZ) by $(id -un): ${users[*]}"
        timeout -k 1 2 ps -o user=,pid=,etime=,args= -u "$(IFS=,; echo "${uids[*]}")" 2>/dev/null | head -c 262144 || true
      } | clean | cut -c1-200 > "$log"; } 2>/dev/null || { log=""; echo "    (no record: the state directory can't be written)"; }
    # 1. Now, as the operator (no prompt): each agent user kills every process it may signal,
    # its boxes too (their uids are mapped in a user namespace it owns), and its own manager.
    # All at once, never on the terminal (machinectl would take it: a background job under
    # timeout stops on it, and typed-ahead keys would go to a pty the agent owns).
    echo "==> killing every process of ${users[*]}"
    { mkdir -p "${HALTING%/*}" && : > "$HALTING"; } 2>/dev/null || echo "    (no halting mark: the state directory can't be written; your other commands still work until root's mask)"
    if nd_ok >/dev/null; then
        local pids=() i
        for u in "${users[@]}"; do
            timeout -k 2 10 machinectl shell -q "$u@" "$ND/sh" -c 'kill -KILL -1' </dev/null >/dev/null 2>&1 & pids+=($!)
        done
        for i in "${!users[@]}"; do
            # machinectl shell doesn't return the remote status: this says only that it ran
            if wait "${pids[$i]}"; then echo "    ${users[$i]}: kill sent"
            else echo "    ${users[$i]}: could not (left to root's kill, next)"; fi
        done
    else
        echo "    (the execute-only copies are missing: left to root's kill, next)"
    fi
    if [ -n "$log" ]; then
        echo "What was running (all in $log):"
        sed -n '2,21p' "$log" | sed 's/^/    /'
    fi
    # 2. As root: nothing restarts them.
    echo
    echo "$CMD halt: next, as root, so nothing starts them again (a reboot included): mask, kill and"
    echo "stop the user managers of ${users[*]}$(have_apply && echo ", cut airlock-envoy's egress")$(have_cred && echo ", lock airlock-envoy's credentials")."
    echo "sudo asks for your password for that."
    if sudo -- /bin/bash -c "$ROOT_HALT" halt "$HALT_MARK" "$ENVOY_STOPPED" "$ENVOY_SBIN" "$ENVOY_CRED_STATE" "${uids[@]}"; then
        echo "$CMD halt: done. Everything stays stopped until: $CMD resume"
    else
        die "halt: a root step failed or sudo was refused (above); the agents' processes were killed first, and your commands stay refused. Run $CMD halt again"
    fi
}
resume() {
    local users uids envoy="" line unlock=0
    agent_users
    [ ${#users[@]} -gt 0 ] || die "no agent user is provisioned (to clear a halt left from before: rm $HALTING)"
    # The mark is readable; Envoy's config directory isn't (root decides, and says what it did).
    line=$(sed -n 's/^envoy-stopped-by-halt //p' "$HALT_MARK" 2>/dev/null || true)
    if [ -n "$line" ] || grep -qx envoy-claim-pending "$HALT_MARK" 2>/dev/null; then envoy=", and lift airlock-envoy's kill switch if it is still the one the halt turned on"
    elif have_apply; then envoy=" (airlock-envoy: no kill switch of a halt to lift, left as it is)"
    fi
    # Unlocked when halted: resume ends with the unlock (read before root removes the mark).
    ! grep -qx envoy-locked-by-halt "$HALT_MARK" 2>/dev/null || unlock=1
    echo "$CMD resume: as root, unmask and start the user managers of ${users[*]} (their sessions come"
    echo "back by themselves)$envoy."
    echo "sudo asks for your password for that."
    sudo -- /bin/bash -c "$ROOT_RESUME" resume "$HALT_MARK" "$ENVOY_STOPPED" "$ENVOY_SBIN" "${uids[@]}" || die "resume: a root step failed (above); run $CMD resume again"
    rm -f "$HALTING"
    if [ "$unlock" = 1 ] && have_cred; then
        echo "==> unlocking airlock-envoy's pass credentials (unlocked when you halted): airlock-envoy-cred unlock"
        "$ENVOY_SBIN/airlock-envoy-cred" unlock || echo "    not unlocked (above): $ENVOY_SBIN/airlock-envoy-cred unlock when you're ready"
    elif [ "$unlock" = 1 ]; then
        echo "    airlock-envoy's credentials were unlocked when you halted, and $ENVOY_SBIN/airlock-envoy-cred is gone: not unlocked"
    fi
    echo "$CMD resume: done."
}

cmd="${1:-ls}"; shift || true
case "$cmd" in
    halt|resume|-h|--help|help) ;;
    _complete) ! halted || exit 0 ;;   # nothing reaches a halted agent, completion included
    *) ! halted || die "halted ($CMD halt): $CMD resume first" ;;
esac
case "$cmd" in
    halt) [ $# = 0 ] || die "usage: $CMD halt"; halt ;;
    resume) [ $# = 0 ] || die "usage: $CMD resume"; resume ;;
    ls|list)
        octl list-units --all --full --no-legend --plain "$UNIT*.service" 2>/dev/null \
            | awk -v pre="$UNIT" '{ u=$1; if (index(u, pre) == 1) u = substr(u, length(pre) + 1); sub(/\.service$/,"",u); printf "%-40s %s/%s\n", u, $3, $4 }'
        web_waiting_line ;;
    new)
        [ $# -ge 1 ] || die "usage: $CMD new <project> [name]"
        s="$(session "$@")"
        fresh "$UNIT$s.service"
        octl enable --now "$UNIT$s.service"
        echo "started $s: $CMD attach $s" ;;
    attach)
        if [ $# -ge 1 ]; then s="$(target "$1")" || exit 1; else s="$(only_session attach)" || exit 1; fi
        oexec /usr/bin/tmux -S "$(sock "$s")" attach ;;
    stop)
        if [ $# -ge 1 ]; then s="$(target "$1")" || exit 1; else s="$(only_session stop)" || exit 1; fi
        octl disable --now "$UNIT$s.service" ;;
    restart)
        if [ $# -ge 1 ]; then s="$(target "$1")" || exit 1; else s="$(only_session restart)" || exit 1; fi
        fresh "$UNIT$s.service"
        octl reset-failed "$UNIT$s.service" 2>/dev/null || true
        octl restart "$UNIT$s.service" ;;
    paste)
        # Wayland (wl-clipboard), else X11 (xclip).
        if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-paste >/dev/null; then
            cb_get() { wl-paste --type image/png; }; cb_put() { wl-copy; }
        elif [ -n "${DISPLAY:-}" ] && command -v xclip >/dev/null; then
            cb_get() { xclip -selection clipboard -t image/png -o; }; cb_put() { xclip -selection clipboard; }
        else die "no clipboard tool: wl-clipboard (Wayland) or xclip (X11)"; fi
        [ -d "$INBOX/pastes" ] && [ -w "$INBOX/pastes" ] || die "$INBOX/pastes missing or not writable (airlock-agents-apply)"
        f="$INBOX/pastes/$(date +%Y%m%d-%H%M%S%3N).png"
        cb_get > "$f.tmp" && [ -s "$f.tmp" ] || { rm -f "$f.tmp"; die "no image on the clipboard"; }
        chmod 0640 "$f.tmp" && mv "$f.tmp" "$f"
        printf '%s' "$f" | cb_put
        echo "$f (path on the clipboard)" ;;
    update)
        # Your installed version (what your own boxes run), not the checkout: bundled into the
        # inbox, installed by the agent, then the web and guard users (when provisioned) from there,
        # then removed. On any failure the bundle stays for a look (tmpfiles removes it within
        # a day, or at the next boot).
        bundle="$HOME/.local/share/claude-airlock/current/bin/bundle.sh"
        [ -x "$bundle" ] || die "no installed claude-airlock with bundles ($bundle): make install-airlock in claude-airlock first"
        [ -d "$INBOX/airlock" ] && [ -w "$INBOX/airlock" ] || die "$INBOX/airlock missing or not writable (airlock-agents-apply)"
        "$bundle" "$INBOX/airlock"
        failed=()
        for AS in "$AGENT" $WEB $GUARD; do
            if [ "$AS" != "$AGENT" ] && ! getent passwd "$AS" >/dev/null; then
                echo "$AS: not provisioned, skipped"; continue
            fi
            echo "==> $AS"
            if orun /bin/bash "$INBOX/airlock/install-bundle.sh"; then echo "$AS has it"
            else failed+=("$AS"); fi
        done
        AS=$AGENT
        [ ${#failed[@]} -eq 0 ] || die "the install failed for ${failed[*]} (above); the bundle stays in $INBOX/airlock for a look"
        "$bundle" --clean "$INBOX/airlock"
        echo "done; restart running sessions to use it ($CMD restart <session>)" ;;
    shell)
        oexec /bin/bash -l ;;
    reload)
        # Each user manager's units after an apply changes them; the web and guard users' workers'
        # path and timer units started too (enabled by airlock-agents-apply).
        rc=0
        for AS in "$AGENT" $WEB $GUARD; do
            if [ "$AS" != "$AGENT" ] && ! getent passwd "$AS" >/dev/null; then continue; fi
            octl daemon-reload || rc=1
            [ "$AS" = "$AGENT" ] || octl start "$AS-worker.path" "$AS-worker.timer" || rc=1
        done
        AS=$AGENT
        exit "$rc" ;;
    web)
        [ -n "$WEB" ] || die "no web research here (agents.conf has no web and guard users)"
        web "$@" ;;
    _complete)
        # For the shell completion (share/completion.zsh, .bash): names only, one per line, a tab,
        # then a short description. Each name is checked against its shape and every description
        # cleaned, so nothing from a session or the queue reaches the terminal raw.
        exec </dev/null
        case "${1:-}" in
            sessions)
                # checked raw, before any cleaning: a name cleaning would change is not offered
                OCTL_RAW=1 octl list-units --all --full --no-legend --plain "$UNIT*.service" 2>/dev/null \
                    | LC_ALL=C awk -v pre="$UNIT" '{ u = $1; if (index(u, pre) != 1 || !sub(/\.service$/, "", u)) next
                                                    printf "%s\t%s/%s\n", substr(u, length(pre) + 1), $3, $4 }' \
                    | LC_ALL=C grep -aE $'^[A-Za-z0-9][A-Za-z0-9_-]{0,63}\\.[A-Za-z0-9][A-Za-z0-9_-]{0,63}\t[a-z-]+/[a-z-]+$' || true ;;
            web-sessions)
                [ -n "$WEB" ] || exit 0
                web_running | while IFS= read -r n; do name_ok "$n" && printf '%s\trunning\n' "$n"; done || true ;;
            ids)
                # Newest first, at most 50, each id one the verb accepts (its state as web_state
                # says). Candidates come from where each verb's ids live (held/, quarantine/, the
                # stage logs; requests/ for show), only ids that have a request, gathered in one
                # bounded pass (complete_ids) that reads only the logs the verb needs: no file the
                # agent or the workers write can bury the real ones or blow up the work here.
                [ -n "$WEB" ] || exit 0
                verb="${2:-show}"
                case "$verb" in show|approve|reject|release|retry) ;; *) exit 0 ;; esac
                declare -A wl=() gl=()
                cands=()
                while IFS=$'\t' read -r k i st; do
                    case "$k" in C) cands+=("$i") ;; W) wl[$i]=$st ;; G) gl[$i]=$st ;; esac
                done < <(complete_ids "$verb")
                n=0
                for id in "${cands[@]}"; do
                    [[ "$id" =~ $ID_RE ]] || continue
                    STAGE_WEB="${wl[$id]:-}" STAGE_GUARD="${gl[$id]:-}"
                    web_state_set "$id"
                    case "$verb:$STATE" in
                        show:*|approve:held|reject:held|release:quarantined) ;;
                        retry:failed*|retry:changed*|"retry:gate failed"*|"retry:quarantined, release failed"*) ;;
                        *) continue ;;
                    esac
                    printf '%s\t%s\n' "$id" "$(printf '%s' "$STATE" | clean | tr -cd '[:print:]' | cut -c1-60)"
                    n=$((n + 1)); [ "$n" -lt 50 ] || break
                done ;;
            *) die "usage: $CMD _complete sessions|web-sessions|ids [verb]" ;;
        esac ;;
    -h|--help|help)
        sed -n '2,/^set -euo/p' "$0" | sed "\$d; s/^# \\{0,1\\}//; s/<command>/$CMD/g" ;;
    *) die "unknown command $cmd (see $CMD --help)" ;;
esac
