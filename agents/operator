# step, a regular file, never blocking, 64 MB at most (the logs are the workers, who can swap
# them for a link or a FIFO). "<web stage>US<guard stage>".
last() {
    python3 -I - "$q" "$web" "$guard" "$1" "${2:-}" "${3:-}" <<"PY"
import os, re, stat, sys
root, web, guard, i, wo, go = sys.argv[1:7]
