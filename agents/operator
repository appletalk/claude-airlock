# The candidates for `_complete ids <verb>` ("C<TAB>id", newest first) and their last stage lines
# ("W|G<TAB>id<TAB>stage: result", read exactly as last_stage reads them), in one pass. Only ids
# with a request count, the logs are read as qread reads them (no link, regular files, 64 MB at
# most) and only when the verb needs them; at most 2000 candidates (show: 50).
complete_ids() {  # complete_ids <verb>
    python3 -I -c 'import os, re, stat, sys
root, verb, web, guard = sys.argv[1:5]
ID = re.compile(r"[0-9]{8}T[0-9]{6}Z-[0-9a-f]{6}")
def names(d, suffix):
    # id -> when the file appeared (ctime: its owner can set mtime, not this), live entries only
    try:
        ents = os.listdir(os.path.join(root, d))
    except OSError:
        return {}
    out = {}
    for e in ents:
        if suffix and not e.endswith(suffix):
            continue
        n = e[: -len(suffix)] if suffix else e
        if ID.fullmatch(n):
            try:
                out[n] = os.stat(os.path.join(root, d, e)).st_ctime
            except OSError:
                pass
    return out
# The last 1 MiB of a stage log, from a line start, read as qread reads (no link, a regular file).
# Completion is a convenience: a worker that floods its log can hide ids from it, never from
# the commands, which read the whole log and check again.
TAIL = 1048576
def read_tail(user):
    try:
        fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY)
        for p in ("log", user):
            fd = os.open(p, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
        f = os.open("stages.jsonl", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd)
        st = os.fstat(f)
        if not stat.S_ISREG(st.st_mode):
            return b""
        # one byte before the tail too: a tail that starts on a line start keeps its first line
        start = max(0, min(st.st_size, 67108864) - TAIL - 1)
        os.lseek(f, start, os.SEEK_SET)
        data = b""
        while len(data) < TAIL + 1:
            c = os.read(f, TAIL + 1 - len(data))
            if not c:
                break
            data += c
        if start:
            data = data[data.find(b"\n") + 1:] if b"\n" in data else b""
        return data
    except OSError:
        return b""
STAGE = re.compile(rb""".*"stage":"([a-z]*)","result":"([a-z0-9 ,;()\x27-]*)".*""")
REF = re.compile(rb"(?=\x22id\x22:\x22([0-9]{8}T[0-9]{6}Z-[0-9a-f]{6})\x22)")
# Each id with the stage of the last line referring to it, as last_stage reads it (grep -F of
# the reference, tail -1): one pass over the lines, overlapping references included.
def stages(user, want):
    last = {}
    for line in read_tail(user).split(b"\n"):
        ids = [x.decode() for x in REF.findall(line)]
        ids = [i for i in ids if i in want]
        if not ids:
            continue
        m = STAGE.fullmatch(line)
        st = (m.group(1) + b": " + m.group(2)).decode() if m else ""
        for i in ids:
            last[i] = st
    return last
reqs = names("requests", ".json")
newest = lambda ids, n: sorted(ids, key=lambda i: (reqs[i], i), reverse=True)[:n]
w, g = {}, {}
exists = lambda p: os.path.exists(os.path.join(root, p))
if verb in ("approve", "reject"):
