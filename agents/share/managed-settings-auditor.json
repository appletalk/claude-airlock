{
  "permissions": {
    "deny": [
      "SendMessage",
      "ListAgents",
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "ArtifactCheck",
      "RemoteTrigger",
      "CronCreate",
      "Agent",
      "WebFetch",
      "WebSearch",
      "Write",
      "Edit",
      "NotebookEdit",
      "Read(~/.claude/**)"
    ],
    "allow": [
      "Bash(curl:*)",
      "Bash(jq:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(cut:*)",
      "Bash(grep:*)",
      "Bash(date:*)"
    ]
  },
  "crossSessionInbound": "refuse",
  "disableRemoteControl": true,
  "allowManagedHooksOnly": true,
  "allowManagedPermissionRulesOnly": true
}
