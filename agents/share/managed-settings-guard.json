{
  "permissions": {
    "deny": [
      "SendMessage",
      "ListAgents",
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "ArtifactCheck",
      "RemoteTrigger",
      "CronCreate",
      "Agent",
      "Bash",
      "Read(~/.claude/**)",
      "Edit(~/.claude/**)"
    ]
  },
  "crossSessionInbound": "refuse",
  "disableRemoteControl": true,
  "allowManagedHooksOnly": true
}
