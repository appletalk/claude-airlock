#!/usr/bin/python3 -I
# audit-ui <store socket> <port> <uid|off>: the audit store's web UI (VictoriaLogs' vmui) on
# http://audit.localhost:<port>/ (loopback only: 127.0.0.1, and ::1 where the host has it) for one
# user, until Ctrl-C (the operator's `audit ui`, docs/agents.md). Port 0: a free one, picked here.
# It closes by itself after 30 minutes without a request, and after 4 hours whatever happens, so
# a forgotten terminal doesn't keep the store open. (Three more arguments, idle, most and the
# store's read timeout in seconds, are for the tests; the operator command never passes them.)
#
# A port on loopback is open to every process on the host, so two things guard it:
# - a token, new each run, in the URL it prints: the first request that carries it gets a cookie
#   (host-only for audit.localhost, HttpOnly, SameSite=Strict, for the session) and a redirect to
#   the same path without it; every other request needs that cookie. *.localhost names resolve to
#   loopback in the browsers themselves, and a host-only cookie for audit.localhost goes to no
#   other name (127.0.0.1 and localhost are other names; cookies don't separate ports, names do);
# - each connection's owner, looked up in the kernel's socket table (/proc/net/tcp, tcp6: the uid
#   that made the client socket): only <uid> is served. `off` turns this check off, for a host
#   whose browser isn't a Linux process (WSL: a browser on Windows owns no socket here), leaving
#   the token alone. Then the name is secret too, a new random <label>.audit.localhost each run
#   and the only Host served: cookies don't separate ports, so a cookie for a known name would go
#   to any listener on another port of that name (a page there would read it and replay it);
#   one for a name nobody else knows goes nowhere else. (With the check on, a replayed cookie
#   from another uid is refused anyway.)
# That user's browser can still be steered by a web page, so the UI is served to itself alone:
# - only a Host of audit.localhost:<port>, 127.0.0.1:<port> or localhost:<port> (a rebound name,
#   one that resolves to loopback so the page could read the answers, gets 421);
# - no request another site started: an Origin other than this one, or a Sec-Fetch-Site other
#   than same-origin or none (typed in the address bar), gets 403 before anything reaches the
#   store, so a page can neither read through it nor load the store with blind queries;
# - no CORS: every Access-Control-* header of the store's answer is dropped (VictoriaLogs allows
#   any origin), and OPTIONS (a preflight) is refused.
# Each request goes to the store's socket with a short list of headers (nothing that names the
# client), one request per connection; a path or header with a control byte is refused. The
# store's door (vmauth) still decides what is a query; this adds no path rules of its own.
# Refused requests don't count as use: they never hold off the idle limit.
import errno
import hmac
import http.client
import http.server
import secrets
import socket
import struct
import sys
import threading
import time
import urllib.parse

SOCK, PORT = sys.argv[1], int(sys.argv[2])   # PORT 0: a free one, set in main()
UID = None if sys.argv[3] == "off" else int(sys.argv[3])
IDLE = int(sys.argv[4]) if len(sys.argv) > 4 else 30 * 60
MOST = int(sys.argv[5]) if len(sys.argv) > 5 else 4 * 3600
STORE_TIMEOUT = int(sys.argv[6]) if len(sys.argv) > 6 else 120
STARTED = LAST = time.monotonic()
NAME = "audit.localhost" if UID is not None else f"{secrets.token_hex(10)}.audit.localhost"
TOKEN = secrets.token_urlsafe(32)
HOSTS = ORIGINS = COOKIE = None   # set in main(), once the port is known
MAX_CONN = 256   # connections at once: unauthenticated ones can't take more threads than this
HEAD_DEADLINE = 5   # seconds for the whole request line and headers, however slowly they come
PASS = ("Accept", "Accept-Encoding", "Accept-Language", "Content-Type", "If-None-Match", "If-Modified-Since")
MAX_BODY = 1 << 20


def hexaddr(ip, port):  # /proc/net/tcp(6)'s form of an address and port (each 32-bit word in the
    # kernel's byte order: little-endian on the hosts this runs on; on a big-endian one nothing would
    # match: all refused)
    if ":" in ip:
        a = socket.inet_pton(socket.AF_INET6, ip)
        return "".join(f"{int.from_bytes(a[i:i + 4], 'little'):08X}" for i in range(0, 16, 4)) + f":{port:04X}"
    a = socket.inet_aton(ip)
    return f"{int.from_bytes(a, 'little'):08X}:{port:04X}"


def owner(peer, me):  # the uid of the client socket peer -> me, or None
    want_local, want_rem = hexaddr(*peer[:2]), hexaddr(*me[:2])
    try:
        with open("/proc/net/tcp6" if ":" in peer[0] else "/proc/net/tcp") as f:
            next(f)
            for line in f:
                c = line.split()
                if len(c) > 7 and c[1] == want_local and c[2] == want_rem:
                    return int(c[7])
    except (OSError, ValueError, StopIteration):
        return None
    return None


class Store(http.client.HTTPConnection):
    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(STORE_TIMEOUT)
        self.sock.connect(SOCK)


class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.0"   # one request per connection: each is checked from the start
    timeout = 5                     # the request line and headers: an idle connection frees its slot
    # fast, so a flood of them can't hold every slot (MAX_CONN) for long
    def version_string(self):
        return "audit-ui"

    def log_message(self, fmt, *args):  # no request lines on the operator's terminal
        pass

    def end_headers(self):
        self.send_header("Referrer-Policy", "no-referrer")
        super().end_headers()

    def has_cookie(self):  # this run's cookie among the request's Cookie headers (parsed by hand:
        # another service on the name can set an odd cookie a strict parser would stop at)
        ok = False
        for h in self.headers.get_all("Cookie") or []:
            for part in h.split(";"):
                k, eq, v = part.strip().partition("=")
                if eq and k == COOKIE and hmac.compare_digest(v.strip().encode(), TOKEN.encode()):
                    ok = True
        return ok

    def refuse(self, code, why):
        try:
            self.send_response(code)
            self.send_header("Content-Type", "text/plain")
            self.send_header("Content-Length", str(len(why) + 1))
            self.end_headers()
            self.wfile.write(why.encode() + b"\n")
        except OSError:   # the client is gone already (it read the status line and closed)
            self.close_connection = True

    def relay(self):
        global LAST
        cut = self.server.deadlines.pop(id(self.connection), None)
        if cut is not None:   # the headers are in: the deadline no longer applies
            cut.cancel()
        try:   # headers read: the body and the answer (a live tail streams) get longer
            self.connection.settimeout(60)
        except OSError:
            self.close_connection = True
            return
        if self.headers.get("Host", "") not in HOSTS:
            return self.refuse(421, "audit-ui: only the address `audit ui` printed")
        origin, site = self.headers.get("Origin"), self.headers.get("Sec-Fetch-Site")
        if (origin is not None and origin not in ORIGINS) or (site is not None and site not in ("same-origin", "none")):
            return self.refuse(403, "audit-ui: only the UI itself, not another site")
        if not self.path.startswith("/") or any(ord(c) < 0x20 or ord(c) == 0x7f for c in self.path) or \
                any(ord(c) < 0x20 and c != "\t" or ord(c) == 0x7f for v in self.headers.values() for c in v):
            return self.refuse(400, "audit-ui: a control character in the request")
        if "Transfer-Encoding" in self.headers:
            return self.refuse(411, "audit-ui: a body needs a Content-Length")
        try:
            n = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            return self.refuse(400, "audit-ui: a bad Content-Length")
        if n < 0 or n > MAX_BODY:
            return self.refuse(413, "audit-ui: a body over 1 MiB")
        # The token: the printed URL's ?token= gets the cookie and a redirect to the same path
        # without it (never forwarded); everything else needs the cookie.
        path, _, query = self.path.partition("?")
        pairs = query.split("&") if query else []
        given = [urllib.parse.unquote_plus(x.partition("=")[2]) for x in pairs
                 if urllib.parse.unquote_plus(x.partition("=")[0]) == "token"]
        if given:
            if len(given) != 1 or not hmac.compare_digest(given[0].encode(), TOKEN.encode()):
                return self.refuse(403, "audit-ui: not this run's token (open the URL it printed)")
            # Back to the same page, the rest of the query as it came; a path that a browser could
            # read as another host (//x, /\x) goes to the UI's own page instead.
            rest = "&".join(x for x in pairs if urllib.parse.unquote_plus(x.partition("=")[0]) != "token")
            if path.startswith("//") or "\\" in path:
                path = "/select/vmui/"
            try:
                self.send_response(303)
                self.send_header("Location", path + ("?" + rest if rest else ""))
                self.send_header("Set-Cookie", f"{COOKIE}={TOKEN}; Path=/; HttpOnly; SameSite=Strict")
                self.send_header("Cache-Control", "no-store")
                self.send_header("Content-Length", "0")
                self.end_headers()
            except OSError:
                self.close_connection = True
            return
        if not self.has_cookie():
            return self.refuse(403, "audit-ui: open the URL `audit ui` printed (with its token) first")
        LAST = time.monotonic()   # a request that passed every check: in use
        try:
            body = self.rfile.read(n) if n else None
        except OSError:   # the client went away mid-body
            self.close_connection = True
            return
        if body is not None and len(body) != n:
            return self.refuse(400, "audit-ui: a body shorter than its Content-Length")
        hdrs = {h: self.headers[h] for h in PASS if h in self.headers}
        if body is not None:
            hdrs["Content-Length"] = str(n)
        store = Store("x")
        try:
            store.request(self.command, self.path, body=body, headers=hdrs)
            r = store.getresponse()
        except (OSError, ValueError, http.client.HTTPException):
            store.close()
            return self.refuse(502, "audit-ui: no answer from the audit store")
        try:
            self.send_response(r.status, r.reason)
            for k, v in r.getheaders():
                kl = k.lower()
                if kl not in ("connection", "keep-alive", "transfer-encoding", "server", "date") and not kl.startswith("access-control-"):
                    self.send_header(k, v)
            self.end_headers()
            self.wfile.flush()
            while True:
                chunk = r.read1(65536)   # what has arrived, as it arrives (a live tail streams)
                if not chunk:
                    break
                self.wfile.write(chunk)
                self.wfile.flush()
        except (OSError, ValueError, http.client.HTTPException):
            # Cut mid-answer (the store timed out or went away): reset the connection, not a
            # clean close, so the browser shows a failed request, not a short or empty result.
            # (A store that sends a Content-Length and closes early ends cleanly, short: the
            # browser sees the length doesn't match.)
            try:
                self.connection.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, struct.pack("ii", 1, 0))
                self.connection.close()   # now: the server's own close would send a FIN first
            except OSError:
                pass
            self.close_connection = True
        finally:
            store.close()

    do_GET = do_POST = do_HEAD = relay


class Server(http.server.ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True

    def handle_error(self, request, client_address):
        # Never a traceback on the operator's terminal: a client that went away is nothing to
        # report; anything else gets one line.
        err = sys.exc_info()[1]
        if not isinstance(err, OSError):
            print(f"audit-ui: a request failed ({type(err).__name__})", file=sys.stderr, flush=True)

    refused = set()
    slots = threading.BoundedSemaphore(MAX_CONN)
    deadlines = {}   # id(connection) -> its header deadline timer (dict ops are atomic in CPython)

    def process_request(self, request, client_address):   # at most MAX_CONN at once; more are closed
        if not self.slots.acquire(blocking=False):
            self.shutdown_request(request)
            return
        try:
            super().process_request(request, client_address)
        except Exception:
            self.slots.release()
            raise

    def process_request_thread(self, request, client_address):
        # A deadline for the whole request line and headers: the socket timeout restarts with
        # every byte, so a client sending one now and then could hold a slot for ever.
        cut = threading.Timer(HEAD_DEADLINE, self.cut, (request,))
        cut.daemon = True
        self.deadlines[id(request)] = cut
        cut.start()
        try:
            super().process_request_thread(request, client_address)
        finally:
            cut.cancel()
            self.deadlines.pop(id(request), None)
            self.slots.release()

    @staticmethod
    def cut(request):
        try:
            request.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass

    def verify_request(self, request, client_address):
        if UID is None:   # the uid check is off: the token alone
            return True
        uid = owner(client_address, request.getsockname())
        if uid == UID:
            return True
        if uid not in self.refused:  # once per uid: a flood of refusals doesn't bury the terminal
            self.refused.add(uid)
            if uid is None:
                print("audit-ui: refused a connection from uid (unknown): no Linux process owns it (a browser on "
                      "Windows under WSL? ui-uid-check off on the audit line of agents.conf)", file=sys.stderr, flush=True)
            else:
                print(f"audit-ui: refused a connection from uid {uid}", file=sys.stderr, flush=True)
        return False


class Server6(Server):
    address_family = socket.AF_INET6

    def server_bind(self):   # ::1 alone: never a dual-stack socket
        self.socket.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
        super().server_bind()


def listen():  # (servers, port): 127.0.0.1, and ::1 on the same port where the host has it
    # (browsers try ::1 first for *.localhost); a host without IPv6 (or without ::1) is served on
    # 127.0.0.1 alone. Nothing but loopback is ever bound. Port 0: a free one on both (a few
    # tries, in case ::1 has the one 127.0.0.1 got).
    for _ in range(20 if PORT == 0 else 1):
        try:
            srv = Server(("127.0.0.1", PORT), Handler)
        except OSError as e:
            print(f"audit-ui: can't listen on 127.0.0.1:{PORT}: {e.strerror} (another port: --port <n>)", file=sys.stderr)
            return None, None
        port = srv.server_address[1]
        try:
            return [srv, Server6(("::1", port), Handler)], port
        except OSError as e:
            if e.errno != errno.EADDRINUSE:
                return [srv], port
            srv.server_close()
            if PORT != 0:   # ::1 has the port taken by something else, which the browser could reach first
                print(f"audit-ui: can't listen on [::1]:{port}: {e.strerror} (another port: --port <n>)", file=sys.stderr)
                return None, None
    print("audit-ui: found no port free on both 127.0.0.1 and ::1", file=sys.stderr)
    return None, None


def main():
    global HOSTS, ORIGINS, COOKIE
    srvs, port = listen()
    if srvs is None:
        return 1
    srv = srvs[0]
    # The Hosts served: the name (the random one alone with the uid check off), and with the check
    # on also 127.0.0.1 and localhost (tools that don't resolve *.localhost).
    HOSTS = {f"{NAME}:{port}"} | (set() if UID is None else {f"127.0.0.1:{port}", f"localhost:{port}"})
    ORIGINS = {"http://" + h for h in HOSTS}
    COOKIE = f"audit_ui_{port}"
    why = ["closed (Ctrl-C)"]

    def expire():  # the two limits, checked every second
        while True:
            time.sleep(1)
            now = time.monotonic()
            if now - STARTED >= MOST:
                why[0] = f"closed: open {MOST // 60} minutes, the most it stays (run it again for more)"
            elif now - LAST >= IDLE:
                why[0] = f"closed: no request for {IDLE // 60} minutes"
            else:
                continue
            for x in srvs:
                x.shutdown()
            return

    who = "with its token alone (the uid check is off)" if UID is None else "for you alone"
    print(f"the audit store's UI: http://{NAME}:{port}/select/vmui/?token={TOKEN}\n"
          f"  ({who}; Ctrl-C to close; closes after {IDLE // 60} min idle, {MOST // 60} min at most; "
          f"the token is this run's only)", flush=True)
    threading.Thread(target=expire, daemon=True).start()
    for x in srvs[1:]:
        threading.Thread(target=x.serve_forever, kwargs={"poll_interval": 0.5}, daemon=True).start()
    try:
        srv.serve_forever(poll_interval=0.5)
    except KeyboardInterrupt:
        for x in srvs[1:]:
            x.shutdown()
    finally:
        for x in srvs:
            x.server_close()
    print(why[0], flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
