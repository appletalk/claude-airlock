#!/bin/bash
# audit-run: one auditor run (docs/agents.md, Audit), in the auditor user's manager, started by
# the operator's `<command> audit`. A fresh one-shot Claude in a box: an empty workspace and memory
# dir, the auditor's instructions, Bash for curl to the audit store (and a few text tools for its
# answers), nothing else; capped in time and turns. The report (Claude's last message) goes to
# stdout; the operator command cleans it, adds the queries Envoy logged for this user and writes
# the report file, which this user never sees. Its tools can write files (curl -o), so before
# each run everything the box could have written is removed: the workspace, its memory dir, the
# launcher's dot-claude (settings, transcripts, todos) but the login, claude.json but the account
# fields, ~/.claude/projects, the launcher's scratch dir and artifact stores for the workspace.
# What one run wrote can't steer the next, except the login file itself (the box must write it:
# token refresh), docs/agents.md, Audit. No run starts while a box of this user's still runs.
#
#   audit-run review <days>      a look back over the last <days> days (1 to 90)
#   audit-run ask <question>     the operator's question
set -u
# The site's names (rendered by airlock-agents-apply from agents.conf).
# shellcheck source=/dev/null
. "${AIRLOCK_AGENTS_ENV:-/etc/claude-airlock/agents/agents.env}"
die() { echo "audit-run: $*" >&2; exit 64; }   # 64: refused, no run (the operator writes no report)
AIRLOCK="${AGENTS_AUDIT_AIRLOCK:-$HOME/.local/bin/airlock}"                # test knobs; never set in use
PROMPT="${AGENTS_AUDIT_PROMPT:-$AGENTS_SHARE/box/auditor-prompt.md}"
TIMEOUT="${AGENTS_AUDIT_TIMEOUT:-20m}"
TURNS=60
# Its tools: Bash, for what managed-settings-auditor.json's allow list names (curl and text tools; no
# sort or uniq, they write files). That list alone counts there (allowManagedPermissionRulesOnly), so
# none is passed here: Claude would only say it ignores it, into the report.
ws="$HOME/audit"                                  # one workspace for every run: one login
export PATH=/usr/local/bin:/usr/bin

[ "$(id -un)" = "${AGENTS_AUDITOR:-}" ] || die "run as the auditor (${AGENTS_AUDITOR:-none in agents.env}), from $AGENTS_COMMAND audit"
case "${1:-}" in
    review)
        [[ "${2:-}" =~ ^[1-9][0-9]?$ ]] && [ "$2" -le 90 ] || die "usage: audit-run review <days, 1 to 90>"
        task="Review the last $2 days in the audit store (from $(date -u -d "-$2 days" +%Y-%m-%dT%H:%M:%SZ) to now) and write the review report your instructions describe." ;;
    ask)
        q="${2:-}"
        [ -n "$q" ] && [ "${#q}" -le 4000 ] || die "usage: audit-run ask <question, 1 to 4000 characters>"
        # the operator's own text, but kept to what a terminal shows (tab and newline allowed)
        [ -z "$(printf '%s' "$q" | LC_ALL=C tr -d '\t\n\040-\176\200-\377')" ] || die "the question has control characters"
        task="Answer the operator's question below from the audit store, as your instructions describe for a question. The question (the operator's own words):

$q" ;;
    *) die "usage: audit-run review <days> | ask <question>" ;;
esac
[ $# = 2 ] || die "usage: audit-run review <days> | ask <question>"

# The store's name: the plain-HTTP host with rules victoria-logs in this user's proxy manifest
# (airlock-envoy writes it next to the socket; the launcher checks it again before it uses it).
sock="$(sed -n 's/^AIRLOCK_EGRESS_PROXY=//p' "${AIRLOCK_CONFIG:-/nonexistent}" 2>/dev/null | tail -1)"
sock=${sock#[\"\']} sock=${sock%[\"\']}
[[ "$sock" == /*.sock ]] || die "no AIRLOCK_EGRESS_PROXY socket in ${AIRLOCK_CONFIG:-the config (AIRLOCK_CONFIG unset)}"
store="$(awk '$3 == "victoria-logs" && $4 == "no" { print $1; exit }' "${sock%.sock}.clients" 2>/dev/null)"
[[ "$store" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]([a-z0-9-]{0,61}[a-z0-9])?$ ]] \
    || die "the listener behind $sock has no audit store (an http host with rules victoria-logs): docs/agents.md, Audit"
[ -f "$PROMPT" ] && [ -r "$PROMPT" ] || die "no auditor instructions at $PROMPT (sudo make install-agents)"

# One run at a time: a second would empty the workspace under the first.
run_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
exec 9> "$run_dir/audit-run.lock" || die "no lock file in $run_dir"
flock -n 9 || die "another audit run is going (one at a time)"

# Nothing from an earlier run is left: not in the workspace (a CLAUDE.md or .claude/ there would
# load into this one), not in the launcher's state for it (the box's ~/.claude: settings a run
# planted would hold for the next, its transcripts hold earlier reports), not in the shared
# history. Only the login stays (a regular file; anything else by that name goes too).
# A box of an earlier run (or of audit login) still running could write after the wipe.
command -v "${AGENTS_AUDIT_PODMAN:-podman}" >/dev/null || die "no podman: can't tell whether an earlier box still runs"
# (any state but exited: a paused or stopping one could still write; podman failing is a refusal)
boxes="$("${AGENTS_AUDIT_PODMAN:-podman}" ps -a -q --filter status=created --filter status=running --filter status=paused --filter status=stopping 2>/dev/null)" \
    || die "podman ps failed: can't tell whether an earlier box still runs (as $AGENTS_AUDITOR: podman ps -a)"
[ -z "$boxes" ] || die "a box of $AGENTS_AUDITOR's is still running (an earlier run, or audit login): end it first (as $AGENTS_AUDITOR: podman ps)"
# (a run may have taken its own write or search bit away from a dir: given back first, so one run
# can't block every later one)
{ mkdir -p "$ws" && chmod -R u+rwx "$ws" 2>/dev/null; find "$ws" -mindepth 1 -delete 2>/dev/null; [ -z "$(find "$ws" -mindepth 1 -print -quit)" ]; } \
    || die "the workspace $ws could not be emptied; nothing runs until it is (as $AGENTS_AUDITOR: look at what is left there)"
# the slug as the launcher makes it, from the directory as cd names it
ws="$(cd "$ws" && pwd)" || die "no workspace $ws"
slug="$(printf '%s' "$ws" | sed 's#[^a-zA-Z0-9]#-#g; s#^-*##')"
st="$HOME/.config/claude-airlock/state/$slug"
[ ! -L "$st" ] && [ ! -L "$st/dot-claude" ] || die "$st or its dot-claude is a link: not the launcher's; nothing runs until it is removed"
rm -rf -- "$st/box-memory" "$HOME/.claude/projects" "$st"/artifacts* 2>/dev/null \
    || die "could not empty $st; nothing runs until it is"
# the launcher's scratch dir for the workspace (mounted rw into every box of it): emptied, kept
tmpd="${AIRLOCK_TMP_BASE:-/tmp/airlock-$(id -un)}/$slug"
if [ -d "$tmpd" ] && [ ! -L "$tmpd" ]; then
    { chmod -R u+rwx "$tmpd" 2>/dev/null; find "$tmpd" -mindepth 1 -delete 2>/dev/null; [ -z "$(find "$tmpd" -mindepth 1 -print -quit)" ]; } \
        || die "the scratch dir $tmpd could not be emptied; nothing runs until it is"
elif [ -e "$tmpd" ] || [ -L "$tmpd" ]; then rm -f -- "$tmpd" 2>/dev/null || die "$tmpd is not a folder; nothing runs until it is removed"; fi
if [ -d "$st/dot-claude" ]; then
    for f in "$st/dot-claude"/* "$st/dot-claude"/.[!.]* "$st/dot-claude"/..?*; do
        [ -e "$f" ] || [ -L "$f" ] || continue
        [ "$f" = "$st/dot-claude/.credentials.json" ] && [ -f "$f" ] && [ ! -L "$f" ] && continue
        { [ -L "$f" ] || chmod -R u+rwx "$f" 2>/dev/null; rm -rf -- "$f" 2>/dev/null; } || die "could not empty $st/dot-claude; nothing runs until it is"
    done
fi
[ -z "$(find "$st/dot-claude" -mindepth 1 ! -path "$st/dot-claude/.credentials.json" -print -quit 2>/dev/null)" ] \
    || die "$st/dot-claude could not be emptied; nothing runs until it is"
if [ -e "$st/claude.json" ] || [ -L "$st/claude.json" ]; then
    if [ -f "$st/claude.json" ] && [ ! -L "$st/claude.json" ] \
        && jq '{oauthAccount: ((.oauthAccount // {}) | if type == "object" then with_entries(select((.value | type) == "string" and (.value | length) <= 200)) else {} end),
                userID: (.userID | if type == "string" and length <= 200 then . else null end),
                hasCompletedOnboarding: (.hasCompletedOnboarding | if type == "boolean" then . else null end),
                lastOnboardingVersion: (.lastOnboardingVersion | if type == "string" and length <= 50 then . else null end)}
            | with_entries(select(.value != null and .value != {}))' \
            "$st/claude.json" > "$st/claude.json.new" 2>/dev/null; then
        mv -f -- "$st/claude.json.new" "$st/claude.json"
    else rm -f -- "$st/claude.json" "$st/claude.json.new"; fi
fi

# The site's names into the instructions (each checked by the apply's parser: no sed specials).
agents="$(printf '%s ' "$AGENTS_AGENT" ${AGENTS_WEB:+"$AGENTS_WEB"} ${AGENTS_GUARD:+"$AGENTS_GUARD"} "$AGENTS_AUDITOR" | sed 's/ $//; s/ /, /g')"
prompt="$(sed -e "s/{auditor}/$AGENTS_AUDITOR/g" -e "s/{agents}/$agents/g" -e "s/{operator}/$AGENTS_OPERATOR/g" \
    -e "s/{command}/$AGENTS_COMMAND/g" -e "s/{store}/$store/g" "$PROMPT")"

cd "$ws" || die "no workspace $ws"
timeout -k 30s "$TIMEOUT" "$AIRLOCK" -p "$task" \
    --name "$AGENTS_AUDITOR-$(date -u +%Y%m%dT%H%M%SZ)" --session-id "$(cat /proc/sys/kernel/random/uuid)" \
    --restricted --strict-mcp-config --tools Bash \
    --permission-mode dontAsk --max-turns "$TURNS" \
    --append-system-prompt "$prompt" --output-format text </dev/null
rc=$?
# 64 is this script's refusal alone (the operator writes no report for it): a run's own 64 is 65
[ "$rc" != 64 ] || rc=65
exit "$rc"
